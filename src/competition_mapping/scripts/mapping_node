#!/usr/bin/env python3
"""mapping_node — occupancy grid mapping from legitimate localization and point clouds.

Current stage:
  - Subscribe to legitimate localization odometry and status.
  - Subscribe to PointCloud2.
  - Check input availability, timeout, and odometry validity.
  - Publish dynamic ModuleStatus.
  - Do NOT publish a fake OccupancyGrid.

Forbidden:
  - Ground-truth topics.
  - Gazebo get_model_state.
  - scene_manifest.json or layout_metadata.json as map priors.
"""

from __future__ import annotations

import math

import rospy
from competition_interfaces.msg import ModuleStatus
from nav_msgs.msg import Odometry
from sensor_msgs.msg import PointCloud2


class MappingNode:
    """Input-monitoring skeleton for the occupancy grid mapping module."""

    def __init__(self):
        rospy.init_node("mapping_node", log_level=rospy.INFO)

        # ------------------------------------------------------------------
        # Parameters
        # ------------------------------------------------------------------
        self._odom_topic = rospy.get_param(
            "~odom_topic",
            "/competition/localization/odom",
        )
        self._localization_status_topic = rospy.get_param(
            "~localization_status_topic",
            "/competition/localization/status",
        )
        self._pointcloud_topic = rospy.get_param(
            "~pointcloud_topic",
            "/livox/Pointcloud2",
        )

        self._odom_timeout = float(
            rospy.get_param("~odom_timeout", 1.0)
        )
        self._localization_status_timeout = float(
            rospy.get_param("~localization_status_timeout", 1.0)
        )
        self._pointcloud_timeout = float(
            rospy.get_param("~pointcloud_timeout", 1.0)
        )
        self._status_rate = float(
            rospy.get_param("~status_rate", 2.0)
        )
        self._quaternion_norm_tolerance = float(
            rospy.get_param("~quaternion_norm_tolerance", 0.1)
        )

        self._validate_parameters()

        # ------------------------------------------------------------------
        # Internal state
        # ------------------------------------------------------------------
        self._last_odom_time = None
        self._last_localization_status_time = None
        self._last_pointcloud_time = None

        self._odom_valid = False
        self._odom_error = "odometry not received"

        self._localization_valid = False
        self._localization_state = ModuleStatus.UNKNOWN
        self._localization_detail = "localization status not received"

        self._odom_frame = ""
        self._base_frame = ""
        self._pointcloud_frame = ""

        self._last_reported_status = None

        # ------------------------------------------------------------------
        # Publisher
        # ------------------------------------------------------------------
        self._status_pub = rospy.Publisher(
            "/competition/mapping/status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )

        # ------------------------------------------------------------------
        # Subscribers
        # ------------------------------------------------------------------
        self._odom_sub = rospy.Subscriber(
            self._odom_topic,
            Odometry,
            self._odom_callback,
            queue_size=10,
        )

        self._localization_status_sub = rospy.Subscriber(
            self._localization_status_topic,
            ModuleStatus,
            self._localization_status_callback,
            queue_size=10,
        )

        # PointCloud2 messages can be large, so use queue_size=1 and a larger buffer.
        self._pointcloud_sub = rospy.Subscriber(
            self._pointcloud_topic,
            PointCloud2,
            self._pointcloud_callback,
            queue_size=1,
            buff_size=16 * 1024 * 1024,
        )

        # ------------------------------------------------------------------
        # Status timer
        # ------------------------------------------------------------------
        timer_period = 1.0 / self._status_rate
        self._status_timer = rospy.Timer(
            rospy.Duration(timer_period),
            self._status_timer_callback,
        )

        rospy.loginfo(
            "mapping_node started in input-monitoring mode. "
            "odom=%s, localization_status=%s, pointcloud=%s, "
            "timeouts=(%.2f, %.2f, %.2f)s, status_rate=%.2fHz",
            self._odom_topic,
            self._localization_status_topic,
            self._pointcloud_topic,
            self._odom_timeout,
            self._localization_status_timeout,
            self._pointcloud_timeout,
            self._status_rate,
        )

    # ------------------------------------------------------------------
    # Parameter validation
    # ------------------------------------------------------------------

    def _validate_parameters(self):
        if self._odom_timeout <= 0.0:
            raise ValueError("~odom_timeout must be greater than 0")

        if self._localization_status_timeout <= 0.0:
            raise ValueError(
                "~localization_status_timeout must be greater than 0"
            )

        if self._pointcloud_timeout <= 0.0:
            raise ValueError("~pointcloud_timeout must be greater than 0")

        if self._status_rate <= 0.0:
            raise ValueError("~status_rate must be greater than 0")

        if self._quaternion_norm_tolerance <= 0.0:
            raise ValueError(
                "~quaternion_norm_tolerance must be greater than 0"
            )

    # ------------------------------------------------------------------
    # ROS callbacks
    # ------------------------------------------------------------------

    def _odom_callback(self, msg):
        self._last_odom_time = rospy.Time.now()
        self._odom_frame = msg.header.frame_id
        self._base_frame = msg.child_frame_id

        valid, reason = self._validate_odometry(msg)
        self._odom_valid = valid
        self._odom_error = reason

    def _localization_status_callback(self, msg):
        self._last_localization_status_time = rospy.Time.now()
        self._localization_valid = bool(msg.valid)
        self._localization_state = msg.state
        self._localization_detail = msg.detail

    def _pointcloud_callback(self, msg):
        self._last_pointcloud_time = rospy.Time.now()
        self._pointcloud_frame = msg.header.frame_id

    def _status_timer_callback(self, _event):
        now = rospy.Time.now()
        state, valid, confidence, detail = self._evaluate_status(now)

        msg = ModuleStatus()
        msg.header.stamp = now
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail

        self._status_pub.publish(msg)
        self._log_status_change(state, valid, detail)

    # ------------------------------------------------------------------
    # Input validation
    # ------------------------------------------------------------------

    def _validate_odometry(self, msg):
        position = msg.pose.pose.position
        orientation = msg.pose.pose.orientation
        linear = msg.twist.twist.linear
        angular = msg.twist.twist.angular

        values = [
            position.x,
            position.y,
            position.z,
            orientation.x,
            orientation.y,
            orientation.z,
            orientation.w,
            linear.x,
            linear.y,
            linear.z,
            angular.x,
            angular.y,
            angular.z,
        ]

        if not all(math.isfinite(float(value)) for value in values):
            return False, "odometry contains NaN or Inf"

        quaternion_norm = math.sqrt(
            orientation.x * orientation.x
            + orientation.y * orientation.y
            + orientation.z * orientation.z
            + orientation.w * orientation.w
        )

        if quaternion_norm < 1.0e-6:
            return False, "odometry quaternion has zero norm"

        if abs(quaternion_norm - 1.0) > self._quaternion_norm_tolerance:
            return (
                False,
                "odometry quaternion is not normalized "
                "(norm={:.4f})".format(quaternion_norm),
            )

        return True, "odometry valid"

    # ------------------------------------------------------------------
    # Status evaluation
    # ------------------------------------------------------------------

    def _evaluate_status(self, now):
        # A received but invalid odometry message is a data failure.
        if self._last_odom_time is not None and not self._odom_valid:
            return (
                ModuleStatus.FAILED,
                False,
                0.0,
                self._odom_error,
            )

        missing_inputs = []

        if self._last_localization_status_time is None:
            missing_inputs.append("localization status")

        if self._last_odom_time is None:
            missing_inputs.append("odometry")

        if self._last_pointcloud_time is None:
            missing_inputs.append("point cloud")

        if missing_inputs:
            return (
                ModuleStatus.STARTING,
                False,
                0.0,
                "waiting for " + ", ".join(missing_inputs),
            )

        localization_status_age = self._message_age(
            now,
            self._last_localization_status_time,
        )
        odom_age = self._message_age(now, self._last_odom_time)
        pointcloud_age = self._message_age(
            now,
            self._last_pointcloud_time,
        )

        timeout_items = []

        if localization_status_age > self._localization_status_timeout:
            timeout_items.append(
                "localization status {:.2f}s".format(
                    localization_status_age
                )
            )

        if odom_age > self._odom_timeout:
            timeout_items.append(
                "odometry {:.2f}s".format(odom_age)
            )

        if pointcloud_age > self._pointcloud_timeout:
            timeout_items.append(
                "point cloud {:.2f}s".format(pointcloud_age)
            )

        if timeout_items:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "input timeout: " + ", ".join(timeout_items),
            )

        # The mapping module must not use odometry while localization says
        # that its estimate is invalid.
        if not self._localization_valid:
            detail = "localization invalid"

            if self._localization_detail:
                detail += ": " + self._localization_detail

            return (
                ModuleStatus.BLOCKED,
                False,
                0.0,
                detail,
            )

        # Inputs are healthy, but no real OccupancyGrid exists yet.
        # Therefore the mapping module must remain invalid.
        return (
            ModuleStatus.STARTING,
            False,
            0.0,
            "inputs healthy; occupancy grid algorithm not implemented",
        )

    @staticmethod
    def _message_age(now, last_time):
        age = (now - last_time).to_sec()

        # Protect against a ROS clock reset producing a negative duration.
        return max(0.0, age)

    def _log_status_change(self, state, valid, detail):
        current_status = (state, valid, detail)

        if current_status == self._last_reported_status:
            return

        rospy.loginfo(
            "mapping status changed: state=%d, valid=%s, detail=%s",
            state,
            valid,
            detail,
        )
        self._last_reported_status = current_status

    def run(self):
        rospy.spin()


def main():
    node = MappingNode()
    node.run()


if __name__ == "__main__":
    main()