<launch>
  <!--
    competition_system.launch — unified competition system startup.

    Competition mode (default):
      roslaunch competition_bringup competition_system.launch

    Test mode (with mock inputs):
      roslaunch competition_bringup competition_system.launch competition_mode:=false use_mocks:=true

    Recommended environment for competition mode:
      ENABLE_GROUND_TRUTH=false
      ENABLE_REFEREE_ODOM=false
      WRITE_GENERATED_TRUTH_COPY=0
      UNITREE_AUTO_CMD_VEL=1
      CONTROLLER_FOREGROUND=0
  -->

  <!-- === Parameters === -->
  <arg name="competition_mode" default="true" />
  <arg name="use_mocks" default="false" />
  <arg name="auto_start" default="true" />
  <arg name="finish_on_first_detection" default="false" />
  <arg name="return_on_first_detection" default="false" />
  <arg name="return_arrival_tolerance" default="0.25" />
  <arg name="return_arrival_samples" default="3" />
  <arg name="return_input_timeout" default="1.0" />
  <arg name="planning_inflation_radius" default="0.25" />
  <arg name="planning_start_recovery_radius_cells" default="0" />
  <arg name="planning_frontier_min_size" default="5" />
  <arg name="planning_frontier_goal_search_radius_cells" default="0" />
  <arg name="planning_return_goal_search_radius_cells" default="2" />
  <arg name="planning_return_path_commit_enabled" default="false" />
  <arg name="planning_frontier_size_weight" default="1.0" />
  <arg name="planning_heading_weight_cells" default="0.0" />
  <arg name="planning_initial_forward_distance" default="0.0" />
  <arg name="planning_initial_forward_lookahead" default="2.0" />
  <arg name="planning_path_compression_enabled" default="false" />
  <arg name="planning_exploration_complete_confirmations" default="3" />
  <arg name="planning_visual_scan_enabled" default="true" />
  <arg name="planning_visual_scan_yaw_step" default="0.7853981634" />
  <arg name="planning_visual_scan_yaw_tolerance" default="0.15" />
  <arg name="planning_visual_scan_dwell" default="0.6" />
  <arg name="planning_visual_scan_heading_timeout" default="4.0" />
  <arg name="planning_visual_scan_timeout" default="45.0" />
  <arg name="planning_visual_scan_position_dedup_radius" default="1.0" />
  <arg name="planning_visual_scan_target_tolerance" default="0.35" />
  <arg name="planning_visual_scan_max_heading_retries" default="1" />
  <arg name="planning_visual_scan_update_interval" default="0.1" />
  <arg name="planning_visual_scan_final_before_complete" default="true" />
  <arg name="planning_enabled" default="true" />
  <arg name="planning_path_topic" default="/competition/path" />
  <arg name="path_follower_max_angular" default="0.8" />
  <arg name="path_follower_orientation_tolerance" default="0.15" />
  <!-- Minimum forward speed while driving to a waypoint. The RL locomotion
       policy stands still below ~0.2 m/s, which deadlocks the proportional
       slowdown just outside goal_tolerance (R24 RETURNING stall). Floor the
       drive command at the verified walking speed. -->
  <arg name="path_follower_min_linear" default="0.25" />
  <!-- Physical stuck detection (R25 wall-wedge): follower reports on
       /competition/planning/stuck after this many seconds of commanded
       driving with less than stuck_progress_epsilon measured displacement;
       planner then drops the committed RETURNING route once and replans. -->
  <arg name="path_follower_stuck_duration_sec" default="8.0" />
  <arg name="path_follower_stuck_progress_epsilon" default="0.05" />
  <!-- On stuck, briefly drive backward to break the wedge (R27 exploration
       had no recovery; works in every phase). Bounded per path. -->
  <arg name="path_follower_stuck_backoff_linear" default="0.15" />
  <arg name="path_follower_stuck_backoff_duration" default="3.0" />
  <arg name="path_follower_stuck_backoff_max" default="3" />
  <arg name="planning_return_recommit_on_stuck_enabled" default="true" />
  <!-- Exploration blocked recovery (R29 planner-BLOCKED deadlock): blind
       nudge toward the nearest frontier when none is reachable, so the map
       can re-observe and correct a drift-enclosed pocket. -->
  <arg name="planning_exploration_blocked_nudge_enabled" default="true" />
  <arg name="planning_exploration_blocked_nudge_distance" default="2.0" />
  <arg name="path_follower_path_timeout" default="5.0" />
  <!-- Forwarded to the canonical FAST-LIO launch. Defaults preserve the
       retained production configuration; benchmark runs override explicitly. -->
  <arg name="filter_size_surf" default="0.2" />
  <arg name="filter_size_map" default="0.3" />
  <arg name="localization_correction_enabled" default="false" />
  <arg name="localization_correction_odom_topic" default="/c2r28/proprio_fastlio_shadow/odom" />
  <arg name="localization_correction_mode" default="full_pose" />

  <rosparam command="load" file="$(find competition_bringup)/config/default.yaml" />

  <!-- Override competition_mode and auto_start from launch args -->
  <param name="/competition_loop/competition_mode" value="$(arg competition_mode)" />
  <param name="/competition_loop/auto_start" value="$(arg auto_start)" />

  <!-- === Competition Loop (state machine) === -->
  <node pkg="competition_loop" type="competition_loop_node" name="competition_loop"
        output="screen" respawn="false">
    <param name="max_time" value="600.0" />
    <param name="start_delay" value="5.0" />
    <param name="auto_start" value="$(arg auto_start)" />
    <param name="finish_on_first_detection" value="$(arg finish_on_first_detection)" />
    <param name="return_on_first_detection" value="$(arg return_on_first_detection)" />
    <param name="return_arrival_tolerance" value="$(arg return_arrival_tolerance)" />
    <param name="return_arrival_samples" value="$(arg return_arrival_samples)" />
    <param name="return_input_timeout" value="$(arg return_input_timeout)" />
    <param name="competition_mode" value="$(arg competition_mode)" />
    <param name="workspace_root" value="/workspace/SimEnv" />
    <param name="result_path" value="results/detected_danger.json" />
  </node>

  <!-- === cmd_vel Guard (safety gateway — ALWAYS start) === -->
  <node pkg="competition_control" type="cmd_vel_guard_node" name="cmd_vel_guard"
        output="screen" respawn="true">
    <param name="cmd_vel_timeout" value="0.5" />
    <param name="max_linear_x" value="0.5" />
    <param name="max_linear_y" value="0.3" />
    <param name="max_angular_z" value="1.0" />
  </node>

  <!-- === Mock subsystem (test mode only) === -->
  <group if="$(arg use_mocks)">
    <include file="$(find competition_testing)/launch/mock_system.launch" />
  </group>

  <!-- === Production modules (competition mode or when mocks disabled) === -->
  <group unless="$(arg use_mocks)">
    <!-- Localization (FAST-LIO + adapter, single canonical bringup) -->
    <include file="$(find competition_localization)/launch/localization_bringup.launch">
      <arg name="rviz" value="false"/>
      <arg name="filter_size_surf" value="$(arg filter_size_surf)"/>
      <arg name="filter_size_map" value="$(arg filter_size_map)"/>
      <arg name="correction_enabled" value="$(arg localization_correction_enabled)"/>
      <arg name="correction_odom_topic" value="$(arg localization_correction_odom_topic)"/>
      <arg name="correction_mode" value="$(arg localization_correction_mode)"/>
    </include>

    <!-- Perception -->
    <node pkg="competition_perception" type="perception_node" name="perception"
          output="screen" respawn="true" />

    <!-- Mapping -->
    <node pkg="competition_mapping" type="mapping_node" name="mapping"
          output="screen" respawn="true" />

    <!-- Planning -->
    <group if="$(arg planning_enabled)">
      <node pkg="competition_planning" type="planning_node" name="planning"
            output="screen" respawn="true">
        <remap from="/competition/path" to="$(arg planning_path_topic)" />
        <param name="inflation_radius" value="$(arg planning_inflation_radius)" />
        <param name="frontier_min_size" value="$(arg planning_frontier_min_size)" />
        <param name="frontier_goal_search_radius_cells"
               value="$(arg planning_frontier_goal_search_radius_cells)" />
        <param name="return_goal_search_radius_cells"
               value="$(arg planning_return_goal_search_radius_cells)" />
        <param name="return_path_commit_enabled"
               value="$(arg planning_return_path_commit_enabled)" />
        <param name="return_recommit_on_stuck_enabled"
               value="$(arg planning_return_recommit_on_stuck_enabled)" />
        <param name="exploration_blocked_nudge_enabled"
               value="$(arg planning_exploration_blocked_nudge_enabled)" />
        <param name="exploration_blocked_nudge_distance"
               value="$(arg planning_exploration_blocked_nudge_distance)" />
        <param name="size_weight" value="$(arg planning_frontier_size_weight)" />
        <param name="heading_weight" value="$(arg planning_heading_weight_cells)" />
        <param name="initial_forward_distance"
               value="$(arg planning_initial_forward_distance)" />
        <param name="initial_forward_lookahead"
               value="$(arg planning_initial_forward_lookahead)" />
        <param name="path_compression_enabled"
               value="$(arg planning_path_compression_enabled)" />
        <param name="exploration_complete_confirmations"
               value="$(arg planning_exploration_complete_confirmations)" />
        <param name="visual_scan_enabled"
               value="$(arg planning_visual_scan_enabled)" />
        <param name="visual_scan_yaw_step"
               value="$(arg planning_visual_scan_yaw_step)" />
        <param name="visual_scan_yaw_tolerance"
               value="$(arg planning_visual_scan_yaw_tolerance)" />
        <param name="visual_scan_dwell"
               value="$(arg planning_visual_scan_dwell)" />
        <param name="visual_scan_heading_timeout"
               value="$(arg planning_visual_scan_heading_timeout)" />
        <param name="visual_scan_timeout"
               value="$(arg planning_visual_scan_timeout)" />
        <param name="visual_scan_position_dedup_radius"
               value="$(arg planning_visual_scan_position_dedup_radius)" />
        <param name="visual_scan_target_tolerance"
               value="$(arg planning_visual_scan_target_tolerance)" />
        <param name="visual_scan_max_heading_retries"
               value="$(arg planning_visual_scan_max_heading_retries)" />
        <param name="visual_scan_update_interval"
               value="$(arg planning_visual_scan_update_interval)" />
        <param name="visual_scan_final_before_complete"
               value="$(arg planning_visual_scan_final_before_complete)" />
        <param name="start_recovery_radius_cells"
               value="$(arg planning_start_recovery_radius_cells)" />
      </node>
    </group>

    <!-- Path follower -->
    <node pkg="competition_control" type="path_follower_node" name="path_follower"
          output="screen" respawn="true">
      <param name="max_angular" value="$(arg path_follower_max_angular)" />
      <param name="orientation_tolerance"
             value="$(arg path_follower_orientation_tolerance)" />
      <param name="min_linear" value="$(arg path_follower_min_linear)" />
      <param name="stuck_duration_sec" value="$(arg path_follower_stuck_duration_sec)" />
      <param name="stuck_progress_epsilon" value="$(arg path_follower_stuck_progress_epsilon)" />
      <param name="stuck_backoff_linear" value="$(arg path_follower_stuck_backoff_linear)" />
      <param name="stuck_backoff_duration" value="$(arg path_follower_stuck_backoff_duration)" />
      <param name="stuck_backoff_max" value="$(arg path_follower_stuck_backoff_max)" />
      <param name="path_timeout" value="$(arg path_follower_path_timeout)" />
    </node>
  </group>

</launch>
