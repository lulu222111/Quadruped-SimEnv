<?xml version="1.0"?>
<package format="2">
  <name>competition_localization</name>
  <version>0.1.0</version>
  <description>Legitimate robot localization using only allowed sensors (Livox, IMU).
  Gazebo ground truth topics are strictly prohibited.</description>

  <maintainer email="jiwenhan@example.com">jiwenhan</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>tf2_ros</build_depend>
  <build_depend>competition_interfaces</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>competition_interfaces</exec_depend>
</package>
