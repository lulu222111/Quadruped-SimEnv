<launch>
  <!--
    ================================================================
    EXPERIMENTAL / VALIDATION ONLY
    NOT YET APPROVED FOR FORMAL COMPETITION MODE
    ================================================================

    Self-contained experimental chain:
      raw Livox PointCloud2 -> filter_livox -> FAST-LIO
      JointState + trunk IMU -> leg_odometry -> localization correction

    Sensor compliance of /a1_gazebo/joint_states and /trunk_imu remains
    unconfirmed.  This launch is intentionally not included by the formal
    competition_system.launch.
  -->

  <arg name="rviz" default="false" />
  <arg name="raw_cloud_topic" default="/livox/Pointcloud2" />
  <arg name="filtered_cloud_topic" default="/livox/Pointcloud2_filtered" />
  <arg name="imu_topic" default="/livox/imu" />
  <arg name="joint_state_topic" default="/a1_gazebo/joint_states" />
  <arg name="leg_imu_topic" default="/trunk_imu" />
  <arg name="leg_odom_topic" default="/leg_odometry" />
  <arg name="odom_input_topic" default="/Odometry" />
  <arg name="team_scene_info_path" default="generated_building/team_scene_info.json" />
  <arg name="filter_size_surf" default="0.15" />
  <arg name="filter_size_map" default="0.25" />
  <arg name="correction_enabled" default="true" />
  <arg name="correction_mode" default="planar_relative" />
  <arg name="correction_timeout" default="0.5" />
  <arg name="max_correction_skew" default="0.20" />
  <arg name="max_imu_age" default="0.5" />
  <arg name="max_imu_joint_skew" default="0.05" />

  <node pkg="competition_localization" type="filter_livox.py" name="filter_livox"
        output="screen" respawn="false">
    <param name="input_topic" value="$(arg raw_cloud_topic)" />
    <param name="output_topic" value="$(arg filtered_cloud_topic)" />
    <!-- Existing PR policy; intentionally unchanged in this hardening pass. -->
    <param name="min_range" type="double" value="1.0" />
    <param name="max_range" type="double" value="40.0" />
  </node>

  <node pkg="competition_localization" type="leg_odometry.py" name="leg_odometry"
        output="screen" respawn="false">
    <param name="joint_state_topic" value="$(arg joint_state_topic)" />
    <param name="imu_topic" value="$(arg leg_imu_topic)" />
    <param name="odom_topic" value="$(arg leg_odom_topic)" />
    <param name="max_imu_age" value="$(arg max_imu_age)" />
    <param name="max_imu_joint_skew" value="$(arg max_imu_joint_skew)" />
    <param name="frame_id" value="c2r28_fastlio_local" />
    <param name="child_frame_id" value="c2r28_base" />
    <!-- Preserve PR #16 candidate values; this pass does not retune them. -->
    <param name="vel_scale" type="double" value="1.2" />
    <param name="lp_alpha" type="double" value="0.8" />
    <param name="contact_vz_thresh" type="double" value="0.15" />
  </node>

  <rosparam command="load" file="$(find fast_lio)/config/mid360_sim.yaml" />
  <param name="common/lid_topic" type="string" value="$(arg filtered_cloud_topic)" />

  <rosparam param="mapping/extrinsic_T" subst_value="True">[0.011, 0.02329, -0.04412]</rosparam>
  <rosparam param="mapping/extrinsic_R" subst_value="True">[1, 0, 0,
                                                               0, 1, 0,
                                                               0, 0, 1]</rosparam>
  <param name="mapping/extrinsic_est_en" type="bool" value="false" />
  <param name="mapping/acc_cov" type="double" value="1.0" />
  <param name="mapping/gyr_cov" type="double" value="1.0" />
  <param name="mapping/b_acc_cov" type="double" value="0.001" />
  <param name="mapping/b_gyr_cov" type="double" value="0.001" />
  <param name="feature_extract_enable" type="bool" value="0" />
  <param name="point_filter_num" type="int" value="2" />
  <param name="max_iteration" type="int" value="5" />
  <param name="filter_size_surf" type="double" value="$(arg filter_size_surf)" />
  <param name="filter_size_map" type="double" value="$(arg filter_size_map)" />
  <param name="cube_side_length" type="double" value="1000" />
  <param name="runtime_pos_log_enable" type="bool" value="0" />
  <param name="pcd_save/pcd_save_en" type="bool" value="false" />

  <node pkg="fast_lio" type="fastlio_mapping" name="laserMapping" output="screen"
        respawn="false">
    <remap from="/livox/lidar" to="$(arg filtered_cloud_topic)" />
    <remap from="/livox/imu" to="$(arg imu_topic)" />
  </node>

  <node pkg="competition_localization" type="localization_node" name="localization"
        output="screen" respawn="false">
    <param name="odom_input_topic" value="$(arg odom_input_topic)" />
    <param name="team_scene_info_path" value="$(arg team_scene_info_path)" />
    <param name="publish_tf" value="true" />
    <param name="correction_enabled" value="$(arg correction_enabled)" />
    <param name="correction_odom_topic" value="$(arg leg_odom_topic)" />
    <param name="correction_mode" value="$(arg correction_mode)" />
    <param name="correction_timeout" value="$(arg correction_timeout)" />
    <param name="max_correction_skew" value="$(arg max_correction_skew)" />
    <param name="correction_frame_id" value="c2r28_fastlio_local" />
    <param name="correction_child_frame_id" value="c2r28_base" />
    <rosparam param="base_to_imu_translation">[0.223404, -0.023290, 0.118985]</rosparam>
    <rosparam param="base_to_imu_rotation_rpy">[0.0, 0.785, 0.0]</rosparam>
  </node>
</launch>
