<?xml version="1.0"?>
<launch>
  <node
    pkg="competition_planning"
    type="planning_node"
    name="planning_node"
    output="screen">

    <param
      name="replan_interval"
      value="0.1" />
  </node>

  <test
    test-name="planning_node_ros_test"
    pkg="competition_planning"
    type="planning_node_ros_test.py"
    time-limit="30.0" />
</launch>