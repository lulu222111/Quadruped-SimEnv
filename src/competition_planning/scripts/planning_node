    SCAN_STARTED,
    SCAN_TIMEOUT,
    VisualCoverageTracker,
)


WORLD_FRAME = "world"
BASE_FRAME = "base"

# Demo-only hard-coded room-mission drive (SEED-agnostic fixed layout, world
# metres): entry -> drive central corridor -> south rooms (east/west) ->
# corridor north -> north rooms (east/west) -> hold in lobby.  Each point must
# be reachable over already-free space as the robot advances (spacing is
# within Mid-360 corridor line-of-sight so each successive target is opened
# by the time the previous one is reached).  Overridden by
# ~room_mission_targets (JSON list of [x, y]).
# Compact single-pass route (SEED-agnostic demo layout): corridor centre-line
# drive, one/two scan stations per hazard-bearing room, no per-3 m corridor
# stops, no room_3 (no source there). Covers all 6 sources in one south->north
# sweep: E (room_0), A/B/D + F (room_1), C (room_2).
ROOM_MISSION_TARGETS = [
    (0.0, 8.0),     # corridor entry (centre line)
    # room_0 (south-west): one deep station covers E
    (-1.8, 14.6),   # room_0 door
    (-5.6, 13.6),   # room_0 deep (E -7.93,11.13 via visual scan)
    (0.0, 15.0),    # back to corridor centre
    # room_1 (south-east): mid station covers A/B/D, north-end covers F
    (1.8, 14.6),    # room_1 door
    (5.0, 13.8),    # room_1 mid (A 4.48 / B 2.23 / D 7.02)
    (5.6, 20.0),    # room_1 north end (F 5.64,20.29)
    (0.0, 20.5),    # corridor centre (just north of room_1)
    # drive corridor north directly, then into the north-west room
    (0.0, 28.6),    # corridor centre before room_2 door
    (-1.8, 28.9),   # room_2 (north-west) door
    (-4.8, 23.9),   # room_2 south end (C -4.79,23.31)
]


def quaternion_to_yaw(quaternion):
    """Return planar yaw from a geometry_msgs Quaternion."""
    sin_yaw = 2.0 * (
        quaternion.w * quaternion.z
        + quaternion.x * quaternion.y
    )
    cos_yaw = 1.0 - 2.0 * (
        quaternion.y * quaternion.y
        + quaternion.z * quaternion.z
    )
    return atan2(sin_yaw, cos_yaw)


class PlanningNode:
    def __init__(self):
        self.lock = threading.RLock()

        self.generation = 0
        # ROS-time boundary of the current generation. Data whose header
        # stamp is at or before this boundary was produced before the
        # current generation began and must never enter its cache.
        # Generation 0 starts at time zero so any legal non-zero stamp
        # is admitted during startup.
        self.generation_start_stamp = rospy.Time(0)
        self.map_msg = None
        self.odom_msg = None
        self.map_generation = None
        self.odom_generation = None
        self.map_received_at = None
        self.odom_received_at = None

        self.mapping_status = None
        self.localization_status = None
        self.mapping_status_received_at = None
        self.localization_status_received_at = None

        # Per-stream monotonic baselines: a status whose header stamp is
        # not strictly after the last accepted one is a delayed duplicate
        # or out-of-order old message and is dropped without touching any
        # state, so it can neither clear a fault, revive the plan, nor
        # open a new generation. Reset on ROS clock rollback (new
        # timeline).
        self.last_mapping_status_stamp = None
        self.last_localization_status_stamp = None

        self.last_ros_time = None
        self.active_faults = set()
        self.last_status = (
            ModuleStatus.STARTING,
            False,
            0.0,
            "waiting for upstream status and current-generation data",
        )
        self.mission_state = CompetitionStateMsg.WAITING
        self.mission_epoch = 0
        self.exploration_task_id = ''
        self.floor_exploration_active = True
        self.returning = False
        self.return_start_pose = None
        self.return_start_pose_error = None
        # A return route is generated by the existing grid planner.  When
        # enabled, preserve its geometry for the remainder of this return
        # epoch instead of allowing noisy incremental map updates to replace
        # it with a contradictory detour.  The cached route is never
        # generated outside the planner and upstream freshness/validity gates
        # still run before it can be republished.
        self.return_committed_path = None
        self.return_committed_goal = None
        self.return_committed_detail = None
        # Bounded re-commit bookkeeping: at most one drop per RETURNING epoch.
        self._return_recommit_pending = False
        self._return_recommit_used_epoch = -1
        self.initial_forward_anchor = None
        self.initial_forward_complete = False
        # Wedged-target cooldown: a frontier cluster the robot keeps
        # re-planning to without making progress is temporarily excluded from
        # selection so the explorer can pick a different reachable target
        # instead of being stuck on a reachable-but-untraversable false space.
        self.frontier_cooldowns = {}        # first-cell -> expiry (sim s)
        self.active_frontier_cell = None
        self.active_frontier_still_since = None
        self.active_frontier_last_pos = None
        # Demo room-mission state (deterministic room-by-room drive).
        self.room_mission_idx = 0
        # Room-only visual scan zones: hazards spawn only inside rooms, so
        # outside (lobby/corridor/entry) scan stations are skipped.  Empty
        # list = scan anywhere (no gating).
        self.room_scan_zones = []
        self.active_exploration_target = None
        # Once a visual checkpoint is selected, keep the route prefix that
        # reaches that checkpoint stable across ordinary map replans.  The
        # path is still refreshed with current timestamps, but changing its
        # geometry every cycle would reset the follower's waypoint progress
        # and can leave the robot rotating toward a moving first segment.
        self.visual_scan_checkpoint_path = None
        self.visual_scan_checkpoint_goal = None
        # The route checkpoint is a visual-coverage obligation.  Remember
        # where it was assigned so a controller/localization detour cannot
        # leave that obligation pending forever after the robot has made
        # bounded real progress away from it.
        self.visual_scan_checkpoint_origin = None
        self.visual_scan_final_pending = False
        # Preserve the selected frontier's final arrival cell while visual
        # checkpoints are handled on the way there.  Re-planning a fresh
        # frontier after each checkpoint can select a nearby already-covered
        # pocket and discard an unfinished remote route.  The continuation
        # stores only a planner-selected free cell; every publication still
        # comes from a fresh map-validated plan.
        self.frontier_continuation_goal_cell = None
        self.frontier_continuation_frontier_cell = None
        self.frontier_continuation_frontier_count = 0
        self.frontier_continuation_goal_offset_used = False
        self.frontier_continuation_final_pending = False
        self._exploration_complete_streak = 0
        self._exploration_complete_active = False

        self._load_parameters()

        self.visual_coverage = VisualCoverageTracker(
            enabled=self.visual_scan_enabled,
            yaw_step=self.visual_scan_yaw_step,
            yaw_tolerance=self.visual_scan_yaw_tolerance,
            dwell=self.visual_scan_dwell,
            heading_timeout=self.visual_scan_heading_timeout,
            scan_timeout=self.visual_scan_timeout,
            position_dedup_radius=self.visual_scan_position_dedup_radius,
            max_heading_retries=self.visual_scan_max_heading_retries,
            failure_cooldown=self.visual_scan_failure_cooldown,
        )

        self.status_pub = rospy.Publisher(
            "/competition/planning/status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )
        self.goal_pub = rospy.Publisher(
            "/competition/navigation_goal",
            PoseStamped,
            queue_size=1,
            latch=False,
        )
        self.path_pub = rospy.Publisher(
            "/competition/path",
            Path,
            queue_size=1,
            latch=True,
        )
        self.exploration_complete_pub = rospy.Publisher(
            "/competition/planning/exploration_complete",
            Bool,
            queue_size=1,
            latch=True,
        )

        self.map_sub = rospy.Subscriber(
            "/competition/map",
            OccupancyGrid,
            self.map_callback,
            queue_size=1,
        )
        self.mapping_status_sub = rospy.Subscriber(
            "/competition/mapping/status",
            ModuleStatus,
            self.mapping_status_callback,
            queue_size=10,
        )
        self.odom_sub = rospy.Subscriber(
            "/competition/localization/odom",
            Odometry,
            self.odom_callback,
            queue_size=1,
        )
        self.localization_status_sub = rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self.localization_status_callback,
            queue_size=10,
        )
        self.competition_state_sub = rospy.Subscriber(
            "/competition/state",
            CompetitionStateMsg,
            self.competition_state_callback,
            queue_size=1,
        )
        self.stuck_sub = rospy.Subscriber(
            "/competition/planning/stuck",
            Bool,
            self.stuck_callback,
            queue_size=1,
        )

        self.plan_timer = rospy.Timer(
            rospy.Duration(self.replan_interval),
            self.plan_callback,
        )
        self.heartbeat_timer = rospy.Timer(
            rospy.Duration(self.status_heartbeat_interval),
            self.heartbeat_callback,
        )
        self.visual_scan_timer = rospy.Timer(
            rospy.Duration(self.visual_scan_update_interval),
            self.visual_scan_callback,
        )

        self.invalidate_plan(
            ModuleStatus.STARTING,
            0.0,
            "waiting for upstream status and current-generation data",
        )
        self._publish_exploration_complete(False)

        rospy.loginfo(
            "planning_node started: waiting for mapping/localization "
            "status plus current-generation map and odometry"
        )

    def _load_parameters(self):
        try:
            self.frontier_min_size = int(
                rospy.get_param("~frontier_min_size", 5)
            )
            self.replan_interval = float(
                rospy.get_param("~replan_interval", 2.0)
            )
            self.inflation_radius = float(
                rospy.get_param("~inflation_radius", 0.25)
            )
            self.start_recovery_radius_cells = int(
                rospy.get_param("~start_recovery_radius_cells", 0)
            )
            self.frontier_goal_search_radius_cells = int(
                rospy.get_param("~frontier_goal_search_radius_cells", 0)
            )
            self.minimum_standoff_path_length_cells = int(
                rospy.get_param(
                    "~minimum_standoff_path_length_cells", 0
                )
            )
            self.return_goal_search_radius_cells = int(
                rospy.get_param("~return_goal_search_radius_cells", 2)
            )
            self.return_path_commit_enabled = bool(
                rospy.get_param("~return_path_commit_enabled", False)
            )
            # Bounded re-commit on physical stuck (R25): when the follower
            # reports it is wedged (no measured progress while driving), drop
            # the committed RETURNING route exactly once per RETURNING epoch
            # so the next plan_and_publish runs the full A* against the
            # current map with all normal safety gates.  Re-planned paths are
            # re-committed (so map-noise oscillation stays suppressed); only
            # another stuck event clears again.  Default off.
            self.return_recommit_on_stuck_enabled = bool(
                rospy.get_param("~return_recommit_on_stuck_enabled", False)
            )
            # Exploration blocked recovery (R29 planner-BLOCKED deadlock):
            # when no frontier is reachable in the current map (typically a
            # localization-drift-induced enclosure), command a short blind
            # drive toward the nearest frontier cell so the robot re-observes
            # and the map can correct.  Bounded to nudge_distance_m; re-planned
            # every cycle so it terminates naturally once a frontier is
            # reachable again.  Disabled by default.
            self.exploration_blocked_nudge_enabled = bool(
                rospy.get_param(
                    "~exploration_blocked_nudge_enabled", False
                )
            )
            self.exploration_blocked_nudge_distance = float(
                rospy.get_param(
                    "~exploration_blocked_nudge_distance", 2.0
                )
            )
            # Active visual coverage is a planner-local sub-state.  The
            # default heading step is 45 degrees: it overlaps a roughly
            # 60-degree RGB-D horizontal FoV while keeping each episode
            # bounded to eight headings.
            self.visual_scan_enabled = bool(
                rospy.get_param("~visual_scan_enabled", True)
            )
            self.visual_scan_yaw_step = float(
                rospy.get_param("~visual_scan_yaw_step", 0.7853981634)
            )
            self.visual_scan_yaw_tolerance = float(
                rospy.get_param("~visual_scan_yaw_tolerance", 0.15)
            )
            self.visual_scan_dwell = float(
                rospy.get_param("~visual_scan_dwell", 0.6)
            )
            self.visual_scan_heading_timeout = float(
                rospy.get_param("~visual_scan_heading_timeout", 4.0)
            )
            self.visual_scan_timeout = float(
                rospy.get_param("~visual_scan_timeout", 45.0)
            )
            self.visual_scan_failure_cooldown = float(
                rospy.get_param(
                    "~visual_scan_failure_cooldown",
                    5.0,
                )
            )
            self.visual_scan_position_dedup_radius = float(
                rospy.get_param(
                    "~visual_scan_position_dedup_radius", 1.0
                )
            )
            self.visual_scan_route_spacing = float(
                rospy.get_param("~visual_scan_route_spacing", 2.0)
            )
            self.visual_scan_target_tolerance = float(
                rospy.get_param("~visual_scan_target_tolerance", 0.35)
            )
            self.visual_scan_max_heading_retries = int(
                rospy.get_param("~visual_scan_max_heading_retries", 1)
            )
            self.visual_scan_update_interval = float(
                rospy.get_param("~visual_scan_update_interval", 0.1)
            )
            self.visual_scan_final_before_complete = bool(
                rospy.get_param(
                    "~visual_scan_final_before_complete", True
                )
            )
            # Keep the existing same-generation NO_FRONTIER debounce.  The
            # visual scan gate below only delays when that debounce may start.
            self.exploration_complete_confirmations = int(
                rospy.get_param("~exploration_complete_confirmations", 3)
            )
            self.size_weight = float(
                rospy.get_param("~size_weight", 1.0)
            )
            self.distance_weight = float(
                rospy.get_param("~distance_weight", 1.0)
            )
            self.heading_weight = float(
                rospy.get_param("~heading_weight", 0.0)
            )
            self.room_bias_weight = float(
                rospy.get_param("~room_bias_weight", 0.0)
            )
            self.frontier_stuck_hold = float(
                rospy.get_param("~frontier_stuck_hold", 10.0)
            )
            self.frontier_stuck_cooldown = float(
                rospy.get_param("~frontier_stuck_cooldown", 30.0)
            )
            self.room_mission_enabled = bool(
                rospy.get_param("~room_mission_enabled", False)
            )
            self.room_mission_arrival_m = float(
                rospy.get_param("~room_mission_arrival_m", 0.6)
            )
            self.room_mission_search_cells = int(
                rospy.get_param("~room_mission_search_cells", 25)
            )
            raw_targets = rospy.get_param(
                "~room_mission_targets", None
            )
            if raw_targets:
                parsed = json.loads(raw_targets)
                self.room_mission_targets = [
                    (float(p[0]), float(p[1])) for p in parsed
                ]
            else:
                self.room_mission_targets = list(ROOM_MISSION_TARGETS)
            raw_zones = rospy.get_param("~room_scan_zones", None)
            if raw_zones:
                parsed_zones = json.loads(raw_zones)
                self.room_scan_zones = [
                    (
                        float(zone[0]), float(zone[1]),
                        float(zone[2]), float(zone[3]),
                    )
                    for zone in parsed_zones
                ]
            else:
                self.room_scan_zones = []
            self.initial_forward_distance = float(
                rospy.get_param("~initial_forward_distance", 0.0)
            )
            self.initial_forward_lookahead = float(
                rospy.get_param("~initial_forward_lookahead", 2.0)
            )
            self.path_compression_enabled = bool(
                rospy.get_param("~path_compression_enabled", False)
            )
            self.obstacle_threshold = int(
                rospy.get_param("~obstacle_threshold", 50)
            )
            self.map_timeout = float(
                rospy.get_param("~map_timeout", 5.0)
            )
            self.localization_timeout = float(
                rospy.get_param("~localization_timeout", 5.0)
            )
            self.mapping_status_timeout = float(
                rospy.get_param("~mapping_status_timeout", 3.0)
            )
            self.localization_status_timeout = float(
                rospy.get_param("~localization_status_timeout", 3.0)
            )
            self.team_scene_info_path = rospy.get_param(
                "~team_scene_info_path",
                "generated_building/team_scene_info.json",
            )
            self.future_stamp_tolerance = float(
                rospy.get_param("~future_stamp_tolerance", 0.5)
            )
            self.status_heartbeat_interval = float(
                rospy.get_param("~status_heartbeat_interval", 1.0)
            )
        except (TypeError, ValueError, OverflowError) as error:
            raise ValueError(
                "invalid planning parameter: {}".format(error)
            ) from error

        finite_parameters = (
            ("replan_interval", self.replan_interval),
            ("inflation_radius", self.inflation_radius),
            ("size_weight", self.size_weight),
            ("distance_weight", self.distance_weight),
            ("heading_weight", self.heading_weight),
            ("room_bias_weight", self.room_bias_weight),
            ("initial_forward_distance", self.initial_forward_distance),
            ("initial_forward_lookahead", self.initial_forward_lookahead),
            ("map_timeout", self.map_timeout),
            ("localization_timeout", self.localization_timeout),
            ("mapping_status_timeout", self.mapping_status_timeout),
            (
                "localization_status_timeout",
                self.localization_status_timeout,
            ),
            ("future_stamp_tolerance", self.future_stamp_tolerance),
            ("visual_scan_yaw_step", self.visual_scan_yaw_step),
            ("visual_scan_yaw_tolerance", self.visual_scan_yaw_tolerance),
            ("visual_scan_dwell", self.visual_scan_dwell),
            (
                "visual_scan_heading_timeout",
                self.visual_scan_heading_timeout,
            ),
            ("visual_scan_timeout", self.visual_scan_timeout),
            (
                "visual_scan_failure_cooldown",
                self.visual_scan_failure_cooldown,
            ),
            (
                "visual_scan_position_dedup_radius",
                self.visual_scan_position_dedup_radius,
            ),
            ("visual_scan_route_spacing", self.visual_scan_route_spacing),
            (
                "visual_scan_target_tolerance",
                self.visual_scan_target_tolerance,
            ),
            (
                "visual_scan_update_interval",
                self.visual_scan_update_interval,
            ),
            (
                "status_heartbeat_interval",
                self.status_heartbeat_interval,
            ),
        )

        for name, value in finite_parameters:
            if not isfinite(value):
                raise ValueError("{} must be finite".format(name))

        if self.exploration_blocked_nudge_distance < 0.0:
            raise ValueError(
                "exploration_blocked_nudge_distance must not be negative"
            )
        if self.exploration_complete_confirmations < 1:
            raise ValueError(
                "exploration_complete_confirmations must be at least 1"
            )
        if self.visual_scan_max_heading_retries < 0:
            raise ValueError(
                "visual_scan_max_heading_retries must not be negative"
            )
        if self.visual_scan_failure_cooldown < 0.0:
            raise ValueError(
                "visual_scan_failure_cooldown must not be negative"
            )
        if self.frontier_min_size < 1:
            raise ValueError("frontier_min_size must be at least 1")
        if self.replan_interval <= 0.0:
            raise ValueError("replan_interval must be positive")
        if self.inflation_radius < 0.0:
            raise ValueError("inflation_radius must not be negative")
        if self.start_recovery_radius_cells < 0:
            raise ValueError(
                "start_recovery_radius_cells must not be negative"
            )
        if self.frontier_goal_search_radius_cells < 0:
            raise ValueError(
                "frontier_goal_search_radius_cells must not be negative"
            )
        if self.minimum_standoff_path_length_cells < 0:
            raise ValueError(
                "minimum_standoff_path_length_cells must not be negative"
            )
        if self.return_goal_search_radius_cells < 0:
            raise ValueError(
                "return_goal_search_radius_cells must not be negative"
            )
        if self.size_weight < 0.0:
            raise ValueError("size_weight must not be negative")
        if self.distance_weight < 0.0:
            raise ValueError("distance_weight must not be negative")
        if self.heading_weight < 0.0:
            raise ValueError("heading_weight must not be negative")
        if self.room_bias_weight < 0.0:
            raise ValueError("room_bias_weight must not be negative")
        if self.initial_forward_distance < 0.0:
            raise ValueError("initial_forward_distance must not be negative")
        if self.initial_forward_lookahead <= 0.0:
            raise ValueError("initial_forward_lookahead must be positive")
        if self.frontier_stuck_hold <= 0.0:
            raise ValueError("frontier_stuck_hold must be positive")
        if self.frontier_stuck_cooldown <= 0.0:
            raise ValueError("frontier_stuck_cooldown must be positive")
        if self.room_mission_arrival_m <= 0.0:
            raise ValueError("room_mission_arrival_m must be positive")
        if self.room_mission_search_cells <= 0:
            raise ValueError("room_mission_search_cells must be positive")
        if not 1 <= self.obstacle_threshold <= 100:
            raise ValueError("obstacle_threshold must be in [1, 100]")

        positive_parameters = (
            ("map_timeout", self.map_timeout),
            ("localization_timeout", self.localization_timeout),
            ("mapping_status_timeout", self.mapping_status_timeout),
            (
                "localization_status_timeout",
                self.localization_status_timeout,
            ),
            (
                "status_heartbeat_interval",
                self.status_heartbeat_interval,
            ),
        )
        for name, value in positive_parameters:
            if value <= 0.0:
                raise ValueError("{} must be positive".format(name))

        if self.visual_scan_update_interval <= 0.0:
            raise ValueError("visual_scan_update_interval must be positive")
        if self.visual_scan_target_tolerance < 0.0:
            raise ValueError(
                "visual_scan_target_tolerance must not be negative"
            )
        if self.visual_scan_route_spacing <= 0.0:
            raise ValueError(
                "visual_scan_route_spacing must be positive"
            )

        if self.future_stamp_tolerance < 0.0:
            raise ValueError(
                "future_stamp_tolerance must not be negative"
            )

    def _observe_ros_time(self):
        """Atomically observe ROS time and return it, or None if unsafe."""
        with self.lock:
            now = rospy.Time.now()
            previous = self.last_ros_time
            self.last_ros_time = now

            rollback = (
                previous is not None
                and not previous.is_zero()
                and (now.is_zero() or now < previous)
            )
            if rollback:
                self._enter_new_generation(
                    "ros_time_rollback",
                    now,
                    force=True,
                )
                # New timeline: restart the per-stream status baselines so
                # the first status of the new timeline is accepted instead
                # of being dropped as older than pre-rollback statuses.
                self.last_mapping_status_stamp = None
                self.last_localization_status_stamp = None
                self._invalidate_plan_locked(
                    ModuleStatus.FAILED,
                    0.0,
                    "ROS time moved backwards; waiting for a new generation",
                    stamp=now,
                )
                return None

            if now.is_zero():
                self._invalidate_plan_locked(
                    ModuleStatus.STARTING,
                    0.0,
                    "waiting for non-zero ROS time",
                    stamp=now,
                )
                return None

            return now

    def _accept_ingress_stamp_locked(
        self,
        name,
        stamp,
        now,
        fault_name,
    ):
        """Reject zero/future messages before they enter the cache."""
        try:
            if stamp.is_zero():
                raise ValueError(
                    "{} timestamp must be non-zero".format(name)
                )
            future_offset = (stamp - now).to_sec()
            if future_offset > self.future_stamp_tolerance:
                raise ValueError(
                    "{} timestamp is {:.3f}s in the future".format(
                        name,
                        future_offset,
                    )
                )
        except (TypeError, ValueError, OverflowError) as error:
            self._enter_new_generation(fault_name, now)
            self._invalidate_plan_locked(
                ModuleStatus.FAILED,
                0.0,
                str(error),
                stamp=now,
            )
            return False

        self.active_faults.discard(fault_name)
        return True

    def _enter_new_generation(self, fault_name, now, force=False):
        """Invalidate cached data once per active fault or forced event.

        ``now`` must be the ROS time already observed atomically by the
        caller via :meth:`_observe_ros_time`; it becomes the timestamp
        boundary of the new generation. The boundary only moves when the
        generation counter actually advances, so repeated heartbeats of
        one active fault neither bump the generation nor move the
        boundary.
        """
        with self.lock:
            if not force and fault_name in self.active_faults:
                return False

            self.active_faults.add(fault_name)
            self.generation += 1
            self.generation_start_stamp = now
            completion_was_active = (
                self._exploration_complete_active
                or self._exploration_complete_streak > 0
            )
            self._reset_visual_coverage_locked()
            self.map_msg = None
            self.odom_msg = None
            self.map_generation = None
            self.odom_generation = None
            self.map_received_at = None
            self.odom_received_at = None
            if completion_was_active:
                self._publish_exploration_complete(False)
            return True

    def _clear_fault(self, fault_name):
        with self.lock:
            self.active_faults.discard(fault_name)

    def _reset_visual_coverage_locked(self):
        """Reset all scan bookkeeping at a mission/generation boundary."""
        self.visual_coverage.reset()
        self.active_exploration_target = None
        self.visual_scan_checkpoint_path = None
        self.visual_scan_checkpoint_goal = None
        self.visual_scan_checkpoint_origin = None
        self.visual_scan_final_pending = False
        self._clear_frontier_continuation_locked()
        self._exploration_complete_streak = 0
        self._exploration_complete_active = False
        # Fresh mission/generation: drop any wedged-target cooldowns.
        self.frontier_cooldowns = {}
        self.active_frontier_cell = None
        self.active_frontier_still_since = None
        self.active_frontier_last_pos = None
        # Restart the deterministic room-mission drive.
        self.room_mission_idx = 0

    def _clear_frontier_continuation_locked(self):
        """Drop the unfinished frontier route and its visual final marker."""
        self.frontier_continuation_goal_cell = None
        self.frontier_continuation_frontier_cell = None
        self.frontier_continuation_frontier_count = 0
        self.frontier_continuation_goal_offset_used = False
        self.frontier_continuation_final_pending = False

    def _plan_room_mission(
        self,
        map_msg,
        odom_msg,
        robot_cell,
        inflation_radius_cells,
    ):
        """Deterministic demo drive: sequentially reach hard-coded points.

        Returns a plan dict compatible with the shared success publisher, or
        None when the mission is disabled.  While enabled it owns the route
        (no frontier/continuation fallback), so the robot cannot be dragged
        back outside or into false spaces.  Reaching a target advances to the
        next; an unreachable target holds in place (short no-motion route)
        instead of wandering.
        """
        if not self.room_mission_enabled:
            return None
        with self.lock:
            self._clear_frontier_continuation_locked()
            targets = list(self.room_mission_targets)
            idx = self.room_mission_idx

        if not targets:
            return None
        if idx < 0 or idx >= len(targets):
            with self.lock:
                self.room_mission_idx = 0
            idx = 0

        info = map_msg.info
        origin = info.origin
        origin_yaw = quaternion_to_yaw(origin.orientation)
        robot = odom_msg.pose.pose.position

        # Advance past targets the robot has already reached (the final hold
        # point is never advanced past).
        arrival2 = self.room_mission_arrival_m ** 2
        while idx < len(targets) - 1:
            tx, ty = targets[idx]
            dx = robot.x - tx
            dy = robot.y - ty
            if dx * dx + dy * dy > arrival2:
                break
            idx += 1
        with self.lock:
            self.room_mission_idx = idx

        tx, ty = targets[idx]
        goal_cell = world_to_grid_cell(
            (tx, ty),
            resolution=info.resolution,
            origin_x=origin.position.x,
            origin_y=origin.position.y,
            origin_yaw=origin_yaw,
        )
        result = plan_to_goal_region_with_status(
            list(map_msg.data),
            width=info.width,
            height=info.height,
            robot_cell=robot_cell,
            goal_cell=goal_cell,
            goal_search_radius_cells=self.room_mission_search_cells,
            inflation_radius_cells=inflation_radius_cells,
            start_recovery_radius_cells=(
                self.start_recovery_radius_cells
            ),
            obstacle_threshold=self.obstacle_threshold,
        )
        if result.get("status") != PLAN_SUCCESS:
            rospy.logwarn_throttle(
                5.0,
                "planning_node: room_mission target %s unreachable; "
                "holding",
                (round(tx, 2), round(ty, 2)),
            )
            result = {
                "status": PLAN_SUCCESS,
                "path": [robot_cell],
                "goal_cell": robot_cell,
            }
        result["frontier_count"] = 0
        result["frontier_goal_cell"] = result["goal_cell"]
        result["frontier_goal_offset_used"] = False
        result["room_mission_idx"] = idx
        result["room_mission_total"] = len(targets)
        return result

    def _note_frontier_plan(self, cluster, robot_position):
        """Track no-progress wedging on the active frontier cluster.

        Called after every successful non-returning frontier plan.  While the
        planner keeps selecting the same cluster (same first cell) the robot
        is expected to move toward it; if it stays put for more than
        ``frontier_stuck_hold`` seconds the cluster is added to
        ``frontier_cooldowns`` so later plans exclude it and pick a
        different reachable objective instead of looping forever on a
        reachable-but-untraversable false space (e.g. an open stairwell /
        elevator mouth the grid sees as free).
        """
        if not cluster:
            return
        now = rospy.Time.now().to_sec()
        x = robot_position.x
        y = robot_position.y
        with self.lock:
            key = cluster[0]
            if (
                key == self.active_frontier_cell
                and self.active_frontier_last_pos is not None
            ):
                dx = x - self.active_frontier_last_pos[0]
                dy = y - self.active_frontier_last_pos[1]
                moved = (dx * dx + dy * dy) ** 0.5
                if moved >= 0.25:
                    self.active_frontier_still_since = None
                elif self.active_frontier_still_since is None:
                    self.active_frontier_still_since = now
                elif (
                    now - self.active_frontier_still_since
                    > self.frontier_stuck_hold
                ):
                    rospy.logwarn(
                        "planning_node: wedged on frontier cluster %s for "
                        "%.0fs; cooling down for %.0fs",
                        key,
                        now - self.active_frontier_still_since,
                        self.frontier_stuck_cooldown,
                    )
                    expiry = now + self.frontier_stuck_cooldown
                    self.frontier_cooldowns[key] = expiry
                    # Also record the active continuation arrival cell (when
                    # present): it belongs to the same cluster and the
                    # continuation release check keys on it.
                    continuation_cell = (
                        self.frontier_continuation_frontier_cell
                    )
                    if (
                        continuation_cell is not None
                        and continuation_cell != key
                    ):
                        self.frontier_cooldowns[continuation_cell] = expiry
                    self.active_frontier_cell = None
                    self.active_frontier_still_since = None
                self.active_frontier_last_pos = (x, y)
            else:
                self.active_frontier_cell = key
                self.active_frontier_last_pos = (x, y)
                self.active_frontier_still_since = None

    def _cooldown_frontier_cells(self):
        """Return the set of cooldown first-cells that are still active."""
        now = rospy.Time.now().to_sec()
        with self.lock:
            return {
                cell
                for cell, expiry in self.frontier_cooldowns.items()
                if expiry > now
            }

    def _continuation_frontier_cell_cooldowned(self):
        """True if the saved continuation arrival cell is in cooldown."""
        now = rospy.Time.now().to_sec()
        with self.lock:
            cell = self.frontier_continuation_frontier_cell
            if cell is None:
                return False
            return self.frontier_cooldowns.get(cell, 0.0) > now

    def _plan_frontier_continuation(
        self,
        map_msg,
        robot_cell,
        inflation_radius_cells,
        heading_yaw=0.0,
    ):
        """Re-plan to the still-unfinished frontier arrival cell.

        This is deliberately a fixed-goal bridge between visual stations. It
        does not reuse stale path geometry: the current occupancy grid and
        the normal inflated-grid goal planner validate every new route. If
        the saved arrival cell is no longer legal/reachable, release it and
        let the normal frontier selector choose a new target.
        """
        if not self.visual_scan_enabled or not self.visual_coverage.enabled:
            return None

        with self.lock:
            goal_cell = self.frontier_continuation_goal_cell
            frontier_cell = self.frontier_continuation_frontier_cell
            frontier_count = self.frontier_continuation_frontier_count
            goal_offset_used = self.frontier_continuation_goal_offset_used

        if goal_cell is None:
            return None

        result = plan_to_goal_with_status(
            list(map_msg.data),
            width=map_msg.info.width,
            height=map_msg.info.height,
            robot_cell=robot_cell,
            goal_cell=goal_cell,
            inflation_radius_cells=inflation_radius_cells,
            start_recovery_radius_cells=self.start_recovery_radius_cells,
            obstacle_threshold=self.obstacle_threshold,
        )
        retargeted = False
        if result["status"] != PLAN_SUCCESS:
            # The map may invalidate one arrival/standoff cell while leaving
            # the selected frontier region reachable.  Preserve that
            # frontier objective and let the ordinary candidate/standoff
            # contract choose a current legal cell from its cluster.  The
            # preferred-cluster argument deliberately returns UNREACHABLE if
            # the recorded frontier itself is gone, which is the point at
            # which releasing the continuation is justified.
            if frontier_cell is None:
                with self.lock:
                    if self.frontier_continuation_goal_cell == goal_cell:
                        self._clear_frontier_continuation_locked()
                return None
            result = plan_to_frontier_with_status(
                list(map_msg.data),
                width=map_msg.info.width,
                height=map_msg.info.height,
                robot_cell=robot_cell,
                min_frontier_size=self.frontier_min_size,
                inflation_radius_cells=inflation_radius_cells,
                start_recovery_radius_cells=(
                    self.start_recovery_radius_cells
                ),
                frontier_goal_search_radius_cells=(
                    self.frontier_goal_search_radius_cells
                ),
                size_weight=self.size_weight,
                distance_weight=self.distance_weight,
                heading_yaw=heading_yaw,
                heading_weight=self.heading_weight,
                room_bias_weight=self.room_bias_weight,
                minimum_standoff_path_length_cells=(
                    self.minimum_standoff_path_length_cells
                ),
                obstacle_threshold=self.obstacle_threshold,
                preferred_frontier_cell=frontier_cell,
            )
            if result["status"] != PLAN_SUCCESS:
                with self.lock:
                    if self.frontier_continuation_goal_cell == goal_cell:
                        self._clear_frontier_continuation_locked()
                return None
            retargeted = result["goal_cell"] != goal_cell

        if not retargeted:
            result["frontier_count"] = frontier_count
            result["frontier_goal_cell"] = (
                frontier_cell if frontier_cell is not None else goal_cell
            )
            result["frontier_goal_offset_used"] = goal_offset_used
        result["frontier_continuation"] = True
        result["frontier_continuation_retargeted"] = retargeted
        # The commit path uses this to reject a result if a final scan
        # released the continuation while planning was in flight.
        result["continuation_goal_cell"] = goal_cell
        return result

    def _in_room_scan_zone(self, x, y):
        """True when (x, y) lies in any configured room scan zone.

        Empty zones => no gating (scan anywhere).  Used for room-only
        visual scanning: hazards spawn only inside rooms, so rotating to
        scan while in the entry/lobby/corridor is wasted time.
        """
        if not self.room_scan_zones:
            return True
        for x0, x1, y0, y1 in self.room_scan_zones:
            if x0 <= x <= x1 and y0 <= y <= y1:
                return True
        return False

    def _select_visual_scan_checkpoint(
        self,
        path_msg,
        robot_position,
        now,
    ):
        """Choose a progress checkpoint on a newly planned route.

        Frontier replanning can replace a distant frontier goal before the
        robot reaches it.  A route checkpoint keeps visual exposure tied to
        actual motion while avoiding a scan on every grid cell.  The caller
        preserves an existing checkpoint across ordinary replans, then
        re-anchors it only after bounded physical progress shows that the
        pending station was missed.  Failed scan positions are skipped while
        their tracker-owned cooldown is active so a failed starting station
        cannot pin the robot to the same place.
        """
        if not self.visual_scan_enabled or not path_msg.poses:
            return None

        # The starting station is a useful coverage point even when the
        # first frontier route is later invalidated by map updates.  It also
        # makes the first visual exposure independent of a long initial
        # navigation segment.  Subsequent stations are selected by route
        # spacing below because the tracker records this position when the
        # episode finishes.
        first_pose = path_msg.poses[0].pose.position
        first_position = (float(first_pose.x), float(first_pose.y))
        if not self.visual_coverage.scanned_positions:
            if (
                self._in_room_scan_zone(*first_position)
                and not self.visual_coverage.position_is_cooling_down(
                    first_position,
                    now,
                )
            ):
                return first_position

        previous_x = float(robot_position.x)
        previous_y = float(robot_position.y)
        travelled = 0.0
        fallback = None
        for pose_stamped in path_msg.poses:
            current_x = float(pose_stamped.pose.position.x)
            current_y = float(pose_stamped.pose.position.y)
            travelled += hypot(
                current_x - previous_x,
                current_y - previous_y,
            )
            previous_x = current_x
            previous_y = current_y
            current = (current_x, current_y)
            # A covered pose cannot become a new scan station.  Returning a
            # covered endpoint as the short-route fallback makes the caller
            # reach it, receive SCAN_SKIPPED, and replan the same frontier
            # route indefinitely.  If every pose is already covered, return
            # no checkpoint so the full frontier route remains executable.
            if not self._in_room_scan_zone(current_x, current_y):
                continue
            if self.visual_coverage.position_is_covered(current):
                continue
            if self.visual_coverage.position_is_cooling_down(
                current,
                now,
            ):
                continue

            fallback = current
            if travelled >= self.visual_scan_route_spacing:
                return current
        return fallback

    def _visual_checkpoint_should_reanchor_locked(self, robot_position):
        """Return whether a missed checkpoint should be re-anchored.

        A pending checkpoint is kept across ordinary map replans so route
        vertices do not chase the robot.  If the robot has nevertheless
        travelled one configured station spacing from the point where that
        checkpoint was assigned, and is still not near the checkpoint, the
        old obligation has been passed or invalidated.  Re-anchoring lets the
        next plan establish a new, bounded visual station without treating
        the old station as scanned.
        """
        if (
            not self.visual_scan_enabled
            or self.active_exploration_target is None
            or self.visual_scan_checkpoint_origin is None
        ):
            return False

        origin_x, origin_y = self.visual_scan_checkpoint_origin
        progress = hypot(
            float(robot_position.x) - origin_x,
            float(robot_position.y) - origin_y,
        )
        distance_to_checkpoint = hypot(
            float(robot_position.x) - self.active_exploration_target[0],
            float(robot_position.y) - self.active_exploration_target[1],
        )
        return (
            progress >= self.visual_scan_route_spacing
            and distance_to_checkpoint > self.visual_scan_target_tolerance
        )

    @staticmethod
    def _checkpoint_route(path_msg, checkpoint):
        """Return a route prefix ending at the selected scan checkpoint.

        The checkpoint is selected from ``path_msg`` itself, so the nearest
        pose is the route vertex the planner intended to use.  Truncating the
        route makes the follower stop at the station instead of driving past
        it while the planner waits for its next timer tick.
        """
        if not path_msg.poses or checkpoint is None:
            return None, None

        checkpoint_x, checkpoint_y = checkpoint
        checkpoint_index = min(
            range(len(path_msg.poses)),
            key=lambda index: hypot(
                path_msg.poses[index].pose.position.x - checkpoint_x,
                path_msg.poses[index].pose.position.y - checkpoint_y,
            ),
        )
        route = copy.deepcopy(path_msg)
        route.poses = route.poses[: checkpoint_index + 1]
        if not route.poses:
            return None, None
        goal = copy.deepcopy(route.poses[-1])
        return route, goal

    @staticmethod
    def _restamp_path_and_goal(path_msg, goal_msg, stamp):
        """Refresh a held route without changing its geometry."""
        path = copy.deepcopy(path_msg)
        goal = copy.deepcopy(goal_msg)
        path.header.stamp = stamp
        goal.header.stamp = stamp
        for pose in path.poses:
            pose.header.stamp = stamp
        return path, goal

    def _exploration_target_reached_locked(self, robot_position):
        """Return whether the current planner target is within scan range."""
        if self.active_exploration_target is None:
            return False
        return (
            hypot(
                robot_position.x - self.active_exploration_target[0],
                robot_position.y - self.active_exploration_target[1],
            )
            <= self.visual_scan_target_tolerance
        )

    def _handle_reached_exploration_target(self, odom_msg):
        """Start one scan when the current frontier target was reached."""
        with self.lock:
            if self.visual_coverage.active:
                return True
            if self.active_exploration_target is None:
                return False

            robot = odom_msg.pose.pose.position
            if not self._exploration_target_reached_locked(robot):
                return False

            event = self.visual_coverage.start(
                (robot.x, robot.y),
                quaternion_to_yaw(odom_msg.pose.pose.orientation),
                rospy.Time.now().to_sec(),
            )
            if event.kind == SCAN_COOLDOWN:
                rospy.loginfo_throttle(
                    5.0,
                    "planning_node: visual scan retry cooldown active at "
                    "(%.2f, %.2f); continuing frontier exploration",
                    robot.x,
                    robot.y,
                )
                self.active_exploration_target = None
                self.visual_scan_checkpoint_path = None
                self.visual_scan_checkpoint_goal = None
                self.visual_scan_checkpoint_origin = None
                return False

            if event.kind == SCAN_SKIPPED:
                rospy.loginfo(
                    "planning_node: visual scan skipped at nearby covered "
                    "target (%.2f, %.2f)",
                    robot.x,
                    robot.y,
                )
                self.active_exploration_target = None
                self.visual_scan_checkpoint_path = None
                self.visual_scan_checkpoint_goal = None
                self.visual_scan_checkpoint_origin = None
                if self.frontier_continuation_final_pending:
                    self._clear_frontier_continuation_locked()
                else:
                    self.frontier_continuation_final_pending = False
                return False

            self.visual_scan_checkpoint_origin = None
            self.visual_scan_checkpoint_path = None
            self.visual_scan_checkpoint_goal = None
            self.visual_scan_final_pending = False
            self._clear_exploration_complete()
            self._publish_visual_scan_heading_locked(event, odom_msg)
            return True

    def _start_final_visual_scan_if_needed(
        self,
        odom_msg,
        expected_generation=None,
        mission_epoch=None,
    ):
        """Start a last bounded scan before accepting no-frontier completion."""
        if not self.visual_scan_final_before_complete:
            return False

        with self.lock:
            if self.visual_coverage.active:
                return True
            if (
                expected_generation is not None
                and (
                    self.generation != expected_generation
                    or self.map_generation != expected_generation
                    or self.odom_generation != expected_generation
                    or (
                        mission_epoch is not None
                        and self.mission_epoch != mission_epoch
                    )
                )
            ):
                return False

            robot = odom_msg.pose.pose.position
            if not self._in_room_scan_zone(robot.x, robot.y):
                # Room-only final scan: outside a room there is nothing left
                # to expose (hazards spawn only inside rooms).
                self.active_exploration_target = None
                self.visual_scan_checkpoint_path = None
                self.visual_scan_checkpoint_goal = None
                self.visual_scan_checkpoint_origin = None
                self.visual_scan_final_pending = False
                return False
            if self.active_exploration_target is not None:
                distance = hypot(
                    robot.x - self.active_exploration_target[0],
                    robot.y - self.active_exploration_target[1],
                )
                if distance > self.visual_scan_target_tolerance:
                    rospy.loginfo(
                        "planning_node: no frontier before route visual "
                        "checkpoint (%.2f m away); using final scan at "
                        "current position",
                        distance,
                    )

            event = self.visual_coverage.start(
                (robot.x, robot.y),
                quaternion_to_yaw(odom_msg.pose.pose.orientation),
                rospy.Time.now().to_sec(),
            )
            if event.kind == SCAN_COOLDOWN:
                self.active_exploration_target = None
                self.visual_scan_checkpoint_path = None
                self.visual_scan_checkpoint_goal = None
                self.visual_scan_checkpoint_origin = None
                self.visual_scan_final_pending = True
                self._clear_exploration_complete()

                detail = (
                    "final visual scan retry cooldown active; "
                    "coverage remains pending"
                )
                rospy.logwarn_throttle(
                    5.0,
                    "planning_node: %s",
                    detail,
                )
                self._invalidate_plan_locked(
                    ModuleStatus.BLOCKED,
                    0.0,
                    detail,
                )
                return True

            if event.kind == SCAN_SKIPPED:
                self.active_exploration_target = None
                self.visual_scan_checkpoint_path = None
                self.visual_scan_checkpoint_goal = None
                self.visual_scan_checkpoint_origin = None
                return False

            self.active_exploration_target = None
            self.visual_scan_checkpoint_path = None
            self.visual_scan_checkpoint_goal = None
            self.visual_scan_checkpoint_origin = None
            self.visual_scan_final_pending = True
            self._clear_exploration_complete()
            self._publish_visual_scan_heading_locked(event, odom_msg)
            return True

    def visual_scan_callback(self, _event):
        """Advance an active scan without blocking the planner timer."""
        with self.lock:
            if not self.visual_coverage.active or self.returning:
                return
            if self.odom_msg is None:
                return

            odom_msg = self.odom_msg
            current_yaw = quaternion_to_yaw(odom_msg.pose.pose.orientation)

            # Remember whether this is the mandatory final scan used to gate
            # exploration_complete.  The tracker becomes inactive when an
            # episode ends, so this obligation must be captured beforehand.
            final_scan_was_pending = self.visual_scan_final_pending

            event = self.visual_coverage.update(
                current_yaw,
                rospy.Time.now().to_sec(),
            )

            if event.kind in (
                SCAN_STARTED,
                SCAN_NEXT_HEADING,
                SCAN_RETRY_HEADING,
            ) and self.visual_coverage.active:
                self._publish_visual_scan_heading_locked(event, odom_msg)
                return

            if event.kind == SCAN_HEADING_REACHED:
                rospy.loginfo(
                    "planning_node: visual scan heading %d/%d reached; "
                    "dwelling %.2f s",
                    event.heading_index + 1,
                    event.heading_count,
                    self.visual_scan_dwell,
                )
                return

            heading_timeout = event.kind == SCAN_HEADING_TIMEOUT

            frontier_scan_was_final = (
                self.frontier_continuation_final_pending
            )

            self.active_exploration_target = None
            self.visual_scan_checkpoint_path = None
            self.visual_scan_checkpoint_goal = None
            self.visual_scan_checkpoint_origin = None

            if event.kind == SCAN_COMPLETE:
                # Only an explicitly completed episode satisfies the final
                # visual-coverage gate.
                self.visual_scan_final_pending = False
                if frontier_scan_was_final:
                    self._clear_frontier_continuation_locked()
                else:
                    self.frontier_continuation_final_pending = False
                rospy.loginfo(
                    "planning_node: visual scan complete (%d headings); "
                    "resuming frontier exploration",
                    event.heading_count,
                )
                detail = (
                    "visual scan complete; resuming frontier exploration"
                )
                self.last_status = (
                    ModuleStatus.RUNNING,
                    True,
                    0.8,
                    detail,
                )
                self._publish_status_message_locked(
                    ModuleStatus.RUNNING,
                    True,
                    0.8,
                    detail,
                )
                return

            if event.kind == SCAN_TIMEOUT or heading_timeout:
                # A failed scan must never be converted into coverage.  If it
                # was the mandatory final scan, retain the pending obligation
                # so the no-frontier debounce cannot publish completion.
                self.visual_scan_final_pending = final_scan_was_pending
                # Keep an unfinished frontier target across a failed scan;
                # the tracker-owned cooldown will prevent an immediate retry,
                # while the next route still continues toward the same goal.
                self.frontier_continuation_final_pending = (
                    frontier_scan_was_final
                )
                self._clear_exploration_complete()

                if event.kind == SCAN_TIMEOUT:
                    state = ModuleStatus.TIMEOUT
                    reason = "visual scan timed out"
                else:
                    state = ModuleStatus.BLOCKED
                    reason = "visual scan heading timed out"

                detail = (
                    "{}; coverage was not recorded; "
                    "a new scan is required"
                ).format(reason)

                rospy.logwarn("planning_node: %s", detail)
                self._invalidate_plan_locked(
                    state,
                    0.0,
                    detail,
                )
                return

    def _publish_visual_scan_heading_locked(self, event, odom_msg):
        """Publish a stationary two-pose path for the current scan heading."""
        target_yaw = self.visual_coverage.current_heading
        if target_yaw is None:
            return

        robot = odom_msg.pose.pose.position
        current_yaw = quaternion_to_yaw(odom_msg.pose.pose.orientation)
        stamp = rospy.Time.now()
        first_pose = self.make_world_pose(
            robot.x,
            robot.y,
            current_yaw,
            stamp,
        )
        target_pose = self.make_world_pose(
            robot.x,
            robot.y,
            target_yaw,
            stamp,
        )
        path_msg = Path()
        path_msg.header.stamp = stamp
        path_msg.header.frame_id = WORLD_FRAME
        path_msg.poses = [first_pose, target_pose]
        goal_msg = copy.deepcopy(target_pose)

        self.goal_pub.publish(goal_msg)
        self.path_pub.publish(path_msg)
        # The tracker may advance to the next heading when a previous one
        # times out. Use the tracker state for the published/logged target,
        # rather than the transition event's old heading index.
        heading_index = self.visual_coverage.heading_index
        heading_count = self.visual_coverage.heading_count
        detail = (
            "visual scan heading {}/{}; target_yaw={:.3f}; "
            "position=({:.2f}, {:.2f}); event={}"
        ).format(
            heading_index + 1,
            heading_count,
            target_yaw,
            robot.x,
            robot.y,
            event.kind,
        )
        self.last_status = (ModuleStatus.RUNNING, True, 0.8, detail)
        self._publish_status_message_locked(
            ModuleStatus.RUNNING,
            True,
            0.8,
            detail,
            stamp=stamp,
        )

    @staticmethod
    def make_world_pose(x, y, pose_yaw, stamp):
        """Create a world-frame pose without snapping to a map cell."""
        pose = PoseStamped()
        pose.header.stamp = stamp
        pose.header.frame_id = WORLD_FRAME
        pose.pose.position.x = x
        pose.pose.position.y = y
        pose.pose.position.z = 0.0
        pose.pose.orientation.z = sin(pose_yaw / 2.0)
        pose.pose.orientation.w = cos(pose_yaw / 2.0)
        return pose

    def competition_state_callback(self, msg):
        """Switch planner mode using the existing competition state topic."""
        target_returning = msg.state == CompetitionStateMsg.RETURNING
        completion_was_active = False
        with self.lock:
            task_id = getattr(msg, 'exploration_task_id', '')
            first_task = not getattr(self, 'exploration_task_id', '')
            active = getattr(msg, 'floor_exploration_active', True) if task_id else True
            task_changed = task_id != getattr(self, 'exploration_task_id', '')
            lifecycle_changed = task_changed or active != getattr(self, 'floor_exploration_active', True)
            if target_returning == self.returning and not lifecycle_changed:
                return
            self.exploration_task_id = task_id
            self.floor_exploration_active = active
            self.returning = target_returning
            self.mission_state = msg.state
            self.mission_epoch += 1
            completion_was_active = (
                self._exploration_complete_active
                or self._exploration_complete_streak > 0
            )
            self._reset_visual_coverage_locked()
            if task_changed:
                self.initial_forward_anchor = None
                # Entry-first behavior applies on the initial floor only.
                self.initial_forward_complete = not first_task
            if lifecycle_changed:
                self._enter_new_generation('floor_task', rospy.Time.now(), force=True)
                self._clear_fault('floor_task')
            if target_returning:
                self._load_return_start_pose_locked()
                self.return_committed_path = None
                self.return_committed_goal = None
                self.return_committed_detail = None
                self._invalidate_plan_locked(
                    ModuleStatus.STARTING,
                    0.0,
                    "RETURNING: waiting for return goal path",
                )
            else:
                self.return_start_pose = None
                self.return_start_pose_error = None
                self.return_committed_path = None
                self.return_committed_goal = None
                self.return_committed_detail = None
                self._invalidate_plan_locked(
                    ModuleStatus.STARTING,
                    0.0,
                    "mission state changed; waiting for exploration plan",
                )
        if completion_was_active or task_changed:
            self._publish_exploration_complete(False)

    def stuck_callback(self, msg):
        """Drop the committed RETURNING route once when the follower is wedged.

        The follower reports "commanded motion but no measured progress" on
        /competition/planning/stuck.  On a True edge while RETURNING with a
        committed route, clear the commit exactly once per RETURNING epoch so
        the next plan_and_publish runs the full planner against the current
        map (all freshness/validity gates unchanged).  A successful replan is
        re-committed by the normal commit path, so map-noise oscillation stays
        suppressed; only another physical stuck event can clear again.  A False
        edge only re-arms nothing — the per-epoch budget is consumed on drop.
        """
        if not msg.data:
            return
        with self.lock:
            if not self.returning:
                return
            if not self.return_recommit_on_stuck_enabled:
                return
            if self.return_committed_path is None:
                return
            if self._return_recommit_used_epoch == self.mission_epoch:
                rospy.logwarn(
                    "planning_node: stuck reported again in this RETURNING "
                    "epoch; re-commit budget already used, ignoring"
                )
                return
            self._return_recommit_used_epoch = self.mission_epoch
            self.return_committed_path = None
            self.return_committed_goal = None
            self.return_committed_detail = None
            self._invalidate_plan_locked(
                ModuleStatus.STARTING,
                0.0,
                "RETURNING: follower reported stuck; replanning return route",
            )
            rospy.logwarn(
                "planning_node: dropped committed return path after stuck "
                "report (epoch %d); full replan on next cycle",
                self.mission_epoch,
            )

    def _load_return_start_pose_locked(self):
        """Load only the public team scene file; caller owns ``self.lock``."""
        path = self.team_scene_info_path
        if not os.path.isabs(path):
            path = os.path.join(
                rospy.get_param("/competition_loop/workspace_root", ""),
                path,
            )
        try:
            with open(path, "r", encoding="utf-8") as scene_file:
                data = json.load(scene_file)
            if data.get("coordinate_frame") != WORLD_FRAME:
                raise ValueError("coordinate_frame must be 'world'")
            start = data.get("robot_start")
            if not isinstance(start, dict):
                raise ValueError("robot_start is missing")
            values = {
                key: float(start[key])
                for key in ("x", "y", "z", "yaw")
            }
            if not all(isfinite(value) for value in values.values()):
                raise ValueError("robot_start contains non-finite values")
            self.return_start_pose = values
            self.return_start_pose_error = None
            rospy.loginfo(
                "planning_node: loaded return goal from public scene: "
                "x=%.3f y=%.3f z=%.3f yaw=%.3f",
                values["x"], values["y"], values["z"], values["yaw"],
            )
        except (OSError, TypeError, ValueError, KeyError, json.JSONDecodeError) as error:
            self.return_start_pose = None
            self.return_start_pose_error = str(error)
            rospy.logerr("planning_node: return start pose unavailable: %s", error)

    def map_callback(self, msg):
        now = self._observe_ros_time()
        if now is None:
            return
        with self.lock:
            if not self._accept_ingress_stamp_locked(
                "map",
                msg.header.stamp,
                now,
                "map_stamp_invalid",
            ):
                return
            # Strict boundary: a Map produced before the current
            # generation began must be dropped, not cached and not
            # allowed to open yet another generation. Delayed old
            # messages must not revive pre-generation data.
            if msg.header.stamp <= self.generation_start_stamp:
                rospy.logwarn_throttle(
                    5.0,
                    "dropping pre-generation map: header stamp %s is "
                    "not after generation boundary %s",
                    msg.header.stamp,
                    self.generation_start_stamp,
                )
                return
            self.map_msg = msg
            self.map_received_at = now
            self.map_generation = self.generation
            self.active_faults.discard("map_timeout")

    def odom_callback(self, msg):
        now = self._observe_ros_time()
        if now is None:
            return
        with self.lock:
            if not self._accept_ingress_stamp_locked(
                "localization",
                msg.header.stamp,
                now,
                "localization_stamp_invalid",
            ):
                return
            # Strict boundary, symmetric with the Map admission rule:
            # pre-generation Odometry is dropped without touching the
            # current generation or its boundary.
            if msg.header.stamp <= self.generation_start_stamp:
                rospy.logwarn_throttle(
                    5.0,
                    "dropping pre-generation localization: header "
                    "stamp %s is not after generation boundary %s",
                    msg.header.stamp,
                    self.generation_start_stamp,
                )
                return
            self.odom_msg = msg
            self.odom_received_at = now
            self.odom_generation = self.generation
            self.active_faults.discard("localization_timeout")

    def mapping_status_callback(self, msg):
        now = self._observe_ros_time()
        if now is None:
            return

        with self.lock:
            if not self._accept_ingress_stamp_locked(
                "mapping status",
                msg.header.stamp,
                now,
                "mapping_status_stamp_invalid",
            ):
                return
            # Per-stream ordering: a status not strictly after the last
            # accepted one is delayed/duplicate. Dropping it must not
            # change the stored status, clear any fault, or open a
            # generation; in particular an old valid=true status must
            # never mask a newer invalid one.
            if (
                self.last_mapping_status_stamp is not None
                and msg.header.stamp <= self.last_mapping_status_stamp
            ):
                rospy.logwarn_throttle(
                    5.0,
                    "dropping out-of-order mapping status: stamp %s is "
                    "not after last accepted stamp %s",
                    msg.header.stamp,
                    self.last_mapping_status_stamp,
                )
                return
            self.last_mapping_status_stamp = msg.header.stamp
            previous_valid = (
                self.mapping_status is not None
                and self.mapping_status.valid
            )
            self.mapping_status = msg
            self.mapping_status_received_at = now
            self.active_faults.discard("mapping_status_timeout")

            if not msg.valid:
                self._enter_new_generation(
                    "mapping_invalid",
                    now,
                    force=previous_valid,
                )
                self._invalidate_plan_locked(
                    ModuleStatus.BLOCKED,
                    0.0,
                    "mapping status is invalid: {}".format(msg.detail),
                    stamp=now,
                )
            else:
                self.active_faults.discard("mapping_invalid")

    def localization_status_callback(self, msg):
        now = self._observe_ros_time()
        if now is None:
            return

        with self.lock:
            if not self._accept_ingress_stamp_locked(
                "localization status",
                msg.header.stamp,
                now,
                "localization_status_stamp_invalid",
            ):
                return
            # Per-stream ordering, symmetric with mapping status.
            if (
                self.last_localization_status_stamp is not None
                and msg.header.stamp <= self.last_localization_status_stamp
            ):
                rospy.logwarn_throttle(
                    5.0,
                    "dropping out-of-order localization status: stamp %s "
                    "is not after last accepted stamp %s",
                    msg.header.stamp,
                    self.last_localization_status_stamp,
                )
                return
            self.last_localization_status_stamp = msg.header.stamp
            previous_valid = (
                self.localization_status is not None
                and self.localization_status.valid
            )
            self.localization_status = msg
            self.localization_status_received_at = now
            self.active_faults.discard("localization_status_timeout")

            if not msg.valid:
                self._enter_new_generation(
                    "localization_invalid",
                    now,
                    force=previous_valid,
                )
                self._invalidate_plan_locked(
                    ModuleStatus.BLOCKED,
                    0.0,
                    "localization status is invalid: {}".format(msg.detail),
                    stamp=now,
                )
            else:
                self.active_faults.discard("localization_invalid")

    def publish_status(self, state, valid, confidence, detail):
        with self.lock:
            self.last_status = (state, valid, confidence, detail)
            self._publish_status_message_locked(
                state,
                valid,
                confidence,
                detail,
            )

    def _publish_status_message_locked(
        self,
        state,
        valid,
        confidence,
        detail,
        stamp=None,
    ):
        msg = ModuleStatus()
        msg.header.stamp = stamp if stamp is not None else rospy.Time.now()
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        msg.exploration_task_id = getattr(self, 'exploration_task_id', '')
        msg.exploration_complete = bool(
            getattr(self, '_exploration_complete_active', False)
            and getattr(self, 'floor_exploration_active', True)
            and state == ModuleStatus.SUCCEEDED)
        self.status_pub.publish(msg)

    def heartbeat_callback(self, _event):
        now = self._observe_ros_time()
        if now is None:
            return
        with self.lock:
            failure = self._watchdog_failure_locked(now)
            if failure is not None:
                state, confidence, detail = failure
                self._invalidate_plan_locked(
                    state,
                    confidence,
                    detail,
                    stamp=now,
                )
                return
            status = self.last_status
            self._publish_status_message_locked(*status, stamp=now)

    def invalidate_plan(self, state, confidence, detail):
        """Withdraw the latched path and publish an invalid status."""
        with self.lock:
            self._invalidate_plan_locked(state, confidence, detail)

    def _invalidate_plan_locked(
        self,
        state,
        confidence,
        detail,
        stamp=None,
    ):
        """Withdraw path and status while the caller owns self.lock."""
        if stamp is None:
            stamp = rospy.Time.now()
        empty_path = Path()
        empty_path.header.stamp = stamp
        empty_path.header.frame_id = WORLD_FRAME
        self.path_pub.publish(empty_path)
        self.last_status = (state, False, confidence, detail)
        self._publish_status_message_locked(
            state,
            False,
            confidence,
            detail,
            stamp=stamp,
        )

    def _watchdog_failure_locked(self, now):
        """Return an invalid status tuple when cached inputs are unsafe."""
        missing_statuses = []
        if (
            self.mapping_status is None
            or self.mapping_status_received_at is None
        ):
            missing_statuses.append("mapping status")
        if (
            self.localization_status is None
            or self.localization_status_received_at is None
        ):
            missing_statuses.append("localization status")
        if missing_statuses:
            return (
                ModuleStatus.STARTING,
                0.0,
                "waiting for " + " and ".join(missing_statuses),
            )

        stale_statuses = []
        if (
            now - self.mapping_status_received_at
        ).to_sec() > self.mapping_status_timeout:
            stale_statuses.append("mapping status")
        if (
            now - self.localization_status_received_at
        ).to_sec() > self.localization_status_timeout:
            stale_statuses.append("localization status")
        if stale_statuses:
            for name in stale_statuses:
                self._enter_new_generation(
                    name.replace(" ", "_") + "_timeout",
                    now,
                )
            return (
                ModuleStatus.TIMEOUT,
                0.0,
                "stale upstream status timeout: "
                + " and ".join(stale_statuses),
            )

        if (
            not self.mapping_status.valid
            or not self.localization_status.valid
        ):
            invalid_statuses = []
            if not self.mapping_status.valid:
                invalid_statuses.append("mapping")
            if not self.localization_status.valid:
                invalid_statuses.append("localization")
            return (
                ModuleStatus.BLOCKED,
                0.0,
                "invalid upstream status: "
                + " and ".join(invalid_statuses),
            )

        map_missing = (
            self.map_msg is None
            or self.map_received_at is None
            or self.map_generation != self.generation
        )
        odom_missing = (
            self.odom_msg is None
            or self.odom_received_at is None
            or self.odom_generation != self.generation
        )
        if map_missing or odom_missing:
            missing_inputs = []
            if map_missing:
                missing_inputs.append("current-generation map")
            if odom_missing:
                missing_inputs.append(
                    "current-generation localization"
                )
            return (
                ModuleStatus.STARTING,
                0.0,
                "waiting for " + " and ".join(missing_inputs),
            )

        stale_inputs = []
        if (now - self.map_received_at).to_sec() > self.map_timeout:
            stale_inputs.append("map")
        if (
            now - self.odom_received_at
        ).to_sec() > self.localization_timeout:
            stale_inputs.append("localization")
        if stale_inputs:
            for name in stale_inputs:
                self._enter_new_generation(name + "_timeout", now)
            return (
                ModuleStatus.TIMEOUT,
                0.0,
                "stale input timeout: " + " and ".join(stale_inputs),
            )

        try:
            self._validate_message_stamp(
                "mapping status",
                self.mapping_status.header.stamp,
                now,
                self.mapping_status_timeout,
            )
            self._validate_message_stamp(
                "localization status",
                self.localization_status.header.stamp,
                now,
                self.localization_status_timeout,
            )
            self._validate_message_stamp(
                "map",
                self.map_msg.header.stamp,
                now,
                self.map_timeout,
            )
            self._validate_message_stamp(
                "localization",
                self.odom_msg.header.stamp,
                now,
                self.localization_timeout,
            )
        except (TypeError, ValueError, OverflowError) as error:
            self._enter_new_generation(
                "message_timestamp_invalid",
                now,
            )
            return (ModuleStatus.FAILED, 0.0, str(error))

        # All four current-generation timestamps validated: this counts
        # as a full recovery, so a later independent stale message can
        # open a fresh generation again instead of being absorbed by
        # the still-active fault.
        self.active_faults.discard("message_timestamp_invalid")

        return None

    @staticmethod
    def _status_age(now, received_at):
        if received_at is None:
            return None
        return (now - received_at).to_sec()

    def _validate_message_stamp(
        self,
        name,
        stamp,
        now,
        max_age,
    ):
        if stamp.is_zero():
            raise ValueError("{} timestamp must be non-zero".format(name))
        future_offset = (stamp - now).to_sec()
        if future_offset > self.future_stamp_tolerance:
            raise ValueError(
                "{} timestamp is {:.3f}s in the future".format(
                    name,
                    future_offset,
                )
            )
        age = (now - stamp).to_sec()
        if age > max_age:
            raise ValueError(
                "{} timestamp is {:.3f}s old; limit is {:.3f}s".format(
                    name,
                    age,
                    max_age,
                )
            )

    def _commit_invalid_result_if_current(
        self,
        state,
        confidence,
        detail,
        expected_generation,
        map_msg,
        odom_msg,
    ):
        """Commit a negative planning result only for its own snapshot.

        Negative results (``PLAN_NO_FRONTIER``, ``PLAN_UNREACHABLE``
        and computation exceptions) are published only when the
        generation, cached inputs and upstream statuses are still the
        ones the computation ran on, and the watchdog still passes.
        A stale snapshot is discarded so it cannot overwrite the
        current generation's state with an old SUCCEEDED, BLOCKED or
        FAILED result.

        Returns True when the result was committed.
        """
        with self.lock:
            snapshot_is_current = (
                self.generation == expected_generation
                and self.map_generation == expected_generation
                and self.odom_generation == expected_generation
                and self.mapping_status is not None
                and self.mapping_status.valid
                and self.localization_status is not None
                and self.localization_status.valid
            )
            if not snapshot_is_current:
                rospy.logwarn(
                    "discarding negative planning result because its "
                    "generation or inputs changed during planning"
                )
                return False

            commit_now = rospy.Time.now()
            watchdog_failure = self._watchdog_failure_locked(
                commit_now
            )
            if watchdog_failure is not None:
                failure_state, failure_confidence, failure_detail = (
                    watchdog_failure
                )
                self._invalidate_plan_locked(
                    failure_state,
                    failure_confidence,
                    failure_detail,
                    stamp=commit_now,
                )
                return True

            self._invalidate_plan_locked(
                state,
                confidence,
                detail,
                stamp=commit_now,
            )
            return True

    def plan_callback(self, _event):
        now = self._observe_ros_time()
        if now is None:
            return

        with self.lock:
            if not getattr(self, 'floor_exploration_active', True) and not self.returning:
                self._invalidate_plan_locked(ModuleStatus.STARTING, 0.0,
                                             'floor exploration suspended')
                return
            generation = self.generation
            map_msg = self.map_msg
            odom_msg = self.odom_msg
            map_generation = self.map_generation
            odom_generation = self.odom_generation
            map_received_at = self.map_received_at
            odom_received_at = self.odom_received_at
            mapping_status = self.mapping_status
            localization_status = self.localization_status
            mission_epoch = self.mission_epoch
            returning = self.returning
            return_start_pose = (
                dict(self.return_start_pose)
                if self.return_start_pose is not None
                else None
            )
            return_start_pose_error = self.return_start_pose_error
            mapping_status_received_at = (
                self.mapping_status_received_at
            )
            localization_status_received_at = (
                self.localization_status_received_at
            )

        missing_statuses = []
        if mapping_status is None or mapping_status_received_at is None:
            missing_statuses.append("mapping status")
        if (
            localization_status is None
            or localization_status_received_at is None
        ):
            missing_statuses.append("localization status")

        if missing_statuses:
            self.invalidate_plan(
                ModuleStatus.STARTING,
                0.0,
                "waiting for " + " and ".join(missing_statuses),
            )
            return

        stale_statuses = []
        mapping_status_age = self._status_age(
            now,
            mapping_status_received_at,
        )
        localization_status_age = self._status_age(
            now,
            localization_status_received_at,
        )
        if mapping_status_age > self.mapping_status_timeout:
            stale_statuses.append("mapping status")
        if (
            localization_status_age
            > self.localization_status_timeout
        ):
            stale_statuses.append("localization status")

        if stale_statuses:
            for stale_status in stale_statuses:
                self._enter_new_generation(
                    stale_status.replace(" ", "_") + "_timeout",
                    now,
                )
            self.invalidate_plan(
                ModuleStatus.TIMEOUT,
                0.0,
                "stale upstream status timeout: "
                + " and ".join(stale_statuses),
            )
            return

        self._clear_fault("mapping_status_timeout")
        self._clear_fault("localization_status_timeout")

        if not mapping_status.valid or not localization_status.valid:
            invalid_statuses = []
            if not mapping_status.valid:
                invalid_statuses.append("mapping")
            if not localization_status.valid:
                invalid_statuses.append("localization")
            self.invalidate_plan(
                ModuleStatus.BLOCKED,
                0.0,
                "invalid upstream status: "
                + " and ".join(invalid_statuses),
            )
            return

        if returning and return_start_pose is None:
            self.invalidate_plan(
                ModuleStatus.BLOCKED,
                0.0,
                "RETURNING start pose unavailable: {}".format(
                    return_start_pose_error or "unknown error"
                ),
            )
            return

        map_missing = (
            map_msg is None
            or map_received_at is None
            or map_generation != generation
        )
        localization_missing = (
            odom_msg is None
            or odom_received_at is None
            or odom_generation != generation
        )

        if map_missing or localization_missing:
            missing = []
            if map_missing:
                missing.append("current-generation map")
            if localization_missing:
                missing.append("current-generation localization")
            self.invalidate_plan(
                ModuleStatus.STARTING,
                0.0,
                "waiting for " + " and ".join(missing),
            )
            return

        stale_inputs = []
        if (now - map_received_at).to_sec() > self.map_timeout:
            stale_inputs.append("map")
        if (
            (now - odom_received_at).to_sec()
            > self.localization_timeout
        ):
            stale_inputs.append("localization")

        if stale_inputs:
            for stale_input in stale_inputs:
                self._enter_new_generation(
                    stale_input + "_timeout",
                    now,
                )
            detail = "stale input timeout: " + " and ".join(
                stale_inputs
            )
            rospy.logwarn_throttle(5.0, detail)
            self.invalidate_plan(
                ModuleStatus.TIMEOUT,
                0.0,
                detail,
            )
            return

        self._clear_fault("map_timeout")
        self._clear_fault("localization_timeout")

        try:
            self._validate_message_stamp(
                "mapping status",
                mapping_status.header.stamp,
                now,
                self.mapping_status_timeout,
            )
            self._validate_message_stamp(
                "localization status",
                localization_status.header.stamp,
                now,
                self.localization_status_timeout,
            )
            self._validate_message_stamp(
                "map",
                map_msg.header.stamp,
                now,
                self.map_timeout,
            )
            self._validate_message_stamp(
                "localization",
                odom_msg.header.stamp,
                now,
                self.localization_timeout,
            )

            map_frame = map_msg.header.frame_id.strip()
            odom_frame = odom_msg.header.frame_id.strip()
            child_frame = odom_msg.child_frame_id.strip()

            if map_frame != WORLD_FRAME:
                raise ValueError(
                    "map header.frame_id must be 'world', got {!r}".format(
                        map_frame
                    )
                )
            if odom_frame != WORLD_FRAME:
                raise ValueError(
                    "localization header.frame_id must be 'world', "
                    "got {!r}".format(odom_frame)
                )
            if child_frame != BASE_FRAME:
                raise ValueError(
                    "localization child_frame_id must be 'base', "
                    "got {!r}".format(child_frame)
                )

            # A successful frontier route is followed by a planner-local
            # visual scan at the reached target.  While a scan is active its
            # dedicated timer owns the path; normal frontier replanning must
            # not replace an in-progress heading sequence.
            if not returning:
                if self._handle_reached_exploration_target(
                    odom_msg,
                ):
                    return
                with self.lock:
                    if self.visual_coverage.active:
                        return

            self.plan_and_publish(
                map_msg,
                odom_msg,
                generation,
                mission_epoch=mission_epoch,
                returning=returning,
                return_start_pose=return_start_pose,
            )
        except (TypeError, ValueError, OverflowError) as error:
            rospy.logerr_throttle(
                5.0,
                "planning failed: %s",
                str(error),
            )
            # The failure may come from a computation that started in
            # an older generation, so its result is committed only if
            # the snapshot is still the current one.
            self._commit_invalid_result_if_current(
                ModuleStatus.FAILED,
                0.0,
                str(error),
                generation,
                map_msg,
                odom_msg,
            )

    def plan_and_publish(
        self,
        map_msg,
        odom_msg,
        expected_generation,
        mission_epoch=None,
        returning=False,
        return_start_pose=None,
    ):
        if (
            returning
            and self.return_path_commit_enabled
            and self._publish_committed_return_path_if_current(
                expected_generation,
                mission_epoch,
            )
        ):
            return

        info = map_msg.info

        if (
            not isfinite(info.resolution)
            or info.resolution <= 0.0
        ):
            raise ValueError(
                "map resolution must be finite and positive"
            )

        origin = info.origin
        origin_yaw = quaternion_to_yaw(origin.orientation)
        robot_position = odom_msg.pose.pose.position
        robot_yaw = quaternion_to_yaw(odom_msg.pose.pose.orientation)
        frontier_heading_yaw = (
            self.initial_forward_anchor["yaw"]
            if self.initial_forward_anchor is not None
            else robot_yaw
        ) - origin_yaw

        finite_pose_values = (
            origin.position.x,
            origin.position.y,
            origin_yaw,
            robot_position.x,
            robot_position.y,
            robot_yaw,
        )
        if not all(isfinite(value) for value in finite_pose_values):
            raise ValueError(
                "map origin and robot position must be finite"
            )

        robot_cell = world_to_grid_cell(
            (robot_position.x, robot_position.y),
            resolution=info.resolution,
            origin_x=origin.position.x,
            origin_y=origin.position.y,
            origin_yaw=origin_yaw,
        )
        inflation_radius_cells = int(
            ceil(self.inflation_radius / info.resolution)
        )

        initial_forward = False
        frontier_continuation = False
        continuation_goal_cell = None
        mission_result = None
        if returning:
            return_cell = world_to_grid_cell(
                (return_start_pose["x"], return_start_pose["y"]),
                resolution=info.resolution,
                origin_x=origin.position.x,
                origin_y=origin.position.y,
                origin_yaw=origin_yaw,
            )
            result = plan_to_goal_region_with_status(
                list(map_msg.data),
                width=info.width,
                height=info.height,
                robot_cell=robot_cell,
                goal_cell=return_cell,
                goal_search_radius_cells=self.return_goal_search_radius_cells,
                inflation_radius_cells=inflation_radius_cells,
                start_recovery_radius_cells=(
                    self.start_recovery_radius_cells
                ),
                obstacle_threshold=self.obstacle_threshold,
            )
            result["frontier_count"] = 0
        else:
            result = self._plan_initial_forward_segment(
                map_msg,
                odom_msg,
                robot_cell,
                inflation_radius_cells,
            )
            initial_forward = result is not None
        if not returning and not initial_forward:
            mission_result = self._plan_room_mission(
                map_msg,
                odom_msg,
                robot_cell,
                inflation_radius_cells,
            )
        if mission_result is not None:
            result = mission_result
            frontier_continuation = False
            continuation_goal_cell = None
        elif not returning and not initial_forward:
            with self.lock:
                continuation_goal_cell = (
                    self.frontier_continuation_goal_cell
                )
            if (
                continuation_goal_cell is not None
                and self._continuation_frontier_cell_cooldowned()
            ):
                # The continuation target is wedged and cooling down: drop
                # the fixed-arrival route and let the normal selector choose
                # a different (non-cooldown) frontier cluster.
                with self.lock:
                    self._clear_frontier_continuation_locked()
                continuation_goal_cell = None
            if continuation_goal_cell is not None:
                result = self._plan_frontier_continuation(
                    map_msg,
                    robot_cell,
                    inflation_radius_cells,
                    frontier_heading_yaw,
                )
                frontier_continuation = result is not None
            if not frontier_continuation:
                result = plan_to_frontier_with_status(
                    list(map_msg.data),
                    width=info.width,
                    height=info.height,
                    robot_cell=robot_cell,
                    min_frontier_size=self.frontier_min_size,
                    inflation_radius_cells=inflation_radius_cells,
                    start_recovery_radius_cells=(
                        self.start_recovery_radius_cells
                    ),
                    frontier_goal_search_radius_cells=(
                        self.frontier_goal_search_radius_cells
                    ),
                    size_weight=self.size_weight,
                    distance_weight=self.distance_weight,
                    # Inward-biased exploration reference: once the initial-forward
                    # anchor is latched (robot facing the building entrance), keep
                    # using that FIXED inward direction as the frontier heading
                    # reference instead of the ever-changing current yaw.  Otherwise
                    # an unbounded exterior cluster (behind the start pose) keeps
                    # re-capturing the robot whenever it happens to face outward.
                    heading_yaw=frontier_heading_yaw,
                    heading_weight=self.heading_weight,
                    room_bias_weight=self.room_bias_weight,
                    exclude_frontier_cells=(
                        self._cooldown_frontier_cells()
                    ),
                    minimum_standoff_path_length_cells=(
                        self.minimum_standoff_path_length_cells
                    ),
                    obstacle_threshold=self.obstacle_threshold,
                )

        if (
            not returning
            and not initial_forward
            and result is not None
            and result.get("status") == PLAN_SUCCESS
            and result.get("cluster")
        ):
            self._note_frontier_plan(
                result["cluster"],
                odom_msg.pose.pose.position,
            )

        if result["status"] == PLAN_NO_FRONTIER:
            if not returning:
                # A no-frontier snapshot is not enough to finish while the
                # current location still needs its final visual exposure.
                # The scan is started before the normal negative result is
                # committed, so the active rotation path remains available
                # to Control.
                if self._start_final_visual_scan_if_needed(
                    odom_msg,
                    expected_generation=expected_generation,
                    mission_epoch=mission_epoch,
                ):
                    return
                with self.lock:
                    target_pending = (
                        self.active_exploration_target is not None
                        and not self._exploration_target_reached_locked(
                            odom_msg.pose.pose.position
                        )
                    )
                if target_pending:
                    rospy.logwarn_throttle(
                        5.0,
                        "planning_node: delaying no-frontier completion "
                        "until the active exploration target is reached",
                    )
                    return
            if returning:
                detail = "RETURNING: no return frontier/map goal available"
            else:
                detail = "exploration complete: no usable frontier"
            committed = self._commit_invalid_result_if_current(
                ModuleStatus.SUCCEEDED,
                1.0,
                detail,
                expected_generation,
                map_msg,
                odom_msg,
            )
            if committed:
                rospy.loginfo_throttle(5.0, detail)
                if not returning:
                    self._record_exploration_complete(
                        expected_generation,
                        mission_epoch,
                    )
            return

        if result["status"] == PLAN_UNREACHABLE:
            detail_prefix = (
                "RETURNING goal is not reachable; "
                if returning
                else "frontiers detected but none is currently reachable; "
            )
            detail = detail_prefix + (
                "cluster_count={}; reachable_cell_count={}; "
                "reachable_frontier_count={}; robot_cell={}; "
                "robot_cell_raw_value={}; "
                "robot_cell_inflated_value={}; "
                "start_recovery_used={}; "
                "start_recovery_cell={}; "
                "inflation_radius_cells={}"
            ).format(
                result.get("cluster_count", "unknown"),
                result.get("reachable_cell_count", "unknown"),
                result.get("reachable_frontier_count", "unknown"),
                result.get("robot_cell", "unknown"),
                result.get("robot_cell_raw_value", "unknown"),
                result.get("robot_cell_inflated_value", "unknown"),
                result.get("start_recovery_used", "unknown"),
                result.get("start_recovery_cell", "unknown"),
                result.get("inflation_radius_cells", "unknown"),
            )
            if (
                not returning
                and self.exploration_blocked_nudge_enabled
                and result.get("nearest_frontier_cell") is not None
            ):
                nudge_detail = self._publish_exploration_blocked_nudge(
                    map_msg,
                    robot_cell,
                    result["nearest_frontier_cell"],
                    origin_yaw,
                    result,
                )
                if nudge_detail is not None:
                    rospy.logwarn_throttle(5.0, nudge_detail)
                    return
            committed = self._commit_invalid_result_if_current(
                ModuleStatus.BLOCKED,
                0.0,
                detail,
                expected_generation,
                map_msg,
                odom_msg,
            )
            if committed:
                rospy.logwarn_throttle(5.0, detail)
            return

        if result["status"] != PLAN_SUCCESS:
            raise ValueError(
                "unknown planning status: {}".format(result["status"])
            )

        if not returning:
            self._clear_exploration_complete()

        output_path = (
            compress_collinear_path(result["path"])
            if self.path_compression_enabled
            else result["path"]
        )
        stamp = rospy.Time.now()
        path_yaws = path_cell_yaws(
            output_path,
            origin_yaw=origin_yaw,
        )

        path_msg = Path()
        path_msg.header.stamp = stamp
        path_msg.header.frame_id = WORLD_FRAME
        path_msg.poses = [
            self.make_pose(
                cell,
                info,
                origin_yaw,
                stamp,
                pose_yaw,
            )
            for cell, pose_yaw in zip(
                output_path,
                path_yaws,
            )
        ]

        goal_yaw = path_yaws[-1] if path_yaws else origin_yaw
        goal_msg = self.make_pose(
            result["goal_cell"],
            info,
            origin_yaw,
            stamp,
            goal_yaw,
        )

        if returning:
            detail = "RETURNING path with {} poses to start {}; ".format(
                len(output_path),
                result.get("requested_goal_cell", result["goal_cell"]),
            )
            if result.get("goal_offset_used", False):
                detail += "reachable arrival goal {}; ".format(result["goal_cell"])
        elif initial_forward:
            detail = (
                "initial forward exploration path with {} poses to {}; "
            ).format(len(output_path), result["goal_cell"])
        else:
            detail = "planned path with {} poses to frontier {}; ".format(
                len(output_path),
                result.get("frontier_goal_cell", result["goal_cell"]),
            )
            if result.get("frontier_goal_offset_used", False):
                detail += "safe standoff goal {}; ".format(result["goal_cell"])
            if frontier_continuation:
                detail += "frontier continuation; "
        detail += (
            "{} frontier cells detected; robot_cell={}; "
            "robot_cell_raw_value={}; "
            "robot_cell_inflated_value={}; "
            "start_recovery_used={}; start_recovery_cell={}"
        ).format(
            result["frontier_count"],
            result.get("robot_cell", "unknown"),
            result.get("robot_cell_raw_value", "unknown"),
            result.get("robot_cell_inflated_value", "unknown"),
            result.get("start_recovery_used", "unknown"),
            result.get("start_recovery_cell", "unknown"),
        )

        with self.lock:
            result_is_current = (
                self.generation == expected_generation
                and self.map_generation == expected_generation
                and self.odom_generation == expected_generation
                and self.mapping_status is not None
                and self.mapping_status.valid
                and self.localization_status is not None
                and self.localization_status.valid
                and (mission_epoch is None or self.mission_epoch == mission_epoch)
                and self.returning == returning
            )
            if (
                result_is_current
                and frontier_continuation
                and self.frontier_continuation_goal_cell
                != continuation_goal_cell
            ):
                result_is_current = False
            if result_is_current:
                commit_now = rospy.Time.now()
                watchdog_failure = self._watchdog_failure_locked(
                    commit_now
                )
                if watchdog_failure is not None:
                    state, confidence, failure_detail = watchdog_failure
                    self._invalidate_plan_locked(
                        state,
                        confidence,
                        failure_detail,
                        stamp=commit_now,
                    )
                    return

                if (
                    frontier_continuation
                    and result.get("frontier_continuation_retargeted", False)
                    and self.frontier_continuation_goal_cell
                    == continuation_goal_cell
                ):
                    # A current-map alternate in the same frontier cluster
                    # replaces only the invalid arrival cell.  Keep the
                    # continuation identity stable for this commit, then
                    # carry the new planner-selected arrival forward.
                    self.frontier_continuation_goal_cell = tuple(
                        result["goal_cell"]
                    )
                    self.frontier_continuation_frontier_cell = tuple(
                        result["frontier_goal_cell"]
                    )
                    self.frontier_continuation_frontier_count = int(
                        result.get("frontier_count", 0)
                    )
                    self.frontier_continuation_goal_offset_used = bool(
                        result.get("frontier_goal_offset_used", False)
                    )
                    self.frontier_continuation_final_pending = False

                # The final check and all output publications are one
                # lock-protected commit. An invalidating callback can only
                # publish after this block, so an old path cannot revive.
                published_path = path_msg
                published_goal = goal_msg
                published_stamp = stamp
                if not returning:
                    if (
                        not initial_forward
                        and not frontier_continuation
                        and self.visual_scan_enabled
                        and self.visual_coverage.enabled
                    ):
                        # The selected standoff/arrival cell is a logical
                        # continuation target.  It is retained only until
                        # that route reaches its final visual station or the
                        # current map proves the cell invalid.
                        self.frontier_continuation_goal_cell = tuple(
                            result["goal_cell"]
                        )
                        frontier_goal_cell = result.get(
                            "frontier_goal_cell",
                            result["goal_cell"],
                        )
                        self.frontier_continuation_frontier_cell = tuple(
                            frontier_goal_cell
                        )
                        self.frontier_continuation_frontier_count = int(
                            result.get("frontier_count", 0)
                        )
                        self.frontier_continuation_goal_offset_used = bool(
                            result.get("frontier_goal_offset_used", False)
                        )
                    # A checkpoint is a visual-coverage obligation for this
                    # generation, not a copy of the latest frontier route.
                    # Map replanning can move nearby route vertices by more
                    # than target tolerance while the robot is still
                    # approaching the same area.  Replacing the obligation on
                    # every such update makes the target chase the robot and
                    # prevents the scan from ever starting.  Keep it until
                    # the robot reaches it, a scan handles it, or reset()
                    # clears the generation.
                    reanchored_checkpoint = False
                    if self._visual_checkpoint_should_reanchor_locked(
                        robot_position
                    ):
                        previous_checkpoint = (
                            self.active_exploration_target
                        )
                        self.active_exploration_target = None
                        self.visual_scan_checkpoint_path = None
                        self.visual_scan_checkpoint_goal = None
                        self.visual_scan_checkpoint_origin = None
                        reanchored_checkpoint = True
                        rospy.logwarn(
                            "planning_node: re-anchoring missed visual "
                            "scan checkpoint (%.2f, %.2f) after %.2f m "
                            "of progress",
                            previous_checkpoint[0],
                            previous_checkpoint[1],
                            self.visual_scan_route_spacing,
                        )

                    # If a checkpoint is pending, keep the planner-generated
                    # route prefix that reaches it.  Refreshing the same
                    # geometry keeps path_follower's progress monotonic while
                    # still allowing the normal map/localization watchdogs to
                    # invalidate the route.  The prefix is deliberately
                    # bounded by the checkpoint, so the robot cannot pass a
                    # station before the next planner tick can start its
                    # scan.
                    if (
                        self.active_exploration_target is not None
                        and self.visual_scan_checkpoint_path is not None
                    ):
                        (
                            published_path,
                            published_goal,
                        ) = self._restamp_path_and_goal(
                            self.visual_scan_checkpoint_path,
                            self.visual_scan_checkpoint_goal,
                            commit_now,
                        )
                        published_stamp = commit_now
                        detail += " visual_scan_checkpoint_path_held"
                    else:
                        if reanchored_checkpoint:
                            # The robot has made real bounded progress but
                            # missed the old route vertex.  Use its current
                            # formal odometry pose as the next visual station
                            # instead of selecting another possibly stale
                            # route vertex behind the robot.
                            self.active_exploration_target = (
                                float(robot_position.x),
                                float(robot_position.y),
                            )
                            self.visual_scan_checkpoint_origin = (
                                float(robot_position.x),
                                float(robot_position.y),
                            )
                        elif self.active_exploration_target is None:
                            self.active_exploration_target = (
                                self._select_visual_scan_checkpoint(
                                    path_msg,
                                    robot_position,
                                    commit_now.to_sec(),
                                )
                            )
                            if self.active_exploration_target is not None:
                                self.visual_scan_checkpoint_origin = (
                                    float(robot_position.x),
                                    float(robot_position.y),
                                )

                        if self.active_exploration_target is not None:
                            (
                                self.visual_scan_checkpoint_path,
                                self.visual_scan_checkpoint_goal,
                            ) = self._checkpoint_route(
                                path_msg,
                                self.active_exploration_target,
                            )
                            if self.visual_scan_checkpoint_path is not None:
                                published_path = (
                                    self.visual_scan_checkpoint_path
                                )
                                published_goal = (
                                    self.visual_scan_checkpoint_goal
                                )
                                detail += (
                                    " visual_scan_checkpoint_path={};"
                                ).format(
                                    len(published_path.poses),
                                )
                    if self.active_exploration_target is not None:
                        detail += (
                            " visual_scan_checkpoint=({}, {})"
                        ).format(
                            round(self.active_exploration_target[0], 2),
                            round(self.active_exploration_target[1], 2),
                        )
                        if (
                            not initial_forward
                            and self.frontier_continuation_goal_cell
                            is not None
                            and self.visual_scan_checkpoint_goal is not None
                        ):
                            checkpoint_position = (
                                self.visual_scan_checkpoint_goal.pose.position
                            )
                            final_goal_position = goal_msg.pose.position
                            self.frontier_continuation_final_pending = (
                                hypot(
                                    checkpoint_position.x
                                    - final_goal_position.x,
                                    checkpoint_position.y
                                    - final_goal_position.y,
                                )
                                <= self.visual_scan_target_tolerance
                            )
                    elif (
                        not initial_forward
                        and self.frontier_continuation_goal_cell is not None
                        and not self.frontier_continuation_final_pending
                        and not self.visual_coverage.position_is_cooling_down(
                            (robot_position.x, robot_position.y),
                            commit_now.to_sec(),
                        )
                        and hypot(
                            robot_position.x - goal_msg.pose.position.x,
                            robot_position.y - goal_msg.pose.position.y,
                        )
                        <= self.visual_scan_target_tolerance
                    ):
                        # If every pose of a completed route is already
                        # covered, there is no pending visual station.  Do not
                        # retain a zero-length continuation forever.
                        self._clear_frontier_continuation_locked()
                    if reanchored_checkpoint:
                        detail += " visual_scan_checkpoint_reanchored"
                    self.visual_scan_final_pending = False

                self.goal_pub.publish(published_goal)
                self.path_pub.publish(published_path)
                self.last_status = (
                    ModuleStatus.RUNNING,
                    True,
                    1.0,
                    detail,
                )
                self._publish_status_message_locked(
                    ModuleStatus.RUNNING,
                    True,
                    1.0,
                    detail,
                    stamp=published_stamp,
                )
                if (
                    returning
                    and self.return_path_commit_enabled
                    and self.return_committed_path is None
                ):
                    # Preserve the first successful route produced by this
                    # planner for the current RETURNING epoch.  It is an
                    # exact planner output, not a synthetic motion command;
                    # the normal localization/map watchdogs still gate every
                    # later republish.
                    self.return_committed_path = copy.deepcopy(path_msg)
                    self.return_committed_goal = copy.deepcopy(goal_msg)
                    self.return_committed_detail = detail

        if not result_is_current:
            rospy.logwarn(
                "discarding planning result because its "
                "generation or inputs changed during planning"
            )
            return

        rospy.loginfo_throttle(5.0, detail)

    def _publish_committed_return_path_if_current(
        self,
        expected_generation,
        mission_epoch,
    ):
        """Republish the committed planner route only while inputs are safe.

        This is deliberately a planner-local recovery mechanism: it keeps a
        previously valid planner path stable when incremental occupancy-map
        changes make equivalent replans oscillate or temporarily unreachable.
        It never constructs geometry, publishes commands, or suppresses an
        upstream freshness/validity failure.
        """
        with self.lock:
            if (
                self.return_committed_path is None
                or self.return_committed_goal is None
                or self.return_committed_detail is None
            ):
                return False

            result_is_current = (
                self.generation == expected_generation
                and self.map_generation == expected_generation
                and self.odom_generation == expected_generation
                and self.mapping_status is not None
                and self.mapping_status.valid
                and self.localization_status is not None
                and self.localization_status.valid
                and (mission_epoch is None or self.mission_epoch == mission_epoch)
                and self.returning
            )
            if not result_is_current:
                return False

            commit_now = rospy.Time.now()
            watchdog_failure = self._watchdog_failure_locked(commit_now)
            if watchdog_failure is not None:
                state, confidence, detail = watchdog_failure
                self._invalidate_plan_locked(
                    state,
                    confidence,
                    detail,
                    stamp=commit_now,
                )
                return True

            path_msg = copy.deepcopy(self.return_committed_path)
            goal_msg = copy.deepcopy(self.return_committed_goal)
            path_msg.header.stamp = commit_now
            for pose in path_msg.poses:
                pose.header.stamp = commit_now
            goal_msg.header.stamp = commit_now
            detail = (
                "RETURNING committed planner path with {} poses; {}"
            ).format(len(path_msg.poses), self.return_committed_detail)
            self.goal_pub.publish(goal_msg)
            self.path_pub.publish(path_msg)
            self.last_status = (
                ModuleStatus.RUNNING,
                True,
                1.0,
                detail,
            )
            self._publish_status_message_locked(
                ModuleStatus.RUNNING,
                True,
                1.0,
                detail,
                stamp=commit_now,
            )
            return True

    def _plan_initial_forward_segment(
        self,
        map_msg,
        odom_msg,
        robot_cell,
        inflation_radius_cells,
    ):
        """Plan a short map-validated path along the legal initial heading.

        This optional startup policy uses only competition localization and
        the current occupancy grid.  It neither knows scene coordinates nor
        creates a path outside the existing grid planner.
        """
        if self.initial_forward_distance <= 0.0 or self.initial_forward_complete:
            return None

        robot = odom_msg.pose.pose.position
        if self.initial_forward_anchor is None:
            self.initial_forward_anchor = {
                "x": robot.x,
                "y": robot.y,
                "yaw": quaternion_to_yaw(odom_msg.pose.pose.orientation),
            }

        anchor = self.initial_forward_anchor
        direction_x = cos(anchor["yaw"])
        direction_y = sin(anchor["yaw"])
        progress = max(
            0.0,
            (robot.x - anchor["x"]) * direction_x
            + (robot.y - anchor["y"]) * direction_y,
        )
        if progress >= self.initial_forward_distance - 0.25:
            self.initial_forward_complete = True
            return None

        maximum_step = min(
            self.initial_forward_lookahead,
            self.initial_forward_distance - progress,
        )
        anchor_cell = world_to_grid_cell(
            (anchor["x"], anchor["y"]),
            resolution=map_msg.info.resolution,
            origin_x=map_msg.info.origin.position.x,
            origin_y=map_msg.info.origin.position.y,
            origin_yaw=quaternion_to_yaw(map_msg.info.origin.orientation),
        )
        minimum_step = max(0.5, map_msg.info.resolution)
        candidate = plan_to_heading_goal_with_status(
            list(map_msg.data),
            width=map_msg.info.width,
            height=map_msg.info.height,
            robot_cell=robot_cell,
            heading_yaw=anchor["yaw"] - quaternion_to_yaw(map_msg.info.origin.orientation),
            # Replans must keep the initial-forward corridor tied to the
            # latched entry anchor.  Measuring it from the current robot cell
            # lets a lateral detour move the corridor on every map refresh,
            # so projected anchor progress can remain below the completion
            # threshold indefinitely.
            heading_reference_cell=anchor_cell,
            max_forward_cells=(progress + maximum_step) / map_msg.info.resolution,
            min_forward_cells=(progress + minimum_step) / map_msg.info.resolution,
            corridor_half_width_cells=1.0 / map_msg.info.resolution,
            inflation_radius_cells=inflation_radius_cells,
            start_recovery_radius_cells=self.start_recovery_radius_cells,
            obstacle_threshold=self.obstacle_threshold,
        )
        if candidate["status"] != PLAN_SUCCESS:
            return None
        candidate["frontier_count"] = 0
        candidate["initial_forward_target_distance"] = progress + maximum_step
        return candidate

    def _publish_exploration_blocked_nudge(
        self,
        map_msg,
        robot_cell,
        nearest_frontier_cell,
        origin_yaw,
        result,
    ):
        """Command a short blind drive toward the nearest frontier cell.

        Exploration planner-BLOCKED (R29): no frontier is reachable in the
        current map, typically because localization drift enclosed the
        robot's reachability pocket.  Driving toward the nearest frontier
        lets the robot re-observe and the map correct itself.  The nudge is
        bounded to exploration_blocked_nudge_distance metres and re-published
        every replan cycle, so it terminates naturally once a frontier is
        reachable again.  The path intentionally crosses map-occupied cells —
        that is the point (the map is wrong); it is a short, bounded, blind
        probe, not an open-loop run.

        Returns the detail string on success, or None when the nudge cannot
        be produced (e.g. no room to move).
        """
        rx, ry = robot_cell
        fx, fy = nearest_frontier_cell
        dx = fx - rx
        dy = fy - ry
        distance_cells = hypot(dx, dy)
        if distance_cells <= 0.0:
            return None
        nudge_cells = max(
            1,
            int(round(self.exploration_blocked_nudge_distance / map_msg.info.resolution)),
        )
        step = min(distance_cells, nudge_cells)
        gx = int(round(rx + dx / distance_cells * step))
        gy = int(round(ry + dy / distance_cells * step))
        gx = max(0, min(map_msg.info.width - 1, gx))
        gy = max(0, min(map_msg.info.height - 1, gy))
        if (gx, gy) == (rx, ry):
            return None

        goal_yaw = atan2(gy - ry, gx - rx)
        stamp = rospy.Time.now()
        path_msg = Path()
        path_msg.header.stamp = stamp
        path_msg.header.frame_id = WORLD_FRAME
        path_msg.poses = [
            self.make_pose(cell, map_msg.info, origin_yaw, stamp, goal_yaw)
            for cell in ((rx, ry), (gx, gy))
        ]
        goal_msg = self.make_pose(
            (gx, gy), map_msg.info, origin_yaw, stamp, goal_yaw
        )
        self.goal_pub.publish(goal_msg)
        self.path_pub.publish(path_msg)
        detail = (
            "exploration blocked; nudging toward nearest frontier cell "
            "{} ({} m); cluster_count={}; reachable_cell_count={}; "
            "reachable_frontier_count={}"
        ).format(
            (gx, gy),
            step * map_msg.info.resolution,
            result.get("cluster_count", "unknown"),
            result.get("reachable_cell_count", "unknown"),
            result.get("reachable_frontier_count", "unknown"),
        )
        self.last_status = (ModuleStatus.RUNNING, True, 0.5, detail)
        self._publish_status_message_locked(
            ModuleStatus.RUNNING,
            True,
            0.5,
            detail,
            stamp=stamp,
        )
        return detail

    # ------------------------------------------------------------------
    # Structured exploration-complete signal
    # ------------------------------------------------------------------

    def _publish_exploration_complete(self, value):
        """Publish the planner-owned exploration-complete condition."""
        msg = Bool()
        msg.data = bool(value)
        self.exploration_complete_pub.publish(msg)

    def _record_exploration_complete(self, expected_generation, mission_epoch):
        """Confirm consecutive current no-frontier results after all scans."""
        should_publish = False
        with self.lock:
            if (
                self.returning
                or self.visual_coverage.active
                or self.visual_scan_final_pending
                or self.generation != expected_generation
                or self.map_generation != expected_generation
                or self.odom_generation != expected_generation
                or (
                    mission_epoch is not None
                    and self.mission_epoch != mission_epoch
                )
            ):
                return
            self._exploration_complete_streak += 1
            if (
                not self._exploration_complete_active
                and self._exploration_complete_streak
                >= self.exploration_complete_confirmations
            ):
                self._exploration_complete_active = True
                should_publish = True
        if should_publish:
            rospy.loginfo(
                "planning_node: exploration complete after %d consecutive "
                "no-frontier results and completed visual coverage",
                self.exploration_complete_confirmations,
            )
            self._publish_exploration_complete(True)

    def _clear_exploration_complete(self):
        """Withdraw completion evidence after progress or a pending scan."""
        with self.lock:
            was_active = (
                self._exploration_complete_active
                or self._exploration_complete_streak > 0
            )
            self._exploration_complete_active = False
            self._exploration_complete_streak = 0
        if was_active:
            self._publish_exploration_complete(False)

    @staticmethod
    def make_pose(
        cell,
        info,
        origin_yaw,
        stamp,
        pose_yaw,
    ):
        world_x, world_y = grid_cell_to_world(
            cell,
            resolution=info.resolution,
            origin_x=info.origin.position.x,
            origin_y=info.origin.position.y,
            origin_yaw=origin_yaw,
        )

        pose = PoseStamped()
        pose.header.stamp = stamp
        pose.header.frame_id = WORLD_FRAME
        pose.pose.position.x = world_x
        pose.pose.position.y = world_y
        pose.pose.position.z = 0.0
        pose.pose.orientation.z = sin(pose_yaw / 2.0)
        pose.pose.orientation.w = cos(pose_yaw / 2.0)
        return pose


def main():
    rospy.init_node("planning_node", log_level=rospy.INFO)
    PlanningNode()
    rospy.spin()


if __name__ == "__main__":
    main()
