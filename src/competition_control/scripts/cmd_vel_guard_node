#!/usr/bin/env python3
"""Exclusive /cmd_vel publisher and authoritative control-status aggregator.

Subscribes:
  /competition/raw_cmd_vel
  /competition/control/path_follower_status
  /competition/control_enabled
  /competition/emergency_stop

Publishes:
  /cmd_vel
  /competition/control/status

Safety conditions always override the path follower's reported state.
"""

from __future__ import annotations

import math
import threading
import time

import geometry_msgs.msg
import rospy
import std_msgs.msg

from competition_interfaces.msg import ModuleStatus


class CmdVelGuard:
    """Gate raw velocity and aggregate the authoritative control status."""

    def __init__(self):
        rospy.init_node("cmd_vel_guard", log_level=rospy.INFO)

        # Callbacks and the timer share all safety-gating state.
        self._lock = threading.RLock()
        self._generation = 0
        self._last_ros_time = None
        self._min_path_status_stamp = None
        self._raw_generation = None
        self._path_status_generation = None

        self._timeout = self._positive_param("~cmd_vel_timeout", 0.5)
        self._path_status_timeout = self._positive_param(
            "~path_follower_status_timeout", 1.0
        )
        self._max_future_stamp_skew = self._positive_param(
            "~max_future_stamp_skew", 0.2
        )
        self._max_linear_x = self._positive_param("~max_linear_x", 0.5)
        self._max_linear_y = self._positive_param("~max_linear_y", 0.3)
        self._max_angular_z = self._positive_param("~max_angular_z", 1.0)

        self._last_raw_cmd_time = None
        self._last_path_status_time = None
        self._path_status_stamp = None
        self._path_status = None
        self._path_status_error = None
        self._control_enabled = False
        self._emergency_stop = True
        self._raw_cmd_finite = True
        self._raw_linear_x = 0.0
        self._raw_linear_y = 0.0
        self._raw_angular_z = 0.0

        self._raw_sub = rospy.Subscriber(
            "/competition/raw_cmd_vel",
            geometry_msgs.msg.Twist,
            self._raw_cmd_callback,
            queue_size=10,
        )
        self._path_status_sub = rospy.Subscriber(
            "/competition/control/path_follower_status",
            ModuleStatus,
            self._path_status_callback,
            queue_size=10,
        )
        self._enabled_sub = rospy.Subscriber(
            "/competition/control_enabled",
            std_msgs.msg.Bool,
            self._enabled_callback,
            queue_size=1,
        )
        self._estop_sub = rospy.Subscriber(
            "/competition/emergency_stop",
            std_msgs.msg.Bool,
            self._estop_callback,
            queue_size=1,
        )

        # These are the only publishers for the final velocity and public status.
        self._cmd_vel_pub = rospy.Publisher(
            "/cmd_vel", geometry_msgs.msg.Twist, queue_size=1
        )
        self._status_pub = rospy.Publisher(
            "/competition/control/status", ModuleStatus, queue_size=10, latch=True
        )

        self._timer = rospy.Timer(rospy.Duration(0.02), self._control_loop, reset=True)
        rospy.on_shutdown(self._on_shutdown)

        rospy.loginfo(
            "cmd_vel_guard started: cmd timeout=%.2fs, path-status timeout=%.2fs, "
            "future-skew=%.2fs, limits=(%.2f, %.2f, %.2f). Safe defaults are active.",
            self._timeout,
            self._path_status_timeout,
            self._max_future_stamp_skew,
            self._max_linear_x,
            self._max_linear_y,
            self._max_angular_z,
        )

    # ------------------------------------------------------------------
    # Callbacks
    # ------------------------------------------------------------------

    def _raw_cmd_callback(self, msg):
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self._publish_rollback_stop_locked(now)
                # Twist has no Header, so the message that observed the
                # rollback cannot be proven to belong to the new epoch.
                return

            values = (msg.linear.x, msg.linear.y, msg.angular.z)
            self._last_raw_cmd_time = now
            self._raw_generation = self._generation
            self._raw_cmd_finite = all(math.isfinite(value) for value in values)

            if self._raw_cmd_finite:
                (
                    self._raw_linear_x,
                    self._raw_linear_y,
                    self._raw_angular_z,
                ) = values
            else:
                # Never retain a previous non-zero command after invalid input.
                self._raw_linear_x = 0.0
                self._raw_linear_y = 0.0
                self._raw_angular_z = 0.0

    def _path_status_callback(self, msg):
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self._publish_rollback_stop_locked(now)

            stamp_error = self._validate_path_status_stamp_locked(
                msg.header.stamp, now
            )

            if stamp_error is not None:
                # Invalid follower status starts a new local safety generation.
                # A raw command accepted before this fault must not revive
                # after a later valid follower status arrives.
                self._generation += 1
                self._min_path_status_stamp = self._max_stamp(
                    self._min_path_status_stamp,
                    now.to_sec(),
                )
                self._invalidate_raw_generation_locked()

                self._path_status = None
                self._last_path_status_time = None
                self._path_status_stamp = None
                self._path_status_generation = None
                self._path_status_error = stamp_error
                return

            previous = self._path_status
            entering_invalid = (
                not msg.valid
                and (
                    previous is None
                    or self._path_status_error is not None
                    or bool(previous.valid)
                )
            )

            if entering_invalid:
                # Only the transition into invalid starts a new generation.
                # Repeated invalid heartbeats must not invalidate a new raw
                # command that arrived while waiting for recovery.
                self._generation += 1
                self._min_path_status_stamp = self._max_stamp(
                    self._min_path_status_stamp,
                    self._safe_stamp_sec(msg.header.stamp),
                )
                self._invalidate_raw_generation_locked()

            self._path_status = msg
            self._last_path_status_time = now
            self._path_status_stamp = msg.header.stamp
            self._path_status_generation = self._generation
            self._path_status_error = None

    def _enabled_callback(self, msg):
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self._publish_rollback_stop_locked(now)
            self._control_enabled = bool(msg.data)

    def _estop_callback(self, msg):
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self._publish_rollback_stop_locked(now)
            self._emergency_stop = bool(msg.data)

    # ------------------------------------------------------------------
    # Timer / safety decision
    # ------------------------------------------------------------------

    def _control_loop(self, _event):
        # Hold the same lock from safety-state inspection through the final
        # /cmd_vel and control/status publications. A safety callback can
        # therefore either happen before this decision or after its commit,
        # never in between the two.
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self._publish_rollback_stop_locked(now)
                return

            cmd = geometry_msgs.msg.Twist()
            (
                state,
                valid,
                confidence,
                detail,
                allow_motion,
            ) = self._select_status(now)

            if allow_motion:
                cmd.linear.x = self._clamp(
                    self._raw_linear_x, self._max_linear_x
                )
                cmd.linear.y = self._clamp(
                    self._raw_linear_y, self._max_linear_y
                )
                cmd.angular.z = self._clamp(
                    self._raw_angular_z, self._max_angular_z
                )

            # Unused Twist degrees of freedom remain zero.
            self._cmd_vel_pub.publish(cmd)
            self._publish_status(state, valid, confidence, detail, now)

    def _select_status(self, now):
        """Return status fields and whether raw velocity may be forwarded.

        Caller must hold self._lock.
        """

        # Safety-gateway conditions have priority over all follower states.
        if self._emergency_stop:
            return (
                ModuleStatus.BLOCKED,
                False,
                0.0,
                "emergency_stop active",
                False,
            )

        if not self._control_enabled:
            return (
                ModuleStatus.READY,
                False,
                0.0,
                "control_disabled",
                False,
            )

        if not self._raw_cmd_finite:
            return (
                ModuleStatus.FAILED,
                False,
                0.0,
                "non-finite raw_cmd_vel rejected",
                False,
            )

        # Preserve the actual follower-status validation failure even though
        # that failure also invalidates the cached raw command.
        if self._path_status_error is not None:
            return (
                ModuleStatus.FAILED,
                False,
                0.0,
                self._path_status_error,
                False,
            )

        raw_age = self._age(self._last_raw_cmd_time, now)
        if raw_age is None:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "waiting for /competition/raw_cmd_vel",
                False,
            )
        if raw_age < 0.0:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "ROS time moved backwards after raw_cmd_vel",
                False,
            )
        if raw_age > self._timeout:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "raw_cmd_vel timeout ({:.2f}s)".format(self._timeout),
                False,
            )

        if self._path_status is None or self._last_path_status_time is None:
            return (
                ModuleStatus.STARTING,
                False,
                0.0,
                "waiting for /competition/control/path_follower_status",
                False,
            )

        status_age = self._age(self._last_path_status_time, now)
        if status_age < 0.0:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "ROS time moved backwards after path_follower_status",
                False,
            )
        if status_age > self._path_status_timeout:
            return (
                ModuleStatus.TIMEOUT,
                False,
                0.0,
                "path_follower_status timeout ({:.2f}s)".format(
                    self._path_status_timeout
                ),
                False,
            )

        if self._path_status_generation != self._generation:
            return (
                ModuleStatus.STARTING,
                False,
                0.0,
                "waiting for current-generation path_follower_status",
                False,
            )

        follower = self._path_status
        follower_failed = follower.state in (
            ModuleStatus.FAILED,
            ModuleStatus.TIMEOUT,
            ModuleStatus.BLOCKED,
        )
        if follower_failed or not follower.valid:
            state = (
                follower.state
                if follower.state != ModuleStatus.UNKNOWN
                else ModuleStatus.FAILED
            )
            return state, False, 0.0, follower.detail, False

        if follower.state == ModuleStatus.RUNNING:
            if self._raw_generation != self._generation:
                return (
                    ModuleStatus.TIMEOUT,
                    False,
                    0.0,
                    "waiting for current-generation /competition/raw_cmd_vel",
                    False,
                )

            return (
                ModuleStatus.RUNNING,
                True,
                follower.confidence,
                follower.detail,
                True,
            )

        # SUCCEEDED and all non-running states are deliberately zero-velocity.
        return (
            follower.state,
            bool(follower.valid),
            follower.confidence,
            follower.detail,
            False,
        )

    # ------------------------------------------------------------------
    # ROS time / timestamp handling
    # ------------------------------------------------------------------

    def _now_locked(self):
        """Read and observe ROS time while the caller holds self._lock."""
        now = rospy.Time.now()
        now_sec = now.to_sec()
        rolled_back = (
            self._last_ros_time is not None
            and now_sec + 1.0e-9 < self._last_ros_time
        )

        if rolled_back:
            self._generation += 1
            # A rollback starts a new ROS-time epoch. The cutoff must belong
            # to the new epoch, not retain a larger cutoff from an older one.
            self._min_path_status_stamp = now_sec
            self._invalidate_epoch_inputs_locked()

        self._last_ros_time = now_sec
        return now, rolled_back

    def _publish_rollback_stop_locked(self, now):
        """Publish the rollback safety state while the caller holds _lock."""
        self._cmd_vel_pub.publish(geometry_msgs.msg.Twist())
        self._publish_status(
            ModuleStatus.TIMEOUT,
            False,
            0.0,
            (
                "ROS time moved backwards; cached raw_cmd_vel and "
                "path_follower_status invalidated"
            ),
            now,
        )

    def _invalidate_raw_generation_locked(self):
        """Make every previously accepted raw command unusable."""
        self._last_raw_cmd_time = None
        self._raw_generation = None
        self._raw_cmd_finite = True
        self._raw_linear_x = 0.0
        self._raw_linear_y = 0.0
        self._raw_angular_z = 0.0

    def _invalidate_epoch_inputs_locked(self):
        """Discard inputs that are unsafe to reuse across a ROS-time epoch."""
        self._invalidate_raw_generation_locked()

        self._last_path_status_time = None
        self._path_status_stamp = None
        self._path_status = None
        self._path_status_generation = None
        self._path_status_error = None

    def _validate_path_status_stamp_locked(self, stamp, now):
        stamp_sec = self._safe_stamp_sec(stamp)
        now_sec = now.to_sec()

        if (
            stamp_sec is None
            or not math.isfinite(stamp_sec)
            or stamp_sec <= 0.0
        ):
            return "path_follower_status header.stamp must be non-zero and finite"

        if (
            self._min_path_status_stamp is not None
            and stamp_sec + 1.0e-9 < self._min_path_status_stamp
        ):
            return "path_follower_status header.stamp belongs to an old generation"

        age = now_sec - stamp_sec
        if age > self._path_status_timeout:
            return "path_follower_status header.stamp is stale ({:.2f}s)".format(
                age
            )

        if age < -self._max_future_stamp_skew:
            return (
                "path_follower_status header.stamp is too far in the future "
                "({:.2f}s)".format(-age)
            )

        return None

    @staticmethod
    def _safe_stamp_sec(stamp):
        try:
            return float(stamp.to_sec())
        except (AttributeError, TypeError, ValueError, OverflowError):
            return None

    @staticmethod
    def _max_stamp(current, candidate):
        if candidate is None:
            return current
        if current is None:
            return candidate
        return max(current, candidate)

    @staticmethod
    def _age(stamp, now):
        if stamp is None:
            return None
        return (now - stamp).to_sec()

    def _publish_status(self, state, valid, confidence, detail, stamp):
        msg = ModuleStatus()
        msg.header.stamp = stamp
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        self._status_pub.publish(msg)

    def _on_shutdown(self):
        rospy.loginfo("cmd_vel_guard shutting down; publishing zero velocity.")
        zero = geometry_msgs.msg.Twist()
        with self._lock:
            self._emergency_stop = True
            self._control_enabled = False
            self._invalidate_epoch_inputs_locked()
            for _ in range(5):
                self._cmd_vel_pub.publish(zero)
                time.sleep(0.05)

    @staticmethod
    def _clamp(value, limit):
        return max(-limit, min(value, limit))

    @staticmethod
    def _positive_param(name, default):
        value = float(rospy.get_param(name, default))
        if not math.isfinite(value) or value <= 0.0:
            raise ValueError("{} must be finite and greater than zero".format(name))
        return value

    def run(self):
        rospy.spin()


if __name__ == "__main__":
    guard = CmdVelGuard()
    guard.run()
