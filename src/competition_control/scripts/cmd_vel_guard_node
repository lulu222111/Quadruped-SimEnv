#!/usr/bin/env python3
"""cmd_vel_guard_node — exclusive /cmd_vel publisher with safety gating.

This is the ONLY node in the competition system permitted to publish to
the robot's /cmd_vel topic. All other control code MUST publish to
/competition/raw_cmd_vel instead.

Safety features:
  - Defaults to control_enabled=false, emergency_stop=true (safe state)
  - /cmd_vel timeout: if no new raw_cmd_vel within cmd_vel_timeout, publishes zero velocity
  - Parameterised velocity limits on linear.x, linear.y, angular.z
  - On shutdown, publishes multiple zero-velocity messages
  - Does NOT forward unused Twist degrees of freedom (angular.x, angular.y, linear.z)
"""

from __future__ import annotations

import rospy
import geometry_msgs.msg
import std_msgs.msg


class CmdVelGuard:
    """Safety gate between raw velocity commands and the robot's /cmd_vel."""

    def __init__(self):
        rospy.init_node("cmd_vel_guard", log_level=rospy.INFO)

        # --- Parameters (conservative defaults) ---
        self._timeout = rospy.get_param("~cmd_vel_timeout", 0.5)  # seconds
        self._max_linear_x = rospy.get_param("~max_linear_x", 0.5)
        self._max_linear_y = rospy.get_param("~max_linear_y", 0.3)
        self._max_angular_z = rospy.get_param("~max_angular_z", 1.0)

        # --- State ---
        self._last_raw_cmd_time: rospy.Time | None = None
        self._control_enabled = False
        self._emergency_stop = True
        self._raw_linear_x = 0.0
        self._raw_linear_y = 0.0
        self._raw_angular_z = 0.0

        # --- Subscribers ---
        self._raw_sub = rospy.Subscriber(
            "/competition/raw_cmd_vel",
            geometry_msgs.msg.Twist,
            self._raw_cmd_callback,
            queue_size=10,
        )
        self._enabled_sub = rospy.Subscriber(
            "/competition/control_enabled",
            std_msgs.msg.Bool,
            self._enabled_callback,
            queue_size=1,
        )
        self._estop_sub = rospy.Subscriber(
            "/competition/emergency_stop",
            std_msgs.msg.Bool,
            self._estop_callback,
            queue_size=1,
        )

        # --- Exclusive /cmd_vel publisher ---
        self._cmd_vel_pub = rospy.Publisher(
            "/cmd_vel", geometry_msgs.msg.Twist, queue_size=1
        )

        # --- Status publisher ---
        from competition_interfaces.msg import ModuleStatus
        self._status_pub = rospy.Publisher(
            "/competition/control/status", ModuleStatus, queue_size=10, latch=True
        )

        # --- Main control loop timer (50 Hz) ---
        self._timer = rospy.Timer(rospy.Duration(0.02), self._control_loop)

        rospy.on_shutdown(self._on_shutdown)

        rospy.loginfo(
            "cmd_vel_guard started: timeout=%.2fs, limits=(%.2f, %.2f, %.2f). "
            "Default: control_enabled=false, emergency_stop=true.",
            self._timeout,
            self._max_linear_x,
            self._max_linear_y,
            self._max_angular_z,
        )

    # ------------------------------------------------------------------
    # Callbacks
    # ------------------------------------------------------------------

    def _raw_cmd_callback(self, msg: geometry_msgs.msg.Twist):
        self._last_raw_cmd_time = rospy.Time.now()
        self._raw_linear_x = msg.linear.x
        self._raw_linear_y = msg.linear.y
        self._raw_angular_z = msg.angular.z

    def _enabled_callback(self, msg: std_msgs.msg.Bool):
        self._control_enabled = msg.data

    def _estop_callback(self, msg: std_msgs.msg.Bool):
        self._emergency_stop = msg.data

    # ------------------------------------------------------------------
    # Main control loop
    # ------------------------------------------------------------------

    def _control_loop(self, event):
        cmd = geometry_msgs.msg.Twist()
        status_detail = ""

        # Determine the output velocity
        if self._emergency_stop:
            # Estop active → zero velocity
            cmd.linear.x = 0.0
            cmd.linear.y = 0.0
            cmd.angular.z = 0.0
            status_detail = "emergency_stop active"

        elif not self._control_enabled:
            # Control not enabled → zero velocity
            cmd.linear.x = 0.0
            cmd.linear.y = 0.0
            cmd.angular.z = 0.0
            status_detail = "control_disabled"

        elif self._is_timed_out():
            # No recent raw command → timeout → zero velocity
            cmd.linear.x = 0.0
            cmd.linear.y = 0.0
            cmd.angular.z = 0.0
            status_detail = f"cmd_vel_timeout ({self._timeout:.2f}s)"

        else:
            # Normal operation → apply limits and forward
            cmd.linear.x = self._clamp(self._raw_linear_x, self._max_linear_x)
            cmd.linear.y = self._clamp(self._raw_linear_y, self._max_linear_y)
            cmd.angular.z = self._clamp(self._raw_angular_z, self._max_angular_z)
            status_detail = "forwarding"

        # Never forward unused DOF: angular.x, angular.y, linear.z remain 0
        self._cmd_vel_pub.publish(cmd)

        # Publish status
        self._publish_status(status_detail)

    def _is_timed_out(self) -> bool:
        if self._last_raw_cmd_time is None:
            return True
        elapsed = (rospy.Time.now() - self._last_raw_cmd_time).to_sec()
        return elapsed > self._timeout

    def _publish_status(self, detail: str):
        from competition_interfaces.msg import ModuleStatus
        msg = ModuleStatus()
        msg.header.stamp = rospy.Time.now()

        if self._emergency_stop:
            msg.state = ModuleStatus.BLOCKED
            msg.valid = False
        elif not self._control_enabled:
            msg.state = ModuleStatus.READY
            msg.valid = False
        elif self._is_timed_out():
            msg.state = ModuleStatus.BLOCKED
            msg.valid = True
        else:
            msg.state = ModuleStatus.RUNNING
            msg.valid = True

        msg.confidence = 1.0 if msg.valid else 0.0
        msg.detail = detail
        self._status_pub.publish(msg)

    # ------------------------------------------------------------------
    # Shutdown
    # ------------------------------------------------------------------

    def _on_shutdown(self):
        rospy.loginfo("cmd_vel_guard shutting down; publishing zero velocity.")
        zero = geometry_msgs.msg.Twist()
        for _ in range(5):
            self._cmd_vel_pub.publish(zero)
            rospy.sleep(0.05)

    # ------------------------------------------------------------------
    # Helpers
    # ------------------------------------------------------------------

    @staticmethod
    def _clamp(value: float, limit: float) -> float:
        return max(-limit, min(value, limit))

    def run(self):
        rospy.spin()


if __name__ == "__main__":
    guard = CmdVelGuard()
    guard.run()
