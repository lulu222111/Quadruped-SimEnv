#!/usr/bin/env python3
"""Safety-checked path follower for the competition control loop.

Subscribes:
  /competition/path
  /competition/planning/status
  /competition/localization/odom
  /competition/localization/status

Publishes:
  /competition/raw_cmd_vel
  /competition/control/path_follower_status

This node never publishes /cmd_vel or /competition/control/status.
"""

from __future__ import annotations

import math

import geometry_msgs.msg
import nav_msgs.msg
import rospy

from competition_interfaces.msg import ModuleStatus


def clamp(value, low, high):
    return max(low, min(high, value))


def normalize_angle(angle):
    if not math.isfinite(angle):
        raise ValueError("angle is not finite")
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_from_quaternion(q):
    values = (q.x, q.y, q.z, q.w)

    if not all(math.isfinite(value) for value in values):
        raise ValueError("odom quaternion contains NaN or Inf")

    norm = math.sqrt(sum(value * value for value in values))

    if norm < 1.0e-9:
        raise ValueError("odom quaternion has zero norm")

    x, y, z, w = (value / norm for value in values)

    siny_cosp = 2.0 * (w * z + x * y)
    cosy_cosp = 1.0 - 2.0 * (y * y + z * z)

    yaw = math.atan2(siny_cosp, cosy_cosp)

    if not math.isfinite(yaw):
        raise ValueError("computed odom yaw is not finite")

    return yaw


class PathFollower:
    def __init__(self):
        # =========================
        # Planning 数据
        # =========================
        self.path = []
        self.path_frame = ""
        self.path_time = None
        self.path_error = None

        # =========================
        # Localization 数据
        # =========================
        self.odom = None
        self.odom_time = None
        self.odom_error = None

        # =========================
        # 上游模块状态
        # =========================
        self.planning_status = None
        self.planning_status_time = None

        self.localization_status = None
        self.localization_status_time = None

        # 当前正在追踪 Path 中的第几个点
        self.target_index = 0

        # =========================
        # 控制参数
        # =========================
        self.control_frequency = self._positive_param(
            "~control_frequency",
            10.0,
        )

        self.max_linear = self._positive_param(
            "~max_linear",
            0.25,
        )

        self.max_angular = self._positive_param(
            "~max_angular",
            0.8,
        )

        self.goal_tolerance = self._positive_param(
            "~goal_tolerance",
            0.2,
        )

        # =========================
        # timeout 参数
        # =========================
        self.path_timeout = rospy.Duration(
            self._positive_param(
                "~path_timeout",
                5.0,
            )
        )

        self.odom_timeout = rospy.Duration(
            self._positive_param(
                "~odom_timeout",
                1.0,
            )
        )

        self.planning_status_timeout = rospy.Duration(
            self._positive_param(
                "~planning_status_timeout",
                1.0,
            )
        )

        self.localization_status_timeout = rospy.Duration(
            self._positive_param(
                "~localization_status_timeout",
                1.0,
            )
        )

        # =========================
        # Publisher
        # =========================
        self.raw_vel_pub = rospy.Publisher(
            "/competition/raw_cmd_vel",
            geometry_msgs.msg.Twist,
            queue_size=1,
        )

        self.status_pub = rospy.Publisher(
            "/competition/control/path_follower_status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )

        # =========================
        # Subscriber
        # =========================
        rospy.Subscriber(
            "/competition/path",
            nav_msgs.msg.Path,
            self.on_path,
            queue_size=1,
        )

        rospy.Subscriber(
            "/competition/planning/status",
            ModuleStatus,
            self.on_planning_status,
            queue_size=1,
        )

        rospy.Subscriber(
            "/competition/localization/odom",
            nav_msgs.msg.Odometry,
            self.on_odom,
            queue_size=1,
        )

        rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self.on_localization_status,
            queue_size=1,
        )

    # ============================================================
    # Path callback
    # ============================================================

    def on_path(self, msg):
        """Replace the current path.

        An empty Path explicitly cancels the previously cached Path.
        """

        now = rospy.Time.now()

        # 收到一条新 Path，就先让旧 Path 作废。
        self._invalidate_path()

        # 空 Path 的公共语义：
        # 立即撤销此前缓存的旧路径。
        if not msg.poses:
            self.publish_stop(
                ModuleStatus.STARTING,
                "empty /competition/path received; previous path cancelled",
            )

            rospy.loginfo("empty path received; previous path cancelled")

            return

        # 保存新 Path 的基本信息。
        self.path_frame = msg.header.frame_id
        self.path_time = now

        # 检查 Path 是否合法。
        self.path_error = self._validate_path(msg)

        if self.path_error is not None:
            # 非法的新 Path 不能替代旧 Path。
            # 旧 Path 已经在上面作废，所以这里必须停车。
            self.publish_stop(
                ModuleStatus.FAILED,
                self.path_error,
            )

            return

        # Path 合法，正式缓存。
        self.path = list(msg.poses)

        # 根据当前机器人位置选择初始目标点。
        self.target_index = self._initial_target_index()

        rospy.loginfo(
            "path received: %d poses",
            len(msg.poses),
        )

    # ============================================================
    # Planning status callback
    # ============================================================

    def on_planning_status(self, msg):
        """Handle Planning status.

        Planning valid=false invalidates the Path generated before
        this failure.
        """

        previous = self.planning_status

        # None -> false
        # 或 true -> false
        # 都认为进入了一次新的 invalid 状态。
        entering_invalid = previous is None or bool(previous.valid)

        self.planning_status = msg
        self.planning_status_time = rospy.Time.now()

        if not msg.valid:
            # 只有进入 invalid 的瞬间清旧 Path。
            #
            # 如果 Planning 持续发布 valid=false，
            # 后续新 Path 仍然可以作为本 generation 的候选数据缓存，
            # 但是在 status 恢复 valid=true 之前绝不会执行。
            if entering_invalid:
                self._invalidate_path()

            detail = msg.detail or "planning status invalid"

            self.publish_stop(
                ModuleStatus.BLOCKED,
                "planning invalid: {}".format(detail),
            )

    # ============================================================
    # Odometry callback
    # ============================================================

    def on_odom(self, msg):
        """Store and validate the newest Localization Odometry."""

        self.odom = msg
        self.odom_time = rospy.Time.now()

        self.odom_error = self._validate_odom(msg)

        if self.odom_error is not None:
            # Odom 非法时，当前 Path 也不能继续执行。
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.FAILED,
                self.odom_error,
            )

            return

        rospy.loginfo_throttle(
            2.0,
            "odom received",
        )

    # ============================================================
    # Localization status callback
    # ============================================================

    def on_localization_status(self, msg):
        """Handle Localization status.

        Localization valid=false invalidates both the old Odometry
        and the old Path.
        """

        previous = self.localization_status

        entering_invalid = previous is None or bool(previous.valid)

        self.localization_status = msg
        self.localization_status_time = rospy.Time.now()

        if not msg.valid:
            # Localization 刚刚进入 invalid：
            #
            # 失效前旧 Odom 不能再使用；
            # 失效前旧 Path 也不能再使用。
            if entering_invalid:
                self._invalidate_odom()
                self._invalidate_path()

            detail = msg.detail or "localization status invalid"

            self.publish_stop(
                ModuleStatus.BLOCKED,
                "localization invalid: {}".format(detail),
            )

    # ============================================================
    # Status / stop
    # ============================================================

    def publish_status(
        self,
        state,
        valid,
        confidence,
        detail,
    ):
        msg = ModuleStatus()

        msg.header.stamp = rospy.Time.now()
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail

        self.status_pub.publish(msg)

    def publish_stop(
        self,
        state,
        detail,
        valid=False,
        confidence=0.0,
    ):
        # 新建 Twist 时所有速度默认都是 0。
        zero = geometry_msgs.msg.Twist()

        self.raw_vel_pub.publish(zero)

        self.publish_status(
            state,
            valid,
            confidence,
            detail,
        )

    # ============================================================
    # Main control step
    # ============================================================

    def step(self):
        now = rospy.Time.now()

        # ========================================================
        # 1. Planning status 检查
        # ========================================================

        if self.planning_status is None:
            self.publish_stop(
                ModuleStatus.STARTING,
                "waiting for /competition/planning/status",
            )
            return

        planning_status_age = self._age(
            self.planning_status_time,
            now,
        )

        # ROS 时间倒退意味着旧 generation 数据全部失效。
        if planning_status_age < 0.0:
            self._invalidate_all_inputs()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "ROS time moved backwards after planning status reception",
            )
            return

        if planning_status_age > self.planning_status_timeout.to_sec():
            # status timeout 后旧 Path 作废。
            self.planning_status = None
            self.planning_status_time = None

            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "planning status timeout, stop",
            )
            return

        if not self.planning_status.valid:
            detail = self.planning_status.detail or "planning status invalid"

            self.publish_stop(
                ModuleStatus.BLOCKED,
                "planning invalid: {}".format(detail),
            )
            return

        # ========================================================
        # 2. Localization status 检查
        # ========================================================

        if self.localization_status is None:
            self.publish_stop(
                ModuleStatus.STARTING,
                "waiting for /competition/localization/status",
            )
            return

        localization_status_age = self._age(
            self.localization_status_time,
            now,
        )

        if localization_status_age < 0.0:
            self._invalidate_all_inputs()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "ROS time moved backwards after localization status reception",
            )
            return

        if localization_status_age > self.localization_status_timeout.to_sec():
            self.localization_status = None
            self.localization_status_time = None

            # Localization timeout：
            # 旧 Odom 和旧 Path 都不能再使用。
            self._invalidate_odom()
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "localization status timeout, stop",
            )
            return

        if not self.localization_status.valid:
            detail = self.localization_status.detail or "localization status invalid"

            self.publish_stop(
                ModuleStatus.BLOCKED,
                "localization invalid: {}".format(detail),
            )
            return

        # ========================================================
        # 3. Path 检查
        # ========================================================
        if self.odom_error is not None:
            self.publish_stop(
                ModuleStatus.FAILED,
                self.odom_error,
            )
            return

        if self.path_error is not None:
            self.publish_stop(
                ModuleStatus.FAILED,
                self.path_error,
            )
            return

        if not self.path:
            self.publish_stop(
                ModuleStatus.STARTING,
                "waiting for /competition/path",
            )
            return

        path_age = self._age(
            self.path_time,
            now,
        )

        if path_age < 0.0:
            self._invalidate_all_inputs()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "ROS time moved backwards after path reception",
            )
            return

        if path_age > self.path_timeout.to_sec():
            # Path timeout 后旧 Path 永久作废。
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "path timeout, stop",
            )
            return

        # ========================================================
        # 4. Odometry 检查
        # ========================================================

        if self.odom is None:
            self.publish_stop(
                ModuleStatus.STARTING,
                "waiting for /competition/localization/odom",
            )
            return

        odom_age = self._age(
            self.odom_time,
            now,
        )

        if odom_age < 0.0:
            self._invalidate_all_inputs()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "ROS time moved backwards after odom reception",
            )
            return

        if odom_age > self.odom_timeout.to_sec():
            # Odom stale 后：
            # 旧 Odom 与当前旧 Path 都作废。
            self._invalidate_odom()
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.TIMEOUT,
                "odom timeout, stop",
            )
            return

        # ========================================================
        # 5. 最后的 frame 防御检查
        # ========================================================

        if self.path_frame != "world":
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.FAILED,
                "path frame must be world",
            )
            return

        if self.odom.header.frame_id != "world":
            self._invalidate_odom()
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.FAILED,
                "odom frame_id must be world",
            )
            return

        if self.odom.child_frame_id != "base":
            self._invalidate_odom()
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.FAILED,
                "odom child_frame_id must be base",
            )
            return

        # ========================================================
        # 6. 所有安全条件都满足，才允许跟踪 Path
        # ========================================================

        try:
            self._follow_current_target()

        except ValueError as exc:
            # 控制计算本身如果产生非法值，
            # 当前路径也不再继续执行。
            self._invalidate_path()

            self.publish_stop(
                ModuleStatus.FAILED,
                str(exc),
            )

    # ============================================================
    # Path following
    # ============================================================

    def _follow_current_target(self):
        odom_pose = self.odom.pose.pose

        robot_x = odom_pose.position.x
        robot_y = odom_pose.position.y

        if not all(math.isfinite(value) for value in (robot_x, robot_y)):
            raise ValueError("odom position contains NaN or Inf")

        robot_yaw = yaw_from_quaternion(odom_pose.orientation)

        # 如果机器人已经靠近当前目标点，
        # 就继续寻找后面的目标点。
        while self.target_index < len(self.path):
            distance = self._distance_to_target(
                self.path[self.target_index].pose,
                robot_x,
                robot_y,
            )

            if distance >= self.goal_tolerance:
                break

            self.target_index += 1

        # 所有点都已经到达。
        if self.target_index >= len(self.path):
            self.publish_stop(
                ModuleStatus.SUCCEEDED,
                "path finished",
                valid=True,
                confidence=1.0,
            )
            return

        target_pose = self.path[self.target_index].pose

        dx = target_pose.position.x - robot_x

        dy = target_pose.position.y - robot_y

        distance = math.hypot(
            dx,
            dy,
        )

        target_yaw = math.atan2(
            dy,
            dx,
        )

        yaw_error = normalize_angle(target_yaw - robot_yaw)

        if not all(
            math.isfinite(value)
            for value in (
                distance,
                target_yaw,
                yaw_error,
            )
        ):
            raise ValueError("path-following calculation produced NaN or Inf")

        # ========================================================
        # 生成原始速度
        # ========================================================

        cmd = geometry_msgs.msg.Twist()

        # 转向控制
        cmd.angular.z = clamp(
            1.5 * yaw_error,
            -self.max_angular,
            self.max_angular,
        )

        # 朝向误差太大时只旋转，不向前走。
        if abs(yaw_error) < 0.8:
            cmd.linear.x = clamp(
                0.6 * distance,
                0.0,
                self.max_linear,
            )

        # 注意：
        # PathFollower 只能发布 raw_cmd_vel。
        # 最终 /cmd_vel 只能由 cmd_vel_guard 发布。
        self.raw_vel_pub.publish(cmd)

        self.publish_status(
            ModuleStatus.RUNNING,
            True,
            0.6,
            "following waypoint {}/{}".format(
                self.target_index + 1,
                len(self.path),
            ),
        )

    # ============================================================
    # Validation
    # ============================================================

    @staticmethod
    def _validate_path(msg):
        # 空 Path 是合法的取消指令。
        if not msg.poses:
            return None

        # v0.2.0：
        # Path 必须在 world。
        if msg.header.frame_id != "world":
            return "path frame_id must be world"

        # Path 中每一个 PoseStamped 也必须是 world。
        for index, pose_stamped in enumerate(msg.poses):
            if pose_stamped.header.frame_id != "world":
                return ("path pose {} frame_id must be world").format(index)

            position = pose_stamped.pose.position

            if not all(
                math.isfinite(value)
                for value in (
                    position.x,
                    position.y,
                )
            ):
                return ("path pose {} contains NaN or Inf").format(index)

        return None

    @staticmethod
    def _validate_odom(msg):
        # v0.2.0：
        #
        # header.frame_id = world
        # child_frame_id  = base

        if msg.header.frame_id != "world":
            return "odom frame_id must be world"

        if msg.child_frame_id != "base":
            return "odom child_frame_id must be base"

        position = msg.pose.pose.position

        if not all(
            math.isfinite(value)
            for value in (
                position.x,
                position.y,
            )
        ):
            return "odom position contains NaN or Inf"

        try:
            yaw_from_quaternion(msg.pose.pose.orientation)

        except ValueError as exc:
            return str(exc)

        return None

    # ============================================================
    # Target selection
    # ============================================================

    def _initial_target_index(self):
        """Avoid replaying nearby path-start points after replanning."""

        if self.odom is None or self.odom_error is not None:
            return 0

        robot = self.odom.pose.pose.position

        if not all(
            math.isfinite(value)
            for value in (
                robot.x,
                robot.y,
            )
        ):
            return 0

        for index, pose_stamped in enumerate(self.path):
            distance = self._distance_to_target(
                pose_stamped.pose,
                robot.x,
                robot.y,
            )

            if distance >= self.goal_tolerance:
                return index

        return len(self.path)

    # ============================================================
    # Cache invalidation
    # ============================================================

    def _invalidate_path(self):
        """Invalidate the currently cached Path."""

        self.path = []
        self.path_frame = ""
        self.path_time = None
        self.path_error = None
        self.target_index = 0

    def _invalidate_odom(self):
        """Invalidate the currently cached Odometry."""

        self.odom = None
        self.odom_time = None
        self.odom_error = None

    def _invalidate_all_inputs(self):
        """Invalidate all data from the old ROS-time generation."""

        self._invalidate_path()
        self._invalidate_odom()

        self.planning_status = None
        self.planning_status_time = None

        self.localization_status = None
        self.localization_status_time = None

    # ============================================================
    # Helpers
    # ============================================================

    @staticmethod
    def _distance_to_target(
        target_pose,
        robot_x,
        robot_y,
    ):
        dx = target_pose.position.x - robot_x

        dy = target_pose.position.y - robot_y

        distance = math.hypot(
            dx,
            dy,
        )

        if not math.isfinite(distance):
            raise ValueError("target distance is not finite")

        return distance

    @staticmethod
    def _age(stamp, now):
        return (now - stamp).to_sec()

    @staticmethod
    def _positive_param(
        name,
        default,
    ):
        value = float(
            rospy.get_param(
                name,
                default,
            )
        )

        if not math.isfinite(value) or value <= 0.0:
            raise ValueError("{} must be finite and greater than zero".format(name))

        return value


def main():
    rospy.init_node(
        "path_follower",
        log_level=rospy.INFO,
    )

    follower = PathFollower()

    rate = rospy.Rate(follower.control_frequency)

    while not rospy.is_shutdown():
        follower.step()
        rate.sleep()


if __name__ == "__main__":
    main()
