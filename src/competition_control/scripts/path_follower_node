#!/usr/bin/env python3
"""Safety-checked path follower for the competition control loop.

Formal inputs:
  /competition/path
  /competition/planning/status
  /competition/localization/odom
  /competition/localization/status

Outputs:
  /competition/raw_cmd_vel
  /competition/control/path_follower_status

This node never publishes /cmd_vel or /competition/control/status.
"""

from __future__ import annotations

import math
import threading

import geometry_msgs.msg
import nav_msgs.msg
import rospy

from competition_interfaces.msg import ModuleStatus


def clamp(value, low, high):
    return max(low, min(high, value))


def normalize_angle(angle):
    if not math.isfinite(angle):
        raise ValueError("angle is not finite")
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_from_quaternion(q):
    values = (q.x, q.y, q.z, q.w)
    if not all(math.isfinite(value) for value in values):
        raise ValueError("odom quaternion contains NaN or Inf")

    norm = math.sqrt(sum(value * value for value in values))
    if norm < 1.0e-9:
        raise ValueError("odom quaternion has zero norm")

    x, y, z, w = (value / norm for value in values)
    yaw = math.atan2(
        2.0 * (w * z + x * y),
        1.0 - 2.0 * (y * y + z * z),
    )

    if not math.isfinite(yaw):
        raise ValueError("computed odom yaw is not finite")
    return yaw


class PathFollower:
    """Path follower with fail-safe gating around all upstream inputs."""

    def __init__(self):
        # Callback threads and step() share all state below.
        self._lock = threading.RLock()

        # generation changes on safety-boundary transitions. state_version
        # changes on every accepted state mutation. step() snapshots both and
        # rechecks them before publishing a non-zero command.
        self._generation = 0
        self._state_version = 0
        self._last_ros_time = None

        # Minimum acceptable header stamps for the current generation.
        self._min_path_stamp = None
        self._min_odom_stamp = None
        self._min_planning_status_stamp = None
        self._min_localization_status_stamp = None

        self.path = []
        self.path_frame = ""
        self.path_received_at = None
        self.path_stamp = None
        self.path_error = None

        self.odom = None
        self.odom_received_at = None
        self.odom_stamp = None
        self.odom_error = None

        self.planning_status = None
        self.planning_status_received_at = None
        self.planning_status_stamp = None
        self.planning_status_error = None

        self.localization_status = None
        self.localization_status_received_at = None
        self.localization_status_stamp = None
        self.localization_status_error = None

        self.target_index = 0

        self.control_frequency = self._positive_param("~control_frequency", 10.0)
        self.max_linear = self._positive_param("~max_linear", 0.25)
        self.max_angular = self._positive_param("~max_angular", 0.8)
        self.goal_tolerance = self._positive_param("~goal_tolerance", 0.2)

        self.path_timeout = rospy.Duration(
            self._positive_param("~path_timeout", 5.0)
        )
        self.odom_timeout = rospy.Duration(
            self._positive_param("~odom_timeout", 1.0)
        )
        self.planning_status_timeout = rospy.Duration(
            self._positive_param("~planning_status_timeout", 1.0)
        )
        self.localization_status_timeout = rospy.Duration(
            self._positive_param("~localization_status_timeout", 1.0)
        )
        self.max_future_stamp_skew = self._positive_param(
            "~max_future_stamp_skew", 0.2
        )

        self.raw_vel_pub = rospy.Publisher(
            "/competition/raw_cmd_vel",
            geometry_msgs.msg.Twist,
            queue_size=1,
        )
        self.status_pub = rospy.Publisher(
            "/competition/control/path_follower_status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )

        rospy.Subscriber(
            "/competition/path",
            nav_msgs.msg.Path,
            self.on_path,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/planning/status",
            ModuleStatus,
            self.on_planning_status,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/localization/odom",
            nav_msgs.msg.Odometry,
            self.on_odom,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self.on_localization_status,
            queue_size=1,
        )

    # ------------------------------------------------------------------
    # Callbacks
    # ------------------------------------------------------------------

    def on_path(self, msg):
        """Atomically replace/cancel the current path."""
        now = rospy.Time.now()

        with self._lock:
            self._observe_ros_time_locked(now)

            # Any new Path replaces the old cached Path atomically.
            self._invalidate_path_locked()
            self._state_version += 1

            # The top-level Path Header is validated even for an empty Path.
            # An invalid cancellation message still stops the robot, but is
            # reported as invalid input rather than a valid cancellation.
            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.path_timeout,
                self._min_path_stamp,
                "path",
            )
            path_error = self._validate_path(msg)
            error = stamp_error or path_error

            if error is not None:
                self._generation += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    now.to_sec(),
                )
                self.path_error = error
                self.publish_stop(ModuleStatus.FAILED, error)
                return

            if not msg.poses:
                self._generation += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    self._safe_stamp_sec(msg.header.stamp),
                )
                self.publish_stop(
                    ModuleStatus.STARTING,
                    "empty /competition/path received; previous path cancelled",
                )
                return

            self.path = list(msg.poses)
            self.path_frame = msg.header.frame_id
            self.path_received_at = now
            self.path_stamp = msg.header.stamp
            self.path_error = None
            self.target_index = self._initial_target_index_locked()

    def on_planning_status(self, msg):
        now = rospy.Time.now()

        with self._lock:
            self._observe_ros_time_locked(now)

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.planning_status_timeout,
                self._min_planning_status_stamp,
                "planning status",
            )
            if stamp_error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_planning_status_stamp = self._max_stamp(
                    self._min_planning_status_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_planning_status_locked()
                self._invalidate_path_locked()
                self.planning_status_error = stamp_error
                self.publish_stop(ModuleStatus.FAILED, stamp_error)
                return

            previous = self.planning_status
            entering_invalid = (
                previous is None
                or self.planning_status_error is not None
                or bool(previous.valid)
            )

            self.planning_status = msg
            self.planning_status_received_at = now
            self.planning_status_stamp = msg.header.stamp
            self.planning_status_error = None
            self._state_version += 1

            if not msg.valid:
                if entering_invalid:
                    self._generation += 1
                    cutoff = self._safe_stamp_sec(msg.header.stamp)
                    self._min_planning_status_stamp = self._max_stamp(
                        self._min_planning_status_stamp,
                        cutoff,
                    )
                    self._min_path_stamp = self._max_stamp(
                        self._min_path_stamp,
                        cutoff,
                    )
                    self._invalidate_path_locked()

                detail = msg.detail or "planning status invalid"
                self.publish_stop(
                    ModuleStatus.BLOCKED,
                    "planning invalid: {}".format(detail),
                )

    def on_odom(self, msg):
        now = rospy.Time.now()

        with self._lock:
            self._observe_ros_time_locked(now)

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.odom_timeout,
                self._min_odom_stamp,
                "odom",
            )
            odom_error = self._validate_odom(msg)
            error = stamp_error or odom_error

            if error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_odom_stamp = self._max_stamp(
                    self._min_odom_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_odom_locked()
                self._invalidate_path_locked()
                self.odom_error = error
                self.publish_stop(ModuleStatus.FAILED, error)
                return

            self.odom = msg
            self.odom_received_at = now
            self.odom_stamp = msg.header.stamp
            self.odom_error = None
            self._state_version += 1

    def on_localization_status(self, msg):
        now = rospy.Time.now()

        with self._lock:
            self._observe_ros_time_locked(now)

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.localization_status_timeout,
                self._min_localization_status_stamp,
                "localization status",
            )
            if stamp_error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_localization_status_stamp = self._max_stamp(
                    self._min_localization_status_stamp,
                    cutoff,
                )
                self._min_odom_stamp = self._max_stamp(
                    self._min_odom_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_localization_status_locked()
                self._invalidate_odom_locked()
                self._invalidate_path_locked()
                self.localization_status_error = stamp_error
                self.publish_stop(ModuleStatus.FAILED, stamp_error)
                return

            previous = self.localization_status
            entering_invalid = (
                previous is None
                or self.localization_status_error is not None
                or bool(previous.valid)
            )

            self.localization_status = msg
            self.localization_status_received_at = now
            self.localization_status_stamp = msg.header.stamp
            self.localization_status_error = None
            self._state_version += 1

            if not msg.valid:
                if entering_invalid:
                    self._generation += 1
                    cutoff = self._safe_stamp_sec(msg.header.stamp)
                    self._min_localization_status_stamp = self._max_stamp(
                        self._min_localization_status_stamp,
                        cutoff,
                    )
                    self._min_odom_stamp = self._max_stamp(
                        self._min_odom_stamp,
                        cutoff,
                    )
                    self._min_path_stamp = self._max_stamp(
                        self._min_path_stamp,
                        cutoff,
                    )
                    self._invalidate_odom_locked()
                    self._invalidate_path_locked()

                detail = msg.detail or "localization status invalid"
                self.publish_stop(
                    ModuleStatus.BLOCKED,
                    "localization invalid: {}".format(detail),
                )

    # ------------------------------------------------------------------
    # Output helpers
    # ------------------------------------------------------------------

    def publish_status(self, state, valid, confidence, detail):
        msg = ModuleStatus()
        msg.header.stamp = rospy.Time.now()
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        self.status_pub.publish(msg)

    def publish_stop(
        self,
        state,
        detail,
        valid=False,
        confidence=0.0,
    ):
        self.raw_vel_pub.publish(geometry_msgs.msg.Twist())
        self.publish_status(state, valid, confidence, detail)

    # ------------------------------------------------------------------
    # Main control step
    # ------------------------------------------------------------------

    def step(self):
        now = rospy.Time.now()

        with self._lock:
            if self._observe_ros_time_locked(now):
                self.publish_stop(
                    ModuleStatus.TIMEOUT,
                    "ROS time moved backwards; old generation invalidated",
                )
                return

            stop = self._check_inputs_locked(now)
            if stop is not None:
                state, detail = stop
                self.publish_stop(state, detail)
                return

            # Stable snapshot for this control computation.
            snapshot_path = list(self.path)
            snapshot_odom = self.odom
            snapshot_target_index = self.target_index
            snapshot_generation = self._generation
            snapshot_version = self._state_version

        # Do not hold the lock during math; callbacks remain responsive.
        try:
            cmd, new_target_index, finished = self._compute_follow_snapshot(
                snapshot_path,
                snapshot_odom,
                snapshot_target_index,
            )
        except ValueError as exc:
            with self._lock:
                # If state changed while computing, an upstream callback owns
                # the newest safety decision; never overwrite it.
                if (
                    snapshot_generation != self._generation
                    or snapshot_version != self._state_version
                ):
                    return

                now = rospy.Time.now()
                if self._observe_ros_time_locked(now):
                    self.publish_stop(
                        ModuleStatus.TIMEOUT,
                        "ROS time moved backwards during control step",
                    )
                    return

                self._generation += 1
                self._state_version += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    now.to_sec(),
                )
                self._invalidate_path_locked()
                self.path_error = str(exc)
                self.publish_stop(ModuleStatus.FAILED, str(exc))
            return

        with self._lock:
            now_after_compute = rospy.Time.now()

            if self._observe_ros_time_locked(now_after_compute):
                self.publish_stop(
                    ModuleStatus.TIMEOUT,
                    "ROS time moved backwards during control step",
                )
                return

            # Blocker fix: an invalid/timeout/new-data callback that happened
            # during the computation changes generation/version. In that case
            # the old control result is discarded and can never publish a
            # stale non-zero command after the callback's safety decision.
            if (
                snapshot_generation != self._generation
                or snapshot_version != self._state_version
            ):
                return

            stop = self._check_inputs_locked(now_after_compute)
            if stop is not None:
                state, detail = stop
                self.publish_stop(state, detail)
                return

            self.target_index = new_target_index

            if finished:
                self.publish_stop(
                    ModuleStatus.SUCCEEDED,
                    "path finished",
                    valid=True,
                    confidence=1.0,
                )
                return

            self.raw_vel_pub.publish(cmd)
            self.publish_status(
                ModuleStatus.RUNNING,
                True,
                0.6,
                "following waypoint {}/{}".format(
                    self.target_index + 1,
                    len(self.path),
                ),
            )

    def _check_inputs_locked(self, now):
        # Planning gate.
        if self.planning_status_error is not None:
            return ModuleStatus.FAILED, self.planning_status_error

        if self.planning_status is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/planning/status",
            )

        if self._is_expired(
            self.planning_status_received_at,
            self.planning_status_stamp,
            now,
            self.planning_status_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_planning_status_stamp = self._max_stamp(
                self._min_planning_status_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_planning_status_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "planning status timeout, stop"

        if not self.planning_status.valid:
            detail = self.planning_status.detail or "planning status invalid"
            return ModuleStatus.BLOCKED, "planning invalid: {}".format(detail)

        # Localization gate.
        if self.localization_status_error is not None:
            return ModuleStatus.FAILED, self.localization_status_error

        if self.localization_status is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/localization/status",
            )

        if self._is_expired(
            self.localization_status_received_at,
            self.localization_status_stamp,
            now,
            self.localization_status_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_localization_status_stamp = self._max_stamp(
                self._min_localization_status_stamp,
                cutoff,
            )
            self._min_odom_stamp = self._max_stamp(
                self._min_odom_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_localization_status_locked()
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "localization status timeout, stop"

        if not self.localization_status.valid:
            detail = (
                self.localization_status.detail
                or "localization status invalid"
            )
            return (
                ModuleStatus.BLOCKED,
                "localization invalid: {}".format(detail),
            )

        # Data errors are checked before missing-data messages so an invalid
        # Odom is not hidden by the Path invalidation it triggers.
        if self.odom_error is not None:
            return ModuleStatus.FAILED, self.odom_error

        if self.path_error is not None:
            return ModuleStatus.FAILED, self.path_error

        if not self.path:
            return ModuleStatus.STARTING, "waiting for /competition/path"

        if self._is_expired(
            self.path_received_at,
            self.path_stamp,
            now,
            self.path_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                now.to_sec(),
            )
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "path timeout, stop"

        if self.odom is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/localization/odom",
            )

        if self._is_expired(
            self.odom_received_at,
            self.odom_stamp,
            now,
            self.odom_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_odom_stamp = self._max_stamp(
                self._min_odom_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "odom timeout, stop"

        # Final defensive frame checks.
        if self.path_frame != "world":
            self._generation += 1
            self._state_version += 1
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "path frame_id must be world"

        if self.odom.header.frame_id != "world":
            self._generation += 1
            self._state_version += 1
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "odom frame_id must be world"

        if self.odom.child_frame_id != "base":
            self._generation += 1
            self._state_version += 1
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "odom child_frame_id must be base"

        return None

    # ------------------------------------------------------------------
    # Pure control calculation on a stable snapshot
    # ------------------------------------------------------------------

    def _compute_follow_snapshot(self, path, odom, target_index):
        robot_x = odom.pose.pose.position.x
        robot_y = odom.pose.pose.position.y

        if not all(math.isfinite(value) for value in (robot_x, robot_y)):
            raise ValueError("odom position contains NaN or Inf")

        robot_yaw = yaw_from_quaternion(odom.pose.pose.orientation)

        while target_index < len(path):
            distance = self._distance_to_target(
                path[target_index].pose,
                robot_x,
                robot_y,
            )
            if distance >= self.goal_tolerance:
                break
            target_index += 1

        if target_index >= len(path):
            return geometry_msgs.msg.Twist(), target_index, True

        target_pose = path[target_index].pose
        dx = target_pose.position.x - robot_x
        dy = target_pose.position.y - robot_y

        distance = math.hypot(dx, dy)
        target_yaw = math.atan2(dy, dx)
        yaw_error = normalize_angle(target_yaw - robot_yaw)

        if not all(
            math.isfinite(value)
            for value in (distance, target_yaw, yaw_error)
        ):
            raise ValueError(
                "path-following calculation produced NaN or Inf"
            )

        cmd = geometry_msgs.msg.Twist()
        cmd.angular.z = clamp(
            1.5 * yaw_error,
            -self.max_angular,
            self.max_angular,
        )

        if abs(yaw_error) < 0.8:
            cmd.linear.x = clamp(
                0.6 * distance,
                0.0,
                self.max_linear,
            )

        return cmd, target_index, False

    # ------------------------------------------------------------------
    # Input validation
    # ------------------------------------------------------------------

    @staticmethod
    def _validate_path(msg):
        if not msg.poses:
            return None

        if msg.header.frame_id != "world":
            return "path frame_id must be world"

        for index, pose_stamped in enumerate(msg.poses):
            if pose_stamped.header.frame_id != "world":
                return "path pose {} frame_id must be world".format(index)

            position = pose_stamped.pose.position
            if not all(
                math.isfinite(value)
                for value in (position.x, position.y)
            ):
                return "path pose {} contains NaN or Inf".format(index)

        return None

    @staticmethod
    def _validate_odom(msg):
        if msg.header.frame_id != "world":
            return "odom frame_id must be world"

        if msg.child_frame_id != "base":
            return "odom child_frame_id must be base"

        position = msg.pose.pose.position
        if not all(
            math.isfinite(value)
            for value in (position.x, position.y)
        ):
            return "odom position contains NaN or Inf"

        try:
            yaw_from_quaternion(msg.pose.pose.orientation)
        except ValueError as exc:
            return str(exc)

        return None

    def _validate_message_stamp(
        self,
        stamp,
        now,
        max_age,
        min_stamp,
        label,
    ):
        stamp_sec = self._safe_stamp_sec(stamp)
        now_sec = now.to_sec()

        if (
            stamp_sec is None
            or not math.isfinite(stamp_sec)
            or stamp_sec <= 0.0
        ):
            return "{} header.stamp must be non-zero and finite".format(label)

        if (
            min_stamp is not None
            and stamp_sec + 1.0e-9 < min_stamp
        ):
            return "{} header.stamp belongs to an old generation".format(label)

        age = now_sec - stamp_sec

        if age > max_age.to_sec():
            return "{} header.stamp is stale".format(label)

        if age < -self.max_future_stamp_skew:
            return "{} header.stamp is too far in the future".format(label)

        return None

    @staticmethod
    def _is_expired(received_at, message_stamp, now, timeout):
        if received_at is None or message_stamp is None:
            return True

        receive_age = (now - received_at).to_sec()
        message_age = (now - message_stamp).to_sec()

        return (
            receive_age > timeout.to_sec()
            or message_age > timeout.to_sec()
        )

    # ------------------------------------------------------------------
    # ROS time / generation handling
    # ------------------------------------------------------------------

    def _observe_ros_time_locked(self, now):
        now_sec = now.to_sec()

        if (
            self._last_ros_time is not None
            and now_sec + 1.0e-9 < self._last_ros_time
        ):
            self._generation += 1
            self._state_version += 1

            self._invalidate_all_inputs_locked()

            # Anything stamped before the new ROS epoch boundary is old.
            self._min_path_stamp = now_sec
            self._min_odom_stamp = now_sec
            self._min_planning_status_stamp = now_sec
            self._min_localization_status_stamp = now_sec

            self._last_ros_time = now_sec
            return True

        self._last_ros_time = now_sec
        return False

    @staticmethod
    def _safe_stamp_sec(stamp):
        if stamp is None:
            return None
        try:
            value = float(stamp.to_sec())
        except (AttributeError, TypeError, ValueError):
            return None
        if not math.isfinite(value):
            return None
        return value

    @staticmethod
    def _max_stamp(current, candidate):
        if candidate is None:
            return current
        if current is None:
            return candidate
        return max(current, candidate)

    # ------------------------------------------------------------------
    # State invalidation helpers (caller holds _lock)
    # ------------------------------------------------------------------

    def _invalidate_path_locked(self):
        self.path = []
        self.path_frame = ""
        self.path_received_at = None
        self.path_stamp = None
        self.path_error = None
        self.target_index = 0

    def _invalidate_odom_locked(self):
        self.odom = None
        self.odom_received_at = None
        self.odom_stamp = None
        self.odom_error = None

    def _invalidate_planning_status_locked(self):
        self.planning_status = None
        self.planning_status_received_at = None
        self.planning_status_stamp = None
        self.planning_status_error = None

    def _invalidate_localization_status_locked(self):
        self.localization_status = None
        self.localization_status_received_at = None
        self.localization_status_stamp = None
        self.localization_status_error = None

    def _invalidate_all_inputs_locked(self):
        self._invalidate_path_locked()
        self._invalidate_odom_locked()
        self._invalidate_planning_status_locked()
        self._invalidate_localization_status_locked()

    def _initial_target_index_locked(self):
        if self.odom is None or self.odom_error is not None:
            return 0

        robot = self.odom.pose.pose.position
        if not all(
            math.isfinite(value)
            for value in (robot.x, robot.y)
        ):
            return 0

        for index, pose_stamped in enumerate(self.path):
            distance = self._distance_to_target(
                pose_stamped.pose,
                robot.x,
                robot.y,
            )
            if distance >= self.goal_tolerance:
                return index

        return len(self.path)

    @staticmethod
    def _distance_to_target(target_pose, robot_x, robot_y):
        distance = math.hypot(
            target_pose.position.x - robot_x,
            target_pose.position.y - robot_y,
        )

        if not math.isfinite(distance):
            raise ValueError("target distance is not finite")

        return distance

    @staticmethod
    def _positive_param(name, default):
        value = float(rospy.get_param(name, default))

        if not math.isfinite(value) or value <= 0.0:
            raise ValueError(
                "{} must be finite and greater than zero".format(name)
            )

        return value


def main():
    rospy.init_node("path_follower", log_level=rospy.INFO)
    follower = PathFollower()
    rate = rospy.Rate(follower.control_frequency, reset=True)

    while not rospy.is_shutdown():
        follower.step()
        rate.sleep()


if __name__ == "__main__":
    main()
