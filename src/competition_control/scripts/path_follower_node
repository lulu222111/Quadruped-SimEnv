#!/usr/bin/env python3
"""Minimal path follower for the competition control M0 closure.

Subscribes:
  /competition/path
  /competition/localization/odom

Publishes:
  /competition/raw_cmd_vel
  /competition/control/status

Never publishes /cmd_vel directly.
"""

from __future__ import annotations

import math

import geometry_msgs.msg
import nav_msgs.msg
import rospy

from competition_interfaces.msg import ModuleStatus


def clamp(value, low, high):
    return max(low, min(high, value))


def normalize_angle(angle):
    while angle > math.pi:
        angle -= 2.0 * math.pi
    while angle < -math.pi:
        angle += 2.0 * math.pi
    return angle


def yaw_from_quaternion(q):
    siny_cosp = 2.0 * (q.w * q.z + q.x * q.y)
    cosy_cosp = 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    return math.atan2(siny_cosp, cosy_cosp)


class PathFollower:
    def __init__(self):
        self.path = []
        self.path_time = None
        self.odom = None
        self.odom_time = None
        self.target_index = 0

        self.max_linear = rospy.get_param("~max_linear", 0.25)
        self.max_angular = rospy.get_param("~max_angular", 0.8)
        self.goal_tolerance = rospy.get_param("~goal_tolerance", 0.2)
        self.path_timeout = rospy.Duration(rospy.get_param("~path_timeout", 5.0))
        self.odom_timeout = rospy.Duration(rospy.get_param("~odom_timeout", 1.0))

        self.raw_vel_pub = rospy.Publisher(
            "/competition/raw_cmd_vel", geometry_msgs.msg.Twist, queue_size=1
        )
        self.status_pub = rospy.Publisher(
            "/competition/control/status", ModuleStatus, queue_size=10, latch=True
        )

        rospy.Subscriber(
            "/competition/path", nav_msgs.msg.Path, self.on_path, queue_size=1
        )
        # Fix: official localization odom, not /odom.
        rospy.Subscriber(
            "/competition/localization/odom",
            nav_msgs.msg.Odometry,
            self.on_odom,
            queue_size=1,
        )

    # def on_path(self, msg):
    #     self.path = list(msg.poses)
    #     self.path_time = rospy.Time.now()
    #     self.target_index = 0

    # def on_odom(self, msg):
    #     self.odom = msg
    #     self.odom_time = rospy.Time.now()

    def on_path(self, msg):
        self.path = list(msg.poses)
        self.path_time = rospy.Time.now()
        self.target_index = 0
        rospy.loginfo("path received: %d poses", len(self.path))

    def on_odom(self, msg):
        self.odom = msg
        self.odom_time = rospy.Time.now()
        rospy.loginfo_throttle(2.0, "odom received")

    def publish_status(self, state, valid, confidence, detail):
        msg = ModuleStatus()
        msg.header.stamp = rospy.Time.now()
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        self.status_pub.publish(msg)

    def publish_stop(self, detail):
        self.raw_vel_pub.publish(geometry_msgs.msg.Twist())
        self.publish_status(ModuleStatus.STARTING, False, 0.0, detail)

    def step(self):
        now = rospy.Time.now()

        if not self.path:
            self.publish_stop("waiting for /competition/path")
            return

        if self.path_time is None or now - self.path_time > self.path_timeout:
            self.publish_stop("path timeout, stop")
            return

        if self.odom is None:
            self.publish_stop("waiting for /competition/localization/odom")
            return

        if self.odom_time is None or now - self.odom_time > self.odom_timeout:
            self.publish_stop("odom timeout, stop")
            return

        odom_pose = self.odom.pose.pose
        robot_x = odom_pose.position.x
        robot_y = odom_pose.position.y
        robot_yaw = yaw_from_quaternion(odom_pose.orientation)

        while self.target_index < len(self.path):
            target_pose = self.path[self.target_index].pose
            dx = target_pose.position.x - robot_x
            dy = target_pose.position.y - robot_y
            distance = math.hypot(dx, dy)
            if distance >= self.goal_tolerance:
                break
            self.target_index += 1

        if self.target_index >= len(self.path):
            self.raw_vel_pub.publish(geometry_msgs.msg.Twist())
            self.publish_status(
                getattr(ModuleStatus, "FINISHED", ModuleStatus.STARTING),
                True,
                1.0,
                "path finished",
            )
            return

        target_pose = self.path[self.target_index].pose
        dx = target_pose.position.x - robot_x
        dy = target_pose.position.y - robot_y
        distance = math.hypot(dx, dy)

        target_yaw = math.atan2(dy, dx)
        yaw_error = normalize_angle(target_yaw - robot_yaw)

        cmd = geometry_msgs.msg.Twist()
        cmd.angular.z = clamp(1.5 * yaw_error, -self.max_angular, self.max_angular)
        if abs(yaw_error) < 0.8:
            cmd.linear.x = clamp(0.6 * distance, 0.0, self.max_linear)
        else:
            cmd.linear.x = 0.0

        self.raw_vel_pub.publish(cmd)
        self.publish_status(
            getattr(ModuleStatus, "RUNNING", ModuleStatus.STARTING),
            True,
            0.6,
            "following waypoint {}/{}".format(self.target_index + 1, len(self.path)),
        )


def main():
    rospy.init_node("path_follower", log_level=rospy.INFO)
    follower = PathFollower()

    rate = rospy.Rate(10)
    while not rospy.is_shutdown():
        follower.step()
        rate.sleep()


if __name__ == "__main__":
    main()