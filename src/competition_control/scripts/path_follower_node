#!/usr/bin/env python3
# =============================================================================
# 模块说明（中文）：path_follower_node —— 带安全检查的路径跟随器
#
# 职责：读取 /competition/path 与上游状态、定位里程计，算出比例转向 + 前进速度，
#       发布到 /competition/raw_cmd_vel（注意：本节点永不直接发布 /cmd_vel，
#       也永不发布 control/status，唯一出口是 cmd_vel_guard）。
# 为什么这样做：运动安全采用"单一 motion owner + 网关"结构——跟随器只提出
#       期望速度，真正的下发权与限幅/急停判定在 cmd_vel_guard，便于集中审计。
# 关键设计（为什么不能省）：
#   1) 锁外计算、锁内复核：控制量在锁外算完，提交前重新比对 generation 与
#      state_version；若期间有回调改写了输入，旧结果直接丢弃，绝不发布过期速度。
#   2) 输入优先级门：planning 状态 -> localization 状态 -> odom/path，任一处失败
#      立即 publish_stop（fail-safe），并校验 world/base 帧名。
#   3) 卡死检测：同时看"指令积分进展"和"绝对位移"，两者都停滞才判卡死，
#      触发一次性 stuck 上报与短暂后退回退，避免把正常慢速误判成卡死。
# 结构导航：PathFollower（行 60 起）→ 回调（行 247-493）→ step（行 517-633，
#       含 generation/state_version 复核）→ _check_inputs_locked（行 635-791）
#       → _track_stuck_locked（行 797-902，双判据卡死）→ _compute_follow_snapshot
#       （行 939-1013）→ 输入校验助手（行 1014-1191）→ 路径几何（行 1193-1289）。
# 输入：/competition/path、/competition/planning/status、
#       /competition/localization/odom 与 status
# 输出：/competition/raw_cmd_vel、/competition/control/path_follower_status、
#       /competition/planning/stuck 事件
# =============================================================================
"""Safety-checked path follower for the competition control loop.

Formal inputs:
  /competition/path
  /competition/planning/status
  /competition/localization/odom
  /competition/localization/status

Outputs:
  /competition/raw_cmd_vel
  /competition/control/path_follower_status

This node never publishes /cmd_vel or /competition/control/status.
"""

from __future__ import annotations

import math
import threading

import geometry_msgs.msg
import nav_msgs.msg
import rospy
import std_msgs.msg

from competition_interfaces.msg import ModuleStatus


def clamp(value, low, high):
    return max(low, min(high, value))


def normalize_angle(angle):
    if not math.isfinite(angle):
        raise ValueError("angle is not finite")
    return math.atan2(math.sin(angle), math.cos(angle))


def yaw_from_quaternion(q):
    values = (q.x, q.y, q.z, q.w)
    if not all(math.isfinite(value) for value in values):
        raise ValueError("odom quaternion contains NaN or Inf")

    norm = math.sqrt(sum(value * value for value in values))
    if norm < 1.0e-9:
        raise ValueError("odom quaternion has zero norm")

    x, y, z, w = (value / norm for value in values)
    yaw = math.atan2(
        2.0 * (w * z + x * y),
        1.0 - 2.0 * (y * y + z * z),
    )

    if not math.isfinite(yaw):
        raise ValueError("computed odom yaw is not finite")
    return yaw


class PathFollower:
    """Path follower with fail-safe gating around all upstream inputs."""

    def __init__(self):
        # Callback threads and step() share all state below.
        self._lock = threading.RLock()

        # generation changes on safety-boundary transitions. state_version
        # changes on every accepted state mutation. step() snapshots both and
        # rechecks them before publishing a non-zero command.
        self._generation = 0
        self._state_version = 0
        self._last_ros_time = None

        # Minimum acceptable header stamps for the current generation.
        self._min_path_stamp = None
        self._min_odom_stamp = None
        self._min_planning_status_stamp = None
        self._min_localization_status_stamp = None

        self.path = []
        self.path_frame = ""
        self.path_received_at = None
        self.path_stamp = None
        self.path_error = None

        self.odom = None
        self.odom_received_at = None
        self.odom_stamp = None
        self.odom_error = None

        self.planning_status = None
        self.planning_status_received_at = None
        self.planning_status_stamp = None
        self.planning_status_error = None

        self.localization_status = None
        self.localization_status_received_at = None
        self.localization_status_stamp = None
        self.localization_status_error = None

        self.target_index = 0

        self.control_frequency = self._positive_param("~control_frequency", 10.0)
        self.max_linear = self._positive_param("~max_linear", 0.25)
        self.max_angular = self._positive_param("~max_angular", 0.8)
        self.goal_tolerance = self._positive_param("~goal_tolerance", 0.2)
        # A pair of consecutive same-position poses is an explicit
        # rotation-only waypoint used by Planning's bounded visual scan.  The
        # ordinary navigation path remains position-driven and does not use
        # this tolerance for its final pose.
        self.orientation_tolerance = self._positive_param(
            "~orientation_tolerance", 0.15
        )
        # Minimum forward speed commanded while actively driving to a
        # waypoint outside goal_tolerance.  The RL locomotion policy cannot
        # execute arbitrarily small speeds: below ~0.2 m/s it stands still,
        # which deadlocks the proportional 0.6*distance slowdown just outside
        # goal_tolerance (observed in RETURNING-FIX-R24: cmd=0.13 m/s, joints
        # frozen, waypoint never reached).  Floor the drive command at an
        # executable speed; 0.0 preserves the legacy unclamped behaviour.
        self.min_linear = self._nonnegative_param("~min_linear", 0.0)
        if self.min_linear > self.max_linear:
            self.min_linear = self.max_linear

        # Physical stuck detection (R25): the follower may keep commanding an
        # executable forward speed while the robot is wedged against a wall
        # that the drifted map marks as free.  When we have been driving
        # (non-zero commanded linear speed) for stuck_duration_sec while the
        # measured position moved less than stuck_progress_epsilon, publish a
        # one-shot notice on /competition/planning/stuck so the planner can
        # drop a committed RETURNING route and replan once.  The follower
        # itself does not change behaviour on stuck; this is an advisory
        # signal only.  Disabled by default (stuck_duration_sec=0).
        self.stuck_duration_sec = self._nonnegative_param(
            "~stuck_duration_sec", 0.0
        )
        self.stuck_progress_epsilon = self._positive_param(
            "~stuck_progress_epsilon", 0.05
        )
        # Stuck backoff (R27 exploration-wedge recovery): when the robot has
        # been driving with no measured progress, briefly command a backward
        # velocity to physically break the wedge, then resume normal path
        # following.  Works in every mission phase (the R26 planner re-commit
        # only covers RETURNING; exploration had no recovery at all).  The RL
        # policy is trained with vx in [-0.5, 0.5] (commands_scale=2.0), so a
        # small negative vx is in distribution.  Bound repeats per path so a
        # permanently-blocked robot does not oscillate forever.
        self.stuck_backoff_linear = self._nonnegative_param(
            "~stuck_backoff_linear", 0.15
        )
        self.stuck_backoff_duration = self._positive_param(
            "~stuck_backoff_duration", 3.0
        )
        self.stuck_backoff_max = int(
            self._positive_param("~stuck_backoff_max", 3)
        )
        # Command-relative progress gate (run-f1 livelock).  The absolute
        # epsilon above cannot see a robot that keeps creeping just above it:
        # run-f1 commanded 0.25 m/s while the robot achieved 0.006-0.010 m/s
        # (2-4 % of command) for 281 sim s, and every 8 s window moved
        # 0.056-0.083 m -- just over the 0.05 m epsilon -- so the window reset
        # forever and no backoff, stuck signal or planner skip ever fired.
        # This second criterion compares measured progress against the
        # translational command actually integrated over the same window, so
        # it is scale free.  Inactive while stuck_duration_sec is 0.
        self.stuck_progress_ratio = self._positive_param(
            "~stuck_progress_ratio", 0.2
        )
        if self.stuck_progress_ratio > 1.0:
            raise ValueError("~stuck_progress_ratio must not exceed 1.0")
        self.stuck_expected_progress_min = self._nonnegative_param(
            "~stuck_expected_progress_min", 0.10
        )
        self._stuck_expected_progress = 0.0
        self._stuck_last_command_time = None
        self._stuck_start_time = None
        self._stuck_start_position = None
        self._stuck_notified = False
        self._recovery_until = None
        self._stuck_backoff_count = 0
        self.stuck_pub = None
        if self.stuck_duration_sec > 0.0:
            self.stuck_pub = rospy.Publisher(
                "/competition/planning/stuck",
                std_msgs.msg.Bool,
                queue_size=1,
                latch=True,
            )

        self.path_timeout = rospy.Duration(
            self._positive_param("~path_timeout", 5.0)
        )
        self.odom_timeout = rospy.Duration(
            self._positive_param("~odom_timeout", 1.0)
        )
        self.planning_status_timeout = rospy.Duration(
            self._positive_param("~planning_status_timeout", 3.0)
        )
        self.localization_status_timeout = rospy.Duration(
            self._positive_param("~localization_status_timeout", 1.0)
        )
        self.max_future_stamp_skew = self._positive_param(
            "~max_future_stamp_skew", 0.2
        )

        self.raw_vel_pub = rospy.Publisher(
            "/competition/raw_cmd_vel",
            geometry_msgs.msg.Twist,
            queue_size=1,
        )
        self.status_pub = rospy.Publisher(
            "/competition/control/path_follower_status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )

        rospy.Subscriber(
            "/competition/path",
            nav_msgs.msg.Path,
            self.on_path,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/planning/status",
            ModuleStatus,
            self.on_planning_status,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/localization/odom",
            nav_msgs.msg.Odometry,
            self.on_odom,
            queue_size=1,
        )
        rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self.on_localization_status,
            queue_size=1,
        )

    # ------------------------------------------------------------------
    # Callbacks
    # ------------------------------------------------------------------

    def on_path(self, msg):
        """Atomically replace/cancel the current path.

        A planner may refresh an unchanged valid route to keep its header
        fresh.  Treat that as a heartbeat, not a new route: retaining the
        current waypoint progress prevents a long return path from repeatedly
        snapping the follower back to its first waypoint.
        """
        with self._lock:
            now, _ = self._now_locked()

            # The top-level Path Header is validated even for an empty Path.
            # An invalid cancellation message still stops the robot, but is
            # reported as invalid input rather than a valid cancellation.
            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.path_timeout,
                self._min_path_stamp,
                "path",
            )
            path_error = self._validate_path(msg)
            error = stamp_error or path_error

            if error is not None:
                self._invalidate_path_locked()
                self._state_version += 1
                self._generation += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    now.to_sec(),
                )
                self.path_error = error
                self.publish_stop(ModuleStatus.FAILED, error)
                return

            if not msg.poses:
                self._invalidate_path_locked()
                self._state_version += 1
                self._generation += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    self._safe_stamp_sec(msg.header.stamp),
                )
                self.publish_stop(
                    ModuleStatus.STARTING,
                    "empty /competition/path received; previous path cancelled",
                )
                return

            if self._same_path_geometry_locked(msg):
                # Geometry and frame are exactly the current route.  Only
                # refresh its liveness; target_index remains monotonic.
                self.path_received_at = now
                self.path_stamp = msg.header.stamp
                self.path_error = None
                self._state_version += 1
                return

            # A geometrically new Path replaces the old cached Path
            # atomically and must select a new initial target.
            self._invalidate_path_locked()
            self._state_version += 1
            self.path = list(msg.poses)
            self.path_frame = msg.header.frame_id
            self.path_received_at = now
            self.path_stamp = msg.header.stamp
            self.path_error = None
            self.target_index = self._initial_target_index_locked()
            self._reset_stuck_locked()

    def on_planning_status(self, msg):
        with self._lock:
            now, _ = self._now_locked()

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.planning_status_timeout,
                self._min_planning_status_stamp,
                "planning status",
            )
            if stamp_error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_planning_status_stamp = self._max_stamp(
                    self._min_planning_status_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_planning_status_locked()
                self._invalidate_path_locked()
                self.planning_status_error = stamp_error
                self.publish_stop(ModuleStatus.FAILED, stamp_error)
                return

            previous = self.planning_status
            entering_invalid = (
                previous is None
                or self.planning_status_error is not None
                or bool(previous.valid)
            )

            self.planning_status = msg
            self.planning_status_received_at = now
            self.planning_status_stamp = msg.header.stamp
            self.planning_status_error = None
            self._state_version += 1

            if not msg.valid:
                if entering_invalid:
                    self._generation += 1
                    cutoff = self._safe_stamp_sec(msg.header.stamp)
                    self._min_planning_status_stamp = self._max_stamp(
                        self._min_planning_status_stamp,
                        cutoff,
                    )
                    self._min_path_stamp = self._max_stamp(
                        self._min_path_stamp,
                        cutoff,
                    )
                    self._invalidate_path_locked()

                detail = msg.detail or "planning status invalid"
                self.publish_stop(
                    ModuleStatus.BLOCKED,
                    "planning invalid: {}".format(detail),
                )

    def on_odom(self, msg):
        with self._lock:
            now, _ = self._now_locked()

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.odom_timeout,
                self._min_odom_stamp,
                "odom",
            )
            odom_error = self._validate_odom(msg)
            error = stamp_error or odom_error

            if error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_odom_stamp = self._max_stamp(
                    self._min_odom_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_odom_locked()
                self._invalidate_path_locked()
                self.odom_error = error
                self.publish_stop(ModuleStatus.FAILED, error)
                return

            self.odom = msg
            self.odom_received_at = now
            self.odom_stamp = msg.header.stamp
            self.odom_error = None
            self._state_version += 1

    def on_localization_status(self, msg):
        with self._lock:
            now, _ = self._now_locked()

            stamp_error = self._validate_message_stamp(
                msg.header.stamp,
                now,
                self.localization_status_timeout,
                self._min_localization_status_stamp,
                "localization status",
            )
            if stamp_error is not None:
                self._generation += 1
                self._state_version += 1
                cutoff = now.to_sec()
                self._min_localization_status_stamp = self._max_stamp(
                    self._min_localization_status_stamp,
                    cutoff,
                )
                self._min_odom_stamp = self._max_stamp(
                    self._min_odom_stamp,
                    cutoff,
                )
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    cutoff,
                )
                self._invalidate_localization_status_locked()
                self._invalidate_odom_locked()
                self._invalidate_path_locked()
                self.localization_status_error = stamp_error
                self.publish_stop(ModuleStatus.FAILED, stamp_error)
                return

            previous = self.localization_status
            entering_invalid = (
                previous is None
                or self.localization_status_error is not None
                or bool(previous.valid)
            )

            self.localization_status = msg
            self.localization_status_received_at = now
            self.localization_status_stamp = msg.header.stamp
            self.localization_status_error = None
            self._state_version += 1

            if not msg.valid:
                if entering_invalid:
                    self._generation += 1
                    cutoff = self._safe_stamp_sec(msg.header.stamp)
                    self._min_localization_status_stamp = self._max_stamp(
                        self._min_localization_status_stamp,
                        cutoff,
                    )
                    self._min_odom_stamp = self._max_stamp(
                        self._min_odom_stamp,
                        cutoff,
                    )
                    self._min_path_stamp = self._max_stamp(
                        self._min_path_stamp,
                        cutoff,
                    )
                    self._invalidate_odom_locked()
                    self._invalidate_path_locked()

                detail = msg.detail or "localization status invalid"
                self.publish_stop(
                    ModuleStatus.BLOCKED,
                    "localization invalid: {}".format(detail),
                )

    # ------------------------------------------------------------------
    # Output helpers
    # ------------------------------------------------------------------

    def publish_status(self, state, valid, confidence, detail):
        msg = ModuleStatus()
        msg.header.stamp = rospy.Time.now()
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        self.status_pub.publish(msg)

    def publish_stop(
        self,
        state,
        detail,
        valid=False,
        confidence=0.0,
    ):
        self.raw_vel_pub.publish(geometry_msgs.msg.Twist())
        self.publish_status(state, valid, confidence, detail)

    # ------------------------------------------------------------------
    # Main control step
    # ------------------------------------------------------------------

    def step(self):
        with self._lock:
            now, rolled_back = self._now_locked()
            if rolled_back:
                self.publish_stop(
                    ModuleStatus.TIMEOUT,
                    "ROS time moved backwards; old generation invalidated",
                )
                return

            stop = self._check_inputs_locked(now)
            if stop is not None:
                state, detail = stop
                self.publish_stop(state, detail)
                return

            # Stable snapshot for this control computation.
            snapshot_path = list(self.path)
            snapshot_odom = self.odom
            snapshot_target_index = self.target_index
            snapshot_generation = self._generation
            snapshot_version = self._state_version

        # Do not hold the lock during math; callbacks remain responsive.
        try:
            cmd, new_target_index, finished = self._compute_follow_snapshot(
                snapshot_path,
                snapshot_odom,
                snapshot_target_index,
            )
        except ValueError as exc:
            with self._lock:
                # If state changed while computing, an upstream callback owns
                # the newest safety decision; never overwrite it.
                if (
                    snapshot_generation != self._generation
                    or snapshot_version != self._state_version
                ):
                    return

                now, rolled_back = self._now_locked()
                if rolled_back:
                    self.publish_stop(
                        ModuleStatus.TIMEOUT,
                        "ROS time moved backwards during control step",
                    )
                    return

                self._generation += 1
                self._state_version += 1
                self._min_path_stamp = self._max_stamp(
                    self._min_path_stamp,
                    now.to_sec(),
                )
                self._invalidate_path_locked()
                self.path_error = str(exc)
                self.publish_stop(ModuleStatus.FAILED, str(exc))
            return

        with self._lock:
            now_after_compute, rolled_back = self._now_locked()

            if rolled_back:
                self.publish_stop(
                    ModuleStatus.TIMEOUT,
                    "ROS time moved backwards during control step",
                )
                return

            # Blocker fix: an invalid/timeout/new-data callback that happened
            # during the computation changes generation/version. In that case
            # the old control result is discarded and can never publish a
            # stale non-zero command after the callback's safety decision.
            if (
                snapshot_generation != self._generation
                or snapshot_version != self._state_version
            ):
                return

            stop = self._check_inputs_locked(now_after_compute)
            if stop is not None:
                state, detail = stop
                self.publish_stop(state, detail)
                return

            self.target_index = new_target_index

            if finished:
                self.publish_stop(
                    ModuleStatus.SUCCEEDED,
                    "path finished",
                    valid=True,
                    confidence=1.0,
                )
                return

            if self._recovery_active(now_after_compute):
                cmd = self._backoff_command()
            self.raw_vel_pub.publish(cmd)
            self._track_stuck_locked(cmd, snapshot_odom, now_after_compute)
            if self._recovery_active(now_after_compute):
                self.publish_status(
                    ModuleStatus.RUNNING,
                    True,
                    0.5,
                    "stuck recovery: backing up",
                )
            else:
                self.publish_status(
                    ModuleStatus.RUNNING,
                    True,
                    0.6,
                    "following waypoint {}/{}".format(
                        self.target_index + 1,
                        len(self.path),
                    ),
                )

    def _check_inputs_locked(self, now):
        # Planning gate.
        if self.planning_status_error is not None:
            return ModuleStatus.FAILED, self.planning_status_error

        if self.planning_status is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/planning/status",
            )

        if self._is_expired(
            self.planning_status_received_at,
            self.planning_status_stamp,
            now,
            self.planning_status_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_planning_status_stamp = self._max_stamp(
                self._min_planning_status_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_planning_status_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "planning status timeout, stop"

        if not self.planning_status.valid:
            detail = self.planning_status.detail or "planning status invalid"
            return ModuleStatus.BLOCKED, "planning invalid: {}".format(detail)

        # Localization gate.
        if self.localization_status_error is not None:
            return ModuleStatus.FAILED, self.localization_status_error

        if self.localization_status is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/localization/status",
            )

        if self._is_expired(
            self.localization_status_received_at,
            self.localization_status_stamp,
            now,
            self.localization_status_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_localization_status_stamp = self._max_stamp(
                self._min_localization_status_stamp,
                cutoff,
            )
            self._min_odom_stamp = self._max_stamp(
                self._min_odom_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_localization_status_locked()
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "localization status timeout, stop"

        if not self.localization_status.valid:
            detail = (
                self.localization_status.detail
                or "localization status invalid"
            )
            return (
                ModuleStatus.BLOCKED,
                "localization invalid: {}".format(detail),
            )

        # Data errors are checked before missing-data messages so an invalid
        # Odom is not hidden by the Path invalidation it triggers.
        if self.odom_error is not None:
            return ModuleStatus.FAILED, self.odom_error

        if self.path_error is not None:
            return ModuleStatus.FAILED, self.path_error

        if not self.path:
            return ModuleStatus.STARTING, "waiting for /competition/path"

        if self._is_expired(
            self.path_received_at,
            self.path_stamp,
            now,
            self.path_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                now.to_sec(),
            )
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "path timeout, stop"

        if self.odom is None:
            return (
                ModuleStatus.STARTING,
                "waiting for /competition/localization/odom",
            )

        if self._is_expired(
            self.odom_received_at,
            self.odom_stamp,
            now,
            self.odom_timeout,
        ):
            self._generation += 1
            self._state_version += 1
            cutoff = now.to_sec()
            self._min_odom_stamp = self._max_stamp(
                self._min_odom_stamp,
                cutoff,
            )
            self._min_path_stamp = self._max_stamp(
                self._min_path_stamp,
                cutoff,
            )
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.TIMEOUT, "odom timeout, stop"

        # Final defensive frame checks.
        if self.path_frame != "world":
            self._generation += 1
            self._state_version += 1
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "path frame_id must be world"

        if self.odom.header.frame_id != "world":
            self._generation += 1
            self._state_version += 1
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "odom frame_id must be world"

        if self.odom.child_frame_id != "base":
            self._generation += 1
            self._state_version += 1
            self._invalidate_odom_locked()
            self._invalidate_path_locked()
            return ModuleStatus.FAILED, "odom child_frame_id must be base"

        return None

    # ------------------------------------------------------------------
    # Physical stuck detection (advisory; does not change follower output)
    # ------------------------------------------------------------------

    def _track_stuck_locked(self, cmd, odom, now):
        """Detect commanded-motion-without-measured-motion (wall wedged).

        Only arms while we are actually driving (non-zero commanded linear
        speed on a valid, unfinished path).  If the measured position has not
        moved at least stuck_progress_epsilon after stuck_duration_sec of
        continuous driving, publish a latched notice so the planner can react
        (RETURNING re-commit), and start a short backward backoff to break the
        wedge physically.  The window resets after firing so a re-wedge after
        the backoff can trigger again (bounded by stuck_backoff_max).  Caller
        owns lock.
        """
        if self.stuck_duration_sec <= 0.0 or self.stuck_pub is None:
            return

        driving = (
            cmd is not None
            and abs(cmd.linear.x) > 0.0
            and self.path
        )
        if not driving:
            self._stuck_start_time = None
            self._stuck_start_position = None
            self._stuck_expected_progress = 0.0
            self._stuck_last_command_time = None
            return

        px = odom.pose.pose.position.x
        py = odom.pose.pose.position.y
        if not (math.isfinite(px) and math.isfinite(py)):
            return

        if self._stuck_start_time is None:
            self._stuck_start_time = now.to_sec()
            self._stuck_start_position = (px, py)
            self._stuck_expected_progress = 0.0
            self._stuck_last_command_time = now.to_sec()
            return

        # Integrate the translational command magnitude actually requested over
        # this window.  A zero command contributes zero expected progress, so
        # HOLD, intentional stops and pure in-place yaw turns never arm the
        # relative gate.
        dt = now.to_sec() - self._stuck_last_command_time
        if dt > 0.0:
            self._stuck_expected_progress += abs(cmd.linear.x) * dt
        self._stuck_last_command_time = now.to_sec()

        sx, sy = self._stuck_start_position
        moved = math.hypot(px - sx, py - sy)

        # Second, command-relative criterion.  Only meaningful once enough
        # translation has actually been requested.
        relative_progress = None
        if self._stuck_expected_progress >= self.stuck_expected_progress_min:
            relative_progress = moved / self._stuck_expected_progress
        creeping = (
            relative_progress is not None
            and relative_progress < self.stuck_progress_ratio
        )

        # Moved enough AND still tracking the command: reset the window.
        if moved >= self.stuck_progress_epsilon and not creeping:
            self._stuck_start_time = now.to_sec()
            self._stuck_start_position = (px, py)
            self._stuck_expected_progress = 0.0
            return

        # Stuck long enough: report once per path, then back off.
        if (now.to_sec() - self._stuck_start_time) < self.stuck_duration_sec:
            return

        if not self._stuck_notified:
            self._stuck_notified = True
            notice = std_msgs.msg.Bool()
            notice.data = True
            self.stuck_pub.publish(notice)
            rospy.logwarn(
                "path_follower: no measured progress for %.1f s while "
                "driving (moved %.3f m of %.3f m commanded = %.0f%%) — "
                "reporting stuck to planner",
                now.to_sec() - self._stuck_start_time,
                moved,
                self._stuck_expected_progress,
                100.0 * (relative_progress if relative_progress is not None
                         else 1.0),
            )

        # Physically break the wedge: command a short backward motion.
        if (
            self.stuck_backoff_linear > 0.0
            and self._stuck_backoff_count < self.stuck_backoff_max
        ):
            self._stuck_backoff_count += 1
            self._recovery_until = now.to_sec() + self.stuck_backoff_duration
            rospy.logwarn(
                "path_follower: stuck backoff #%d for %.1f s at %.2f m/s",
                self._stuck_backoff_count,
                self.stuck_backoff_duration,
                self.stuck_backoff_linear,
            )

        # Reset the window so a re-wedge after the backoff re-triggers.
        self._stuck_start_time = now.to_sec()
        self._stuck_start_position = (px, py)
        self._stuck_expected_progress = 0.0

    def _recovery_active(self, now):
        return (
            self._recovery_until is not None
            and now.to_sec() < self._recovery_until
        )

    def _backoff_command(self):
        cmd = geometry_msgs.msg.Twist()
        cmd.linear.x = -self.stuck_backoff_linear
        cmd.angular.z = 0.0
        return cmd

    def _reset_stuck_locked(self):
        """Re-arm stuck detection for a new path / cleared state.

        Caller owns lock.  Keeps the one-shot latch False until a fresh
        window accumulates on the new route; also clears any active backoff
        and the per-path backoff budget.
        """
        self._stuck_start_time = None
        self._stuck_start_position = None
        self._stuck_expected_progress = 0.0
        self._stuck_last_command_time = None
        self._stuck_notified = False
        self._recovery_until = None
        self._stuck_backoff_count = 0
        if self.stuck_pub is not None:
            cleared = std_msgs.msg.Bool()
            cleared.data = False
            self.stuck_pub.publish(cleared)

    # ------------------------------------------------------------------
    # Pure control calculation on a stable snapshot
    # ------------------------------------------------------------------

    def _compute_follow_snapshot(self, path, odom, target_index):
        robot_x = odom.pose.pose.position.x
        robot_y = odom.pose.pose.position.y

        if not all(math.isfinite(value) for value in (robot_x, robot_y)):
            raise ValueError("odom position contains NaN or Inf")

        robot_yaw = yaw_from_quaternion(odom.pose.pose.orientation)

        while target_index < len(path):
            target_pose = path[target_index].pose
            distance = self._distance_to_target(
                target_pose,
                robot_x,
                robot_y,
            )
            rotation_only = self._is_rotation_only_target(
                path,
                target_index,
            )
            if rotation_only:
                target_yaw = yaw_from_quaternion(target_pose.orientation)
                yaw_error = normalize_angle(target_yaw - robot_yaw)
                if abs(yaw_error) <= self.orientation_tolerance:
                    target_index += 1
                    continue
                break
            if distance >= self.goal_tolerance:
                break
            target_index += 1

        if target_index >= len(path):
            return geometry_msgs.msg.Twist(), target_index, True

        target_pose = path[target_index].pose
        dx = target_pose.position.x - robot_x
        dy = target_pose.position.y - robot_y

        distance = math.hypot(dx, dy)
        rotation_only = self._is_rotation_only_target(path, target_index)
        target_yaw = (
            yaw_from_quaternion(target_pose.orientation)
            if rotation_only
            else math.atan2(dy, dx)
        )
        yaw_error = normalize_angle(target_yaw - robot_yaw)

        if not all(
            math.isfinite(value)
            for value in (distance, target_yaw, yaw_error)
        ):
            raise ValueError(
                "path-following calculation produced NaN or Inf"
            )

        cmd = geometry_msgs.msg.Twist()
        cmd.angular.z = clamp(
            1.5 * yaw_error,
            -self.max_angular,
            self.max_angular,
        )

        if not rotation_only and abs(yaw_error) < 0.8:
            cmd.linear.x = clamp(
                0.6 * distance,
                self.min_linear,
                self.max_linear,
            )

        return cmd, target_index, False

    # ------------------------------------------------------------------
    # Input validation
    # ------------------------------------------------------------------

    @staticmethod
    def _validate_path(msg):
        if not msg.poses:
            return None

        if msg.header.frame_id != "world":
            return "path frame_id must be world"

        for index, pose_stamped in enumerate(msg.poses):
            if pose_stamped.header.frame_id != "world":
                return "path pose {} frame_id must be world".format(index)

            position = pose_stamped.pose.position
            if not all(
                math.isfinite(value)
                for value in (position.x, position.y)
            ):
                return "path pose {} contains NaN or Inf".format(index)

        return None

    @staticmethod
    def _validate_odom(msg):
        if msg.header.frame_id != "world":
            return "odom frame_id must be world"

        if msg.child_frame_id != "base":
            return "odom child_frame_id must be base"

        position = msg.pose.pose.position
        if not all(
            math.isfinite(value)
            for value in (position.x, position.y)
        ):
            return "odom position contains NaN or Inf"

        try:
            yaw_from_quaternion(msg.pose.pose.orientation)
        except ValueError as exc:
            return str(exc)

        return None

    def _validate_message_stamp(
        self,
        stamp,
        now,
        max_age,
        min_stamp,
        label,
    ):
        stamp_sec = self._safe_stamp_sec(stamp)
        now_sec = now.to_sec()

        if (
            stamp_sec is None
            or not math.isfinite(stamp_sec)
            or stamp_sec <= 0.0
        ):
            return "{} header.stamp must be non-zero and finite".format(label)

        if (
            min_stamp is not None
            and stamp_sec + 1.0e-9 < min_stamp
        ):
            return "{} header.stamp belongs to an old generation".format(label)

        age = now_sec - stamp_sec

        if age > max_age.to_sec():
            return "{} header.stamp is stale".format(label)

        if age < -self.max_future_stamp_skew:
            return "{} header.stamp is too far in the future".format(label)

        return None

    @staticmethod
    def _is_expired(received_at, message_stamp, now, timeout):
        if received_at is None or message_stamp is None:
            return True

        receive_age = (now - received_at).to_sec()
        message_age = (now - message_stamp).to_sec()

        return (
            receive_age > timeout.to_sec()
            or message_age > timeout.to_sec()
        )

    # ------------------------------------------------------------------
    # ROS time / generation handling
    # ------------------------------------------------------------------

    def _now_locked(self):
        """Read and observe ROS time inside the same lock critical section."""
        now = rospy.Time.now()
        return now, self._observe_ros_time_locked(now)

    def _observe_ros_time_locked(self, now):
        now_sec = now.to_sec()

        if (
            self._last_ros_time is not None
            and now_sec + 1.0e-9 < self._last_ros_time
        ):
            self._generation += 1
            self._state_version += 1

            self._invalidate_all_inputs_locked()

            # Anything stamped before the new ROS epoch boundary is old.
            self._min_path_stamp = now_sec
            self._min_odom_stamp = now_sec
            self._min_planning_status_stamp = now_sec
            self._min_localization_status_stamp = now_sec

            self._last_ros_time = now_sec
            return True

        self._last_ros_time = now_sec
        return False

    @staticmethod
    def _safe_stamp_sec(stamp):
        if stamp is None:
            return None
        try:
            value = float(stamp.to_sec())
        except (AttributeError, TypeError, ValueError):
            return None
        if not math.isfinite(value):
            return None
        return value

    @staticmethod
    def _max_stamp(current, candidate):
        if candidate is None:
            return current
        if current is None:
            return candidate
        return max(current, candidate)

    # ------------------------------------------------------------------
    # State invalidation helpers (caller holds _lock)
    # ------------------------------------------------------------------

    def _invalidate_path_locked(self):
        self.path = []
        self.path_frame = ""
        self.path_received_at = None
        self.path_stamp = None
        self.path_error = None
        self.target_index = 0

    def _invalidate_odom_locked(self):
        self.odom = None
        self.odom_received_at = None
        self.odom_stamp = None
        self.odom_error = None

    def _invalidate_planning_status_locked(self):
        self.planning_status = None
        self.planning_status_received_at = None
        self.planning_status_stamp = None
        self.planning_status_error = None

    def _invalidate_localization_status_locked(self):
        self.localization_status = None
        self.localization_status_received_at = None
        self.localization_status_stamp = None
        self.localization_status_error = None

    def _invalidate_all_inputs_locked(self):
        self._invalidate_path_locked()
        self._invalidate_odom_locked()
        self._invalidate_planning_status_locked()
        self._invalidate_localization_status_locked()

    def _same_path_geometry_locked(self, msg):
        """Return whether ``msg`` is the current route with only new stamps.

        Exact component comparison is intentional.  A planner that changes
        even one coordinate or orientation remains a genuine route update,
        resets waypoint selection, and receives the normal safety handling.
        """
        if not self.path or msg.header.frame_id != self.path_frame:
            return False
        if len(msg.poses) != len(self.path):
            return False
        for current, incoming in zip(self.path, msg.poses):
            current_pose = current.pose
            incoming_pose = incoming.pose
            current_values = (
                current_pose.position.x,
                current_pose.position.y,
                current_pose.position.z,
                current_pose.orientation.x,
                current_pose.orientation.y,
                current_pose.orientation.z,
                current_pose.orientation.w,
            )
            incoming_values = (
                incoming_pose.position.x,
                incoming_pose.position.y,
                incoming_pose.position.z,
                incoming_pose.orientation.x,
                incoming_pose.orientation.y,
                incoming_pose.orientation.z,
                incoming_pose.orientation.w,
            )
            if current_values != incoming_values:
                return False
        return True

    def _initial_target_index_locked(self):
        if self.odom is None or self.odom_error is not None:
            return 0

        robot = self.odom.pose.pose.position
        if not all(
            math.isfinite(value)
            for value in (robot.x, robot.y)
        ):
            return 0

        try:
            robot_yaw = yaw_from_quaternion(self.odom.pose.pose.orientation)
        except ValueError:
            return 0

        for index, pose_stamped in enumerate(self.path):
            distance = self._distance_to_target(
                pose_stamped.pose,
                robot.x,
                robot.y,
            )
            if self._is_rotation_only_target(self.path, index):
                target_yaw = yaw_from_quaternion(
                    pose_stamped.pose.orientation
                )
                if (
                    abs(normalize_angle(target_yaw - robot_yaw))
                    > self.orientation_tolerance
                ):
                    return index
                continue
            if distance >= self.goal_tolerance:
                return index

        return len(self.path)

    @staticmethod
    def _distance_to_target(target_pose, robot_x, robot_y):
        distance = math.hypot(
            target_pose.position.x - robot_x,
            target_pose.position.y - robot_y,
        )

        if not math.isfinite(distance):
            raise ValueError("target distance is not finite")

        return distance

    @staticmethod
    def _is_rotation_only_target(path, index):
        """Identify the explicit same-position orientation waypoint form."""
        if index <= 0 or index >= len(path):
            return False
        previous = path[index - 1].pose.position
        current = path[index].pose.position
        return math.hypot(
            current.x - previous.x,
            current.y - previous.y,
        ) <= 1.0e-6

    @staticmethod
    def _positive_param(name, default):
        value = float(rospy.get_param(name, default))

        if not math.isfinite(value) or value <= 0.0:
            raise ValueError(
                "{} must be finite and greater than zero".format(name)
            )

        return value

    @staticmethod
    def _nonnegative_param(name, default):
        value = float(rospy.get_param(name, default))

        if not math.isfinite(value) or value < 0.0:
            raise ValueError(
                "{} must be finite and greater than or equal to zero".format(
                    name
                )
            )

        return value


def main():
    rospy.init_node("path_follower", log_level=rospy.INFO)
    follower = PathFollower()
    rate = rospy.Rate(follower.control_frequency, reset=True)

    while not rospy.is_shutdown():
        follower.step()
        rate.sleep()


if __name__ == "__main__":
    main()
