<launch>
  <arg name="test_only_acknowledged" default="false" />
  <arg name="auto_start" default="true" />
  <arg name="waypoint_distances" default="[0.25, 0.50, 0.75]" />
  <arg name="arrival_distance" default="0.55" />
  <arg name="segment_timeout" default="8.0" />
  <arg name="max_yaw_deviation" default="0.15" />
  <arg name="max_cross_track" default="0.15" />
  <arg name="localization_timeout" default="1.0" />

  <include file="$(find competition_bringup)/launch/competition_system.launch">
    <arg name="competition_mode" value="false" />
    <arg name="use_mocks" value="false" />
    <arg name="auto_start" value="$(arg auto_start)" />
    <arg name="planning_enabled" value="false" />
    <arg name="path_follower_max_angular" value="0.15" />
    <arg name="path_follower_path_timeout" value="1.0" />
  </include>

  <node pkg="competition_recovery_testing"
        type="straight_segment_path_source"
        name="c2r7_straight_segment_path_source"
        output="screen"
        respawn="false"
        required="true">
    <param name="test_only_acknowledged"
           value="$(arg test_only_acknowledged)" />
    <rosparam param="waypoint_distances"
              subst_value="true">$(arg waypoint_distances)</rosparam>
    <param name="arrival_distance" value="$(arg arrival_distance)" />
    <param name="timeout" value="$(arg segment_timeout)" />
    <param name="max_yaw_deviation" value="$(arg max_yaw_deviation)" />
    <param name="max_cross_track" value="$(arg max_cross_track)" />
    <param name="localization_timeout" value="$(arg localization_timeout)" />
  </node>
</launch>
