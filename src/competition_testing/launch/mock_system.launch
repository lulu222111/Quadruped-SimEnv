<launch>
  <!--
    mock_system.launch — synthetic mock nodes for integration testing.
    ALL data is hard-coded. No truth files, ground truth topics, or Gazebo services.

    This file is only included by competition_system.launch when use_mocks=true.
    It MUST NOT be included in official competition mode launches.
  -->

  <node pkg="competition_testing" type="mock_localization_node" name="mock_localization"
        output="screen" respawn="false" />

  <node pkg="competition_testing" type="mock_mapping_node" name="mock_mapping"
        output="screen" respawn="false" />

  <node pkg="competition_testing" type="mock_perception_node" name="mock_perception"
        output="screen" respawn="false" />

  <node pkg="competition_testing" type="mock_planning_node" name="mock_planning"
        output="screen" respawn="false" />

</launch>
