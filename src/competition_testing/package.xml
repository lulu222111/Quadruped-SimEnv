<?xml version="1.0"?>
<package format="2">
  <name>competition_testing</name>
  <version>0.1.0</version>
  <description>Pure synthetic mock nodes for integration testing.
  All mock data comes from hard-coded parameters or fixed artificial data.
  Reading truth files, Gazebo ground truth topics, or Gazebo services is
  strictly prohibited — even in test mode.</description>

  <maintainer email="noreply@dg202602.invalid">huangyuming</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>competition_interfaces</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>competition_interfaces</exec_depend>
</package>
