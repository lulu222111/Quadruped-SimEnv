#!/usr/bin/env python3
"""mock_perception_node — publish synthetic hazard candidates for integration testing.

ALL data is hard-coded. Forbidden to read danger_truth.json or ground truth topics.
Requires test_mode=true.
"""

from __future__ import annotations

import sys

import rospy
import geometry_msgs.msg
from competition_interfaces.msg import HazardCandidate, HazardCandidateArray, ModuleStatus


# Hard-coded synthetic candidates in world frame (NOT from truth file)
MOCK_CANDIDATES = [
    (6.0, 15.5, 0.25, "red_sphere", 0.9, True),    # a red sphere
    (-7.0, 19.0, 0.25, "red_sphere", 0.85, True),  # another red sphere
    (5.0, 16.0, 0.25, "red_sphere", 0.75, True),   # a third red sphere
    (7.0, 33.0, 0.25, "red_box", 0.8, True),       # distractor (box)
    (3.0, 9.5, 0.25, "green_sphere", 0.95, True),  # distractor (green)
]


def main():
    rospy.init_node("mock_perception", log_level=rospy.INFO)

    test_mode = rospy.get_param("/competition_loop/competition_mode", True)
    if not test_mode:
        rospy.logerr("mock_perception: test_mode=false, refusing to run!")
        sys.exit(1)

    rospy.loginfo("mock_perception: publishing synthetic hazard candidates (TEST MODE ONLY).")

    candidates_pub = rospy.Publisher(
        "/competition/hazard_candidates", HazardCandidateArray, queue_size=10
    )
    status_pub = rospy.Publisher(
        "/competition/perception/status", ModuleStatus, queue_size=10, latch=True
    )

    arr = HazardCandidateArray()
    arr.header.frame_id = "world"
    for x, y, z, label, conf, valid in MOCK_CANDIDATES:
        c = HazardCandidate()
        c.header.frame_id = "world"
        c.header.stamp = rospy.Time.now()
        c.position = geometry_msgs.msg.Point(x=x, y=y, z=z)
        c.label = label
        c.confidence = conf
        c.position_valid = valid
        arr.candidates.append(c)

    status = ModuleStatus()
    status.header.stamp = rospy.Time.now()
    status.state = ModuleStatus.RUNNING
    status.valid = True
    status.confidence = 1.0
    status.detail = "mock perception (test mode only)"
    status_pub.publish(status)

    rate = rospy.Rate(0.5)  # 0.5 Hz
    while not rospy.is_shutdown():
        arr.header.stamp = rospy.Time.now()
        for c in arr.candidates:
            c.header.stamp = arr.header.stamp
        candidates_pub.publish(arr)
        rate.sleep()


if __name__ == "__main__":
    main()
