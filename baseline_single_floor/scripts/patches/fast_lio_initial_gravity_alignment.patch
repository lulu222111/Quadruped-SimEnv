-  //state_inout.rot = Eye3d; // Exp(mean_acc.cross(V3D(0, 0, -1 / scale_gravity)));
+
+  // --- Initial gravity alignment (Elevator-LIO convention) ------------------
+  // Place camera_init in the horizontal plane, whatever direction the LiDAR/IMU
+  // is mounted, deriving "horizontal" from the IMU's own measured gravity.
+  //
+  // Without this, `rot` keeps its identity default, so camera_init simply
+  // inherits the IMU's orientation.  On this platform the IMU sits on
+  // `livox_imu_link`, rigidly attached to `laser_livox` and therefore carrying
+  // the fixed 45 deg pitch of `laser_livox_joint` (rpy="0 0.785 0").  A tilted
+  // camera_init makes level-ground motion appear as an x/z diagonal
+  // (|dx| ~ |dz|) and makes world z grow while walking on a flat floor.
+  //
+  // Using the measured gravity (rather than a hardcoded mount angle) keeps this
+  // exact: it absorbs the real mount angle without fitting anything to truth.
+  const V3D gravity_world(0.0, 0.0, -G_m_s2);
+  init_state.rot = SO3(
+      Eigen::Quaterniond::FromTwoVectors(-mean_acc, gravity_world).toRotationMatrix());
+  init_state.grav = S2(gravity_world);
+
   init_state.bg  = mean_gyr;
   init_state.offset_T_L_I = Lidar_T_wrt_IMU;
   init_state.offset_R_L_I = Lidar_R_wrt_IMU;
