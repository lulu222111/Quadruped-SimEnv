<?xml version="1.0"?>
<!--
  ==========================================================================
  VALIDATION-ONLY / BASELINE REPRODUCTION — NOT A PRODUCTION LAUNCH
  ==========================================================================

  floor0_4room_replay.launch freezes the one Floor0 configuration that has so
  far produced the validated result:

      ROOM_SCAN_ZONES_TRIGGERED = 4/4
      CURRENT_FLOOR_COMPLETE    = PASS

  Every value below was recovered from committed evidence, not guessed:

    reports/floor0_completion_attempt_matrix.md   (run convention / harness)
    reports/floor0_closure/round1_manifest.md     (configuration under test)
    reports/floor0_closure/round2_manifest.md

  Nothing here changes production defaults.  This file only *selects* args
  that already exist in:

    src/competition_localization/launch/localization_corrected.launch
    src/competition_bringup/launch/competition_system.launch

  Structure follows the team's established wrapper pattern already committed
  in src/competition_bringup/launch/competition_full_loop_leg_odom.launch:
  exactly one canonical localization chain, then competition_system.launch
  with its own localization include disabled.

  DO NOT EDIT THIS FILE TO "IMPROVE" THE RESULT.  If Floor0 behaviour needs to
  change, branch off this baseline and change it there.
-->
<launch>

  <!--
    Validation watchdog.

      1800.0 s = VALIDATION WATCHDOG ONLY
      600.0 s  = FORMAL MISSION BUDGET (production default, also the scoring
                 threshold in docs/evaluation.md)

    competition_system.launch hard-codes <param name="max_time" value="600.0"/>
    inside its competition_loop node and exposes no <arg> for it.  This
    baseline must not modify that production launch, so the override below is
    applied before the include; whether it survives depends on roslaunch's
    param ordering.  Verify with:

        rosparam get /competition_loop/max_time

    See README.md ("Known wrapper caveat") - this is reported honestly, never
    assumed.
  -->
  <arg name="max_time" default="1800.0" />
  <param name="/competition_loop/max_time" value="$(arg max_time)" />

  <arg name="team_scene_info_path" default="generated_building/team_scene_info.json" />

  <!--
    Room-only visual scan zones, world metres, [[xmin,xmax,ymin,ymax], ...].
    Recovered verbatim from reports/floor0_closure/round1_manifest.md:

        [[1.1,9.5,7.9,21.9],[-9.5,-1.1,7.9,21.9],
         [1.1,9.5,21.9,35.9],[-9.5,-1.1,21.9,35.9]]

    These confine 360 degree scans to the 4 rooms so the robot does not burn
    budget rotating in the entry / lobby / corridor.
  -->
  <arg name="planning_room_scan_zones"
       default="[[1.1,9.5,7.9,21.9],[-9.5,-1.1,7.9,21.9],[1.1,9.5,21.9,35.9],[-9.5,-1.1,21.9,35.9]]" />

  <!-- ======================================================================
       1. Canonical localization chain (the ONLY /competition/localization/odom
          publisher in this baseline).

          planar-relative correction over leg odometry:
            XY    = leg odometry (vel_scale) + one-time alignment
            YAW   = leg odometry yaw + latched offset
            Z     = FAST-LIO
            R/P   = FAST-LIO
       ====================================================================== -->
  <include file="$(find competition_localization)/launch/localization_corrected.launch">
    <arg name="rviz" value="false" />
    <arg name="team_scene_info_path" value="$(arg team_scene_info_path)" />
    <arg name="correction_enabled" value="true" />
    <arg name="correction_mode" value="planar_relative" />
  </include>

  <!-- ======================================================================
       2. Competition stack.

          localization_enabled               = false  (chain above owns odom)
          floor_lifecycle_enabled            = true
          planning_room_mission_enabled      = true
          planning_room_scan_zones           = the 4 boxes above
          planning_visual_scan_route_spacing = 4.0   (production default is 2.0)
       ====================================================================== -->
  <include file="$(find competition_bringup)/launch/competition_system.launch">
    <arg name="competition_mode" value="true" />
    <arg name="auto_start" value="true" />
    <arg name="localization_enabled" value="false" />
    <arg name="floor_lifecycle_enabled" value="true" />
    <arg name="planning_room_mission_enabled" value="true" />
    <arg name="planning_room_scan_zones" value="$(arg planning_room_scan_zones)" />
    <arg name="planning_visual_scan_route_spacing" value="4.0" />
  </include>

</launch>
