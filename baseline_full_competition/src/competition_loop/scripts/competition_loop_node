#!/usr/bin/env python3
"""competition_loop_node — competition state machine entry point.

Manages the FSM, timer, interface validation, result writing, and safety
signals.  All algorithm modules communicate through standard competition
topics.

中文说明：
    比赛任务编排入口节点，负责把纯逻辑模块（FSM / mission_plan / router /
    result_writer）与 ROS 世界连接起来。

    主要职责：
        1. 运行顶层 CompetitionStateMachine，并发布 /competition/state、
           /competition/control_enabled、/competition/emergency_stop；
        2. 周期性执行接口校验（禁止 topic / 禁止文件），未通过前不允许进入
           RUNNING（fail-closed）；
        3. MODE B 下驱动 FloorMissionStateMachine，把 Command 翻译成电梯
           mission 发布、厅门开启、楼层过渡 sentinel、各模块 floor_reset；
        4. 订阅感知候选，经 HazardCandidateRouter 去重后写入结果；
        5. 返航阶段以“定位有效 + 里程计新鲜 + follower SUCCEEDED + 到达
           起点容差内连续采样”为 ARRIVED_START 的判定条件。

    运动安全：只有 RUNNING / RETURNING 发布 control_enabled=true，
    其余阶段（含 WAITING / FINISHED / ERROR）一律 emergency_stop=true。

    合规：结果只写 detected_danger.json；不读取真值/隐藏布局文件，
    返航起点取自公开 team_scene_info.robot_start。
"""

from __future__ import annotations

import math
import os
import sys
import copy
import json
from pathlib import Path
from typing import Optional

import rospy
import std_msgs.msg
import std_srvs.srv
from competition_interfaces.msg import (
    CompetitionState as CompetitionStateMsg,
    ElevatorMission,
    ElevatorStatus,
    HazardCandidateArray,
    HazardCandidate,
    ModuleStatus,
)
from nav_msgs.msg import Odometry

# Ensure the src/ directory is on sys.path so we can import our modules.
_PKG_DIR = Path(__file__).resolve().parents[1]
_SRC_DIR = _PKG_DIR / "src"
if str(_SRC_DIR) not in sys.path:
    sys.path.insert(0, str(_SRC_DIR))

from competition_state_machine import CompetitionStateMachine, CompetitionPhase
from interface_validator import InterfaceValidator
from time_keeper import TimeKeeper
from result_writer import ResultWriter
from hazard_candidate_router import HazardCandidateRouter
from mission_plan import build_mission_plan, MissionPlanError
from floor_mission_fsm import (
    CommandKind,
    FloorMissionState,
    FloorMissionStateMachine,
)


def _is_valid_finite_positive_number(value: object) -> bool:
    """Return True if value is a finite positive number (int/float, NOT bool)."""
    if isinstance(value, bool):
        return False
    if not isinstance(value, (int, float)):
        return False
    if not math.isfinite(value):
        return False
    return value > 0


def _is_valid_finite_non_negative_number(value: object) -> bool:
    """Return True if value is a finite non-negative number (int/float, NOT bool)."""
    if isinstance(value, bool):
        return False
    if not isinstance(value, (int, float)):
        return False
    if not math.isfinite(value):
        return False
    return value >= 0


def _safe_repr(value: object) -> str:
    """Safely convert any value to a log-safe string representation."""
    try:
        if isinstance(value, bool):
            return str(value)
        if isinstance(value, (int, float)):
            if math.isfinite(value):
                return repr(value)
            return repr(value)
        return repr(value)
    except Exception:
        return "<unprintable>"


class CompetitionLoopNode:
    """Main competition orchestration node.

    中文：编排节点主体。ROS 回调只做“取事实 -> 交给纯逻辑 -> 执行返回的
    Command”，不在此层做业务判断，便于单元测试与 ROS 运行解耦。
    """

    def __init__(self):
        rospy.init_node("competition_loop", log_level=rospy.INFO)

        # --- Parameters (raw) ---
        self._max_time = rospy.get_param("~max_time", 600.0)
        self._start_delay = rospy.get_param("~start_delay", 5.0)
        self._auto_start = rospy.get_param("~auto_start", True)
        self._finish_on_first_detection = rospy.get_param(
            "~finish_on_first_detection", False
        )
        self._return_on_first_detection = rospy.get_param(
            "~return_on_first_detection", False
        )
        self._return_arrival_tolerance = rospy.get_param(
            "~return_arrival_tolerance", 0.25
        )
        self._return_arrival_samples = rospy.get_param(
            "~return_arrival_samples", 3
        )
        self._return_input_timeout = rospy.get_param(
            "~return_input_timeout", 1.0
        )
        self._competition_mode = rospy.get_param("~competition_mode", True)
        self._result_path_raw = rospy.get_param("~result_path", None)
        self._workspace_root = rospy.get_param("~workspace_root", "/workspace/SimEnv")
        self._candidate_max_age = rospy.get_param("~hazard_candidate_max_age", 5.0)
        self._candidate_future_tolerance = rospy.get_param(
            "~hazard_candidate_future_tolerance", 0.5
        )
        self._candidate_dedup_distance = rospy.get_param(
            "~hazard_candidate_dedup_distance", 0.30
        )

        # --- Multi-floor mission (MODE B) parameters ---
        self._mission_mode = str(rospy.get_param("~mission_mode", "single_floor"))
        self._start_floor = rospy.get_param("~start_floor", 0)
        self._locate_timeout = rospy.get_param("~locate_timeout", 180.0)
        self._elevator_request_timeout = rospy.get_param(
            "~elevator_request_timeout", 30.0
        )
        self._floor_switch_ready_timeout = rospy.get_param(
            "~floor_switch_ready_timeout", 60.0
        )
        self._max_elevator_retries = rospy.get_param("~max_elevator_retries", 1)
        self._door_service_timeout = rospy.get_param("~door_service_timeout", 45.0)
        self._planning_status_timeout = rospy.get_param(
            "~planning_status_timeout", 3.0
        )

        # --- ALWAYS initialise ALL members before any early return ---
        # This guarantees run() will never encounter AttributeError.

        # FSM
        self._fsm = CompetitionStateMachine()

        # Parameter validation
        param_ok = self._validate_parameters()

        # Core components (created regardless of param validity)
        self._timer = TimeKeeper(
            max_time=self._max_time if _is_valid_finite_positive_number(self._max_time) else 600.0
        )
        self._validator = InterfaceValidator(
            competition_mode=bool(self._competition_mode)
            if isinstance(self._competition_mode, bool)
            else True
        )

        # Resolve result path
        self._result_path = self._resolve_result_path()

        self._result_writer = ResultWriter(output_path=str(self._result_path))
        self._candidate_router = HazardCandidateRouter(
            self._result_writer,
            dedup_distance=(
                float(self._candidate_dedup_distance)
                if _is_valid_finite_positive_number(self._candidate_dedup_distance)
                else 0.30
            ),
            max_age=(
                float(self._candidate_max_age)
                if _is_valid_finite_positive_number(self._candidate_max_age)
                else 5.0
            ),
            future_tolerance=(
                float(self._candidate_future_tolerance)
                if _is_valid_finite_non_negative_number(self._candidate_future_tolerance)
                else 0.50
            ),
            now_fn=lambda: rospy.Time.now().to_sec(),
        )
        self._tf_buffer = None
        self._tf_listener = None
        self._candidate_sub = None
        self._found_danger = False
        self._return_start_pose = None
        self._return_odom = None
        self._return_localization_status = None
        self._return_follower_status = None
        self._return_arrival_count = 0

        # --- Multi-floor mission state (MODE B) ---
        self._mission_plan = None
        self._mission_fsm = None
        self._door_controller = None
        self._elevator_mission_pub = None
        self._floor_state_pub = None
        self._planning_floor_reset_pub = None
        self._localization_floor_reset_pub = None
        self._elevator_locate_pub = None
        self._exploration_complete_sub = None
        self._elevator_status_sub = None
        self._mapping_current_floor_sub = None
        self._planning_status_sub = None
        self._elevator_ready_sub = None
        self._planning_status_latest = None
        self._door_thread = None

        # Clock and delay tracking — initialised BEFORE Timer
        self._clock_ready: bool = False
        self._last_ros_time: Optional[rospy.Time] = None
        self._ready_since: Optional[rospy.Time] = None
        self._start_delay_done: bool = False

        # Publishers — always set up for safety signals
        self._setup_publishers()

        # Publish initial safety signals
        self._publish_safety_signals(control_enabled=False, emergency_stop=True)

        # Handle parameter failure: enter ERROR, set up Timer, and return
        if not param_ok:
            rospy.logerr(
                "competition_loop: invalid parameters — entering ERROR state. "
                "max_time=%s start_delay=%s competition_mode=%s auto_start=%s "
                "finish_on_first_detection=%s return_on_first_detection=%s "
                "workspace_root=%s",
                _safe_repr(self._max_time),
                _safe_repr(self._start_delay),
                _safe_repr(self._competition_mode),
                _safe_repr(self._auto_start),
                _safe_repr(self._finish_on_first_detection),
                _safe_repr(self._return_on_first_detection),
                _safe_repr(self._workspace_root),
            )
            self._fsm.force_error("Invalid parameters — check max_time, start_delay.")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            # Create Timer LAST so it cannot fire before all members exist
            self._tick_timer = rospy.Timer(rospy.Duration(0.1), self._tick_callback)
            self._publish_state()
            rospy.loginfo("competition_loop initialised in ERROR state (invalid parameters).")
            return

        # --- Normal initialisation ---
        rospy.loginfo("competition_loop starting (mode=%s)",
                      "competition" if self._competition_mode else "test")
        rospy.loginfo(
            "  max_time=%s  start_delay=%s  auto_start=%s  "
            "finish_on_first_detection=%s  return_on_first_detection=%s  "
            "workspace_root=%s  result_path=%s",
            _safe_repr(self._max_time),
            _safe_repr(self._start_delay),
            _safe_repr(self._auto_start),
            _safe_repr(self._finish_on_first_detection),
            _safe_repr(self._return_on_first_detection),
            _safe_repr(self._workspace_root),
            str(self._result_path),
        )

        # Load scene info (the only allowed file)
        self._validator.load_scene_info(self._workspace_root)
        need_return_pose = (
            self._return_on_first_detection
            or self._mission_mode == "multi_floor"
        )
        if need_return_pose:
            self._return_start_pose = self._load_return_start_pose()
            if self._return_start_pose is None:
                self._fsm.force_error("return start pose unavailable")

        # Multi-floor mission orchestration (MODE B)
        if self._mission_mode == "multi_floor":
            if not self._setup_multi_floor_mission():
                self._fsm.force_error(
                    "multi-floor mission setup failed (public scene info)"
                )

        # Services — created AFTER members, BEFORE Timer
        self._start_srv = rospy.Service(
            "/competition/start", std_srvs.srv.Trigger, self._handle_start
        )
        self._finish_srv = rospy.Service(
            "/competition/finish", std_srvs.srv.Trigger, self._handle_finish
        )

        self._setup_candidate_router()
        if need_return_pose:
            self._setup_return_subscribers()

        # Timer — created LAST so it cannot fire before all members exist
        self._tick_timer = rospy.Timer(rospy.Duration(0.1), self._tick_callback)

        rospy.loginfo("competition_loop initialised; state=WAITING")

    # ------------------------------------------------------------------
    # Parameter validation
    # ------------------------------------------------------------------

    def _validate_parameters(self) -> bool:
        """Validate all critical parameters. Returns False on any violation.

        Rejects: bool, string, NaN, Inf, -Inf, max_time<=0, start_delay<0.
        Note: Python bool is a subclass of int, so isinstance checks must
        explicitly exclude bool.

        中文：所有关键参数在启动时一次性校验，任何非法值都使节点进入 ERROR
        并保持急停，而不是运行中才暴露问题。
        注意 bool 是 int 的子类，因此数值校验必须显式排除 bool。
        """
        ok = True

        if not (isinstance(self._max_time, (int, float))
                and not isinstance(self._max_time, bool)
                and math.isfinite(self._max_time)
                and self._max_time > 0):
            rospy.logerr("Invalid ~max_time=%s: must be a finite positive number (not bool/str/NaN/Inf)",
                         _safe_repr(self._max_time))
            ok = False

        if not (isinstance(self._start_delay, (int, float))
                and not isinstance(self._start_delay, bool)
                and math.isfinite(self._start_delay)
                and self._start_delay >= 0):
            rospy.logerr("Invalid ~start_delay=%s: must be a finite non-negative number (not bool/str/NaN/Inf)",
                         _safe_repr(self._start_delay))
            ok = False

        if not isinstance(self._competition_mode, bool):
            rospy.logerr("Invalid ~competition_mode=%s: must be a boolean",
                         _safe_repr(self._competition_mode))
            ok = False

        if not isinstance(self._auto_start, bool):
            rospy.logerr("Invalid ~auto_start=%s: must be a boolean",
                         _safe_repr(self._auto_start))
            ok = False

        if not isinstance(self._finish_on_first_detection, bool):
            rospy.logerr(
                "Invalid ~finish_on_first_detection=%s: must be a boolean",
                _safe_repr(self._finish_on_first_detection),
            )
            ok = False

        if not isinstance(self._return_on_first_detection, bool):
            rospy.logerr(
                "Invalid ~return_on_first_detection=%s: must be a boolean",
                _safe_repr(self._return_on_first_detection),
            )
            ok = False
        if (
            self._finish_on_first_detection
            and self._return_on_first_detection
        ):
            rospy.logerr(
                "~finish_on_first_detection and ~return_on_first_detection "
                "cannot both be true"
            )
            ok = False
        if not _is_valid_finite_positive_number(self._return_arrival_tolerance):
            rospy.logerr(
                "Invalid ~return_arrival_tolerance=%s: must be finite and > 0",
                _safe_repr(self._return_arrival_tolerance),
            )
            ok = False
        if (
            isinstance(self._return_arrival_samples, bool)
            or not isinstance(self._return_arrival_samples, int)
            or self._return_arrival_samples < 1
        ):
            rospy.logerr(
                "Invalid ~return_arrival_samples=%s: must be an integer >= 1",
                _safe_repr(self._return_arrival_samples),
            )
            ok = False
        if not _is_valid_finite_positive_number(self._return_input_timeout):
            rospy.logerr(
                "Invalid ~return_input_timeout=%s: must be finite and > 0",
                _safe_repr(self._return_input_timeout),
            )
            ok = False

        if not isinstance(self._workspace_root, str) or not self._workspace_root.strip():
            rospy.logerr("Invalid ~workspace_root=%s: must be a non-empty string",
                         _safe_repr(self._workspace_root))
            ok = False

        if not _is_valid_finite_positive_number(self._candidate_max_age):
            rospy.logerr(
                "Invalid ~hazard_candidate_max_age=%s: must be finite and > 0",
                _safe_repr(self._candidate_max_age),
            )
            ok = False
        if not _is_valid_finite_positive_number(self._candidate_dedup_distance):
            rospy.logerr(
                "Invalid ~hazard_candidate_dedup_distance=%s: must be finite and > 0",
                _safe_repr(self._candidate_dedup_distance),
            )
            ok = False
        if not _is_valid_finite_non_negative_number(self._candidate_future_tolerance):
            rospy.logerr(
                "Invalid ~hazard_candidate_future_tolerance=%s: must be finite and >= 0",
                _safe_repr(self._candidate_future_tolerance),
            )
            ok = False

        if self._mission_mode not in ("single_floor", "multi_floor"):
            rospy.logerr(
                "Invalid ~mission_mode=%s: must be 'single_floor' or 'multi_floor'",
                _safe_repr(self._mission_mode),
            )
            ok = False
        if (
            isinstance(self._start_floor, bool)
            or not isinstance(self._start_floor, int)
            or self._start_floor < 0
        ):
            rospy.logerr(
                "Invalid ~start_floor=%s: must be an integer >= 0",
                _safe_repr(self._start_floor),
            )
            ok = False
        for name, value in (
            ("locate_timeout", self._locate_timeout),
            ("elevator_request_timeout", self._elevator_request_timeout),
            ("floor_switch_ready_timeout", self._floor_switch_ready_timeout),
            ("door_service_timeout", self._door_service_timeout),
            ("planning_status_timeout", self._planning_status_timeout),
        ):
            if not _is_valid_finite_positive_number(value):
                rospy.logerr(
                    "Invalid ~%s=%s: must be finite and > 0",
                    name,
                    _safe_repr(value),
                )
                ok = False
        if (
            isinstance(self._max_elevator_retries, bool)
            or not isinstance(self._max_elevator_retries, int)
            or self._max_elevator_retries < 1
        ):
            rospy.logerr(
                "Invalid ~max_elevator_retries=%s: must be an integer >= 1",
                _safe_repr(self._max_elevator_retries),
            )
            ok = False

        return ok

    # ------------------------------------------------------------------
    # Result path resolution
    # ------------------------------------------------------------------

    def _resolve_result_path(self) -> Path:
        """Resolve result_path relative to workspace_root.

        If result_path is an absolute path, use it as-is.
        Otherwise resolve it against workspace_root.
        Default: /workspace/SimEnv/results/detected_danger.json
        """
        if self._result_path_raw:
            p = Path(self._result_path_raw)
            if p.is_absolute():
                return p
            # Relative path — resolve against workspace_root
            ws = Path(str(self._workspace_root)) if self._workspace_root else Path.cwd()
            resolved = ws / p
        else:
            ws = Path(str(self._workspace_root)) if self._workspace_root else Path.cwd()
            resolved = ws / "results" / "detected_danger.json"

        rospy.loginfo("Result path resolved: raw=%s → %s",
                      repr(self._result_path_raw), str(resolved))
        return resolved

    # ------------------------------------------------------------------
    # Publisher setup
    # ------------------------------------------------------------------

    def _setup_candidate_router(self):
        """Subscribe to perception candidates and prepare timestamped TF."""
        import tf2_ros

        self._tf_buffer = tf2_ros.Buffer(cache_time=rospy.Duration(10.0))
        self._tf_listener = tf2_ros.TransformListener(self._tf_buffer)
        self._candidate_sub = rospy.Subscriber(
            "/competition/hazard_candidates",
            HazardCandidateArray,
            self._hazard_candidates_callback,
            queue_size=10,
        )

    def _setup_return_subscribers(self):
        """Subscribe to legal return pose/status inputs only in return mode."""
        self._return_odom_sub = rospy.Subscriber(
            "/competition/localization/odom",
            Odometry,
            self._return_odom_callback,
            queue_size=1,
        )
        self._return_localization_status_sub = rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self._return_localization_status_callback,
            queue_size=1,
        )
        self._return_follower_status_sub = rospy.Subscriber(
            "/competition/control/path_follower_status",
            ModuleStatus,
            self._return_follower_status_callback,
            queue_size=1,
        )

    # ------------------------------------------------------------------
    # Multi-floor mission orchestration (MODE B)
    # ------------------------------------------------------------------

    def _setup_multi_floor_mission(self) -> bool:
        """Build the mission plan/FSM and wire mission topics.

        Every input comes from the public team_scene_info fields; no hidden
        layout data is read.  Returns False on any plan/setup failure.

        中文：MODE B 初始化。只用公开 team_scene_info 构造 mission plan；
        任何失败都返回 False 并由上层置 ERROR，绝不降级猜测。
        """
        scene_path = (
            Path(self._workspace_root)
            / "generated_building"
            / "team_scene_info.json"
        )
        try:
            data = json.loads(scene_path.read_text(encoding="utf-8"))
            if data.get("coordinate_frame") != "world":
                raise ValueError("coordinate_frame must be 'world'")
            self._mission_plan = build_mission_plan(
                data,
                start_floor=self._start_floor,
            )
        except (OSError, ValueError, MissionPlanError, json.JSONDecodeError) as exc:
            rospy.logerr("multi-floor mission plan failed: %s", exc)
            return False

        self._mission_fsm = FloorMissionStateMachine(
            self._mission_plan,
            locate_timeout=self._locate_timeout,
            request_timeout=self._elevator_request_timeout,
            floor_switch_timeout=self._floor_switch_ready_timeout,
            max_elevator_retries=self._max_elevator_retries,
        )

        # Door/elevator official-service client (lazy import keeps pure
        # unit tests free of building_generator_interfaces).
        try:
            from door_controller import DoorController

            self._door_controller = DoorController(
                timeout=float(self._door_service_timeout)
            )
        except Exception as exc:
            rospy.logerr("DoorController setup failed: %s", exc)
            return False

        self._elevator_mission_pub = rospy.Publisher(
            "/competition/elevator/mission",
            ElevatorMission,
            queue_size=10,
            latch=False,
        )
        self._floor_state_pub = rospy.Publisher(
            "/competition/floor_state",
            std_msgs.msg.Int32,
            queue_size=1,
            latch=True,
        )
        self._planning_floor_reset_pub = rospy.Publisher(
            "/competition/planning/floor_reset",
            std_msgs.msg.Int32,
            queue_size=1,
            latch=True,
        )
        self._localization_floor_reset_pub = rospy.Publisher(
            "/competition/localization/floor_reset",
            std_msgs.msg.Int32,
            queue_size=1,
            latch=True,
        )
        self._elevator_locate_pub = rospy.Publisher(
            "/competition/planning/elevator_locate",
            std_msgs.msg.Bool,
            queue_size=1,
            latch=True,
        )

        self._exploration_complete_sub = rospy.Subscriber(
            "/competition/planning/exploration_complete",
            std_msgs.msg.Bool,
            self._exploration_complete_callback,
            queue_size=1,
        )
        self._elevator_status_sub = rospy.Subscriber(
            "/competition/elevator/status",
            ElevatorStatus,
            self._elevator_status_callback,
            queue_size=10,
        )
        self._mapping_current_floor_sub = rospy.Subscriber(
            "/competition/mapping/current_floor",
            std_msgs.msg.Int32,
            self._mapping_current_floor_callback,
            queue_size=1,
        )
        self._planning_status_sub = rospy.Subscriber(
            "/competition/planning/status",
            ModuleStatus,
            self._planning_status_callback,
            queue_size=10,
        )
        self._elevator_ready_sub = rospy.Subscriber(
            "/competition/planning/elevator_ready",
            std_msgs.msg.Bool,
            self._elevator_ready_callback,
            queue_size=1,
        )

        self._candidate_router.set_floor(int(self._start_floor))

        rospy.loginfo(
            "multi-floor mission ready: %s",
            self._mission_plan.describe(),
        )
        return True

    def _exploration_complete_callback(self, msg):
        if self._mission_fsm is None or not self._fsm.is_running:
            return
        now = rospy.Time.now().to_sec()
        commands = self._mission_fsm.on_exploration_complete(
            bool(msg.data), now
        )
        self._execute_mission_commands(commands)

    def _elevator_status_callback(self, msg):
        if self._mission_fsm is None or not self._fsm.is_running:
            return
        now = rospy.Time.now().to_sec()
        commands = self._mission_fsm.on_elevator_status(
            int(msg.mission_id),
            int(msg.phase),
            bool(msg.valid),
            now,
        )
        self._execute_mission_commands(commands)

    def _mapping_current_floor_callback(self, msg):
        if self._mission_fsm is None or not self._fsm.is_running:
            return
        now = rospy.Time.now().to_sec()
        commands = self._mission_fsm.on_mapping_current_floor(
            int(msg.data), now
        )
        self._execute_mission_commands(commands)

    def _planning_status_callback(self, msg):
        self._planning_status_latest = msg
        if self._mission_fsm is None or not self._fsm.is_running:
            return
        now = rospy.Time.now().to_sec()
        if not bool(msg.valid):
            return
        if not self._message_is_fresh(
            msg, rospy.Time.now(), self._planning_status_timeout
        ):
            return
        commands = self._mission_fsm.on_planning_status_alive(now)
        self._execute_mission_commands(commands)

    def _elevator_ready_callback(self, msg):
        if self._mission_fsm is None or not self._fsm.is_running:
            return
        if not bool(msg.data):
            return
        now = rospy.Time.now().to_sec()
        commands = self._mission_fsm.on_elevator_approach(now)
        self._execute_mission_commands(commands)

    def _execute_mission_commands(self, commands) -> None:
        for command in commands or ():
            kind = command.kind
            payload = command.payload
            if kind == CommandKind.SET_DETAIL:
                if self._fsm.is_running:
                    self._fsm.set_detail(str(payload))
                self._publish_state()
            elif kind == CommandKind.REQUEST_ELEVATOR_LOCATE:
                self._elevator_locate_pub.publish(
                    std_msgs.msg.Bool(data=True)
                )
            elif kind == CommandKind.OPEN_ELEVATOR_DOOR:
                self._open_elevator_door_async(str(payload))
            elif kind == CommandKind.PUBLISH_ELEVATOR_MISSION:
                self._publish_elevator_mission(payload)
            elif kind == CommandKind.BEGIN_FLOOR_TRANSITION:
                self._floor_state_pub.publish(std_msgs.msg.Int32(data=-1))
                rospy.loginfo("floor transition sentinel published")
            elif kind == CommandKind.ACTIVATE_FLOOR:
                floor = int(payload)
                self._floor_state_pub.publish(
                    std_msgs.msg.Int32(data=floor)
                )
                self._candidate_router.set_floor(floor)
                rospy.loginfo("floor %d activated (hazard registry moved)", floor)
            elif kind == CommandKind.PLANNING_FLOOR_RESET:
                self._planning_floor_reset_pub.publish(
                    std_msgs.msg.Int32(data=int(payload))
                )
            elif kind == CommandKind.LOCALIZATION_FLOOR_RESET:
                self._localization_floor_reset_pub.publish(
                    std_msgs.msg.Int32(data=int(payload))
                )
            elif kind == CommandKind.BEGIN_RETURNING:
                rospy.loginfo("mission: all floors complete — RETURNING home")
                self._begin_returning()

    def _publish_elevator_mission(self, payload: dict) -> None:
        msg = ElevatorMission()
        msg.header.stamp = rospy.Time.now()
        msg.mission_id = int(payload["mission_id"])
        msg.elevator_id = str(payload["elevator_id"])
        msg.source_floor = int(payload["source_floor"])
        msg.target_floor = int(payload["target_floor"])
        self._elevator_mission_pub.publish(msg)
        rospy.loginfo(
            "elevator mission %d published: %s %d->%d",
            msg.mission_id,
            msg.elevator_id,
            msg.source_floor,
            msg.target_floor,
        )

    def _open_elevator_door_async(self, door_id: str) -> None:
        """Open the hall door via the official service without blocking the
        FSM timer (door motion may take tens of seconds).

        中文：厅门动辄需要数十秒，必须放到 worker 线程调用官方
        /set_door_state，否则会阻塞 FSM 定时器；同时只允许一个开门线程，
        失败时把 mission FSM 直接置为失败（fail-closed）。
        """
        import threading

        if self._door_thread is not None and self._door_thread.is_alive():
            return
        if self._door_controller is None:
            return

        def _worker() -> None:
            try:
                result = self._door_controller.open_door(door_id)
                if not result.get("accepted", False):
                    raise RuntimeError(
                        "door open rejected: {}".format(result)
                    )
                rospy.loginfo("elevator hall door opened: %s", door_id)
            except Exception as exc:
                rospy.logerr("elevator hall door open failed: %s", exc)
                if getattr(self, "_mission_fsm", None) is not None and self._fsm.is_running:
                    commands = self._mission_fsm.force_failed(
                        "hall door {} could not be opened: {}".format(
                            door_id, exc
                        ),
                        rospy.Time.now().to_sec(),
                    )
                    self._execute_mission_commands(commands)

        self._door_thread = threading.Thread(
            target=_worker, daemon=True, name="elevator-door-open"
        )
        self._door_thread.start()

    def _load_return_start_pose(self):
        """Load the public world-frame start pose for return qualification.

        中文：返航判定基准来自公开 team_scene_info.robot_start（world 坐标系）。
        这是唯一允许读取的起点信息；不使用 Gazebo 真值或隐藏布局数据。
        """
        path = Path(self._workspace_root) / "generated_building" / "team_scene_info.json"
        try:
            data = json.loads(path.read_text(encoding="utf-8"))
            if data.get("coordinate_frame") != "world":
                raise ValueError("coordinate_frame must be 'world'")
            start = data.get("robot_start")
            if not isinstance(start, dict):
                raise ValueError("robot_start is missing")
            values = tuple(float(start[key]) for key in ("x", "y", "z", "yaw"))
            if not all(math.isfinite(value) for value in values):
                raise ValueError("robot_start contains non-finite values")
            return {
                "x": values[0],
                "y": values[1],
                "z": values[2],
                "yaw": values[3],
            }
        except (OSError, TypeError, ValueError, KeyError, json.JSONDecodeError) as exc:
            rospy.logerr("Return start pose unavailable: %s", exc)
            return None

    def _return_odom_callback(self, msg):
        self._return_odom = msg

    def _return_localization_status_callback(self, msg):
        self._return_localization_status = msg

    def _return_follower_status_callback(self, msg):
        self._return_follower_status = msg

    @staticmethod
    def _message_is_fresh(msg, now, timeout):
        if msg is None or not getattr(msg, "header", None):
            return False
        try:
            stamp = msg.header.stamp
            age = (now - stamp).to_sec()
        except (AttributeError, TypeError, ValueError):
            return False
        return math.isfinite(age) and age >= 0.0 and age <= timeout

    def _transform_candidate_to_world(self, candidate):
        """Transform one candidate at its observation timestamp.

        中文：用候选自身时间戳查询 TF，把观测从传感器坐标系转到 world，
        避免用“当前时刻”变换造成运动中的投影误差。frame_id 已是 world
        时直接透传。
        """
        import tf2_geometry_msgs
        import tf2_ros
        from geometry_msgs.msg import PointStamped

        source_frame = candidate.header.frame_id
        if not source_frame:
            raise ValueError("candidate frame_id is empty")
        point = PointStamped()
        point.header = candidate.header
        point.point = candidate.position
        if source_frame == "world":
            transformed_point = point
        else:
            transform = self._tf_buffer.lookup_transform(
                "world",
                source_frame,
                candidate.header.stamp,
                rospy.Duration(0.1),
            )
            transformed_point = tf2_geometry_msgs.do_transform_point(point, transform)

        world_candidate = HazardCandidate()
        world_candidate.header = copy.deepcopy(candidate.header)
        world_candidate.header.frame_id = "world"
        world_candidate.position = transformed_point.point
        world_candidate.label = candidate.label
        world_candidate.confidence = candidate.confidence
        world_candidate.position_valid = candidate.position_valid
        return world_candidate

    def _hazard_candidates_callback(self, msg):
        """Convert valid perception candidates and retain unique world points.

        中文：仅在 RUNNING 阶段接收感知候选；去重与写入交给
        HazardCandidateRouter。感知负责产生观测，去重/全局注册由本节点侧负责。
        """
        if not self._fsm.is_running:
            rospy.logdebug(
                "Ignoring hazard candidates while phase=%s",
                CompetitionPhase.label(self._fsm.phase),
            )
            return
        accepted = self._candidate_router.process(
            msg.candidates,
            self._transform_candidate_to_world,
        )
        if accepted:
            rospy.loginfo(
                "Accepted %d new hazard candidate(s); total=%d",
                accepted,
                self._result_writer.candidate_count,
            )
            self._on_first_new_danger()

    def _on_first_new_danger(self):
        """Publish the mission-level FOUND_DANGER event once per run."""
        if self._found_danger:
            return False
        self._found_danger = True
        self._fsm.set_detail("FOUND_DANGER")
        rospy.loginfo(
            "Mission event: FOUND_DANGER (accepted_count=%d)",
            self._result_writer.candidate_count,
        )
        self._publish_state()
        if getattr(self, "_return_on_first_detection", False) and self._fsm.is_running:
            self._begin_returning()
            return True
        if self._finish_on_first_detection and self._fsm.is_running:
            self._end_competition("FOUND_DANGER: finish_on_first_detection")
        return True

    def _begin_returning(self):
        """Enter RETURNING while keeping the existing path control chain active.

        中文：进入 RETURNING 前必须已有合法起点位姿，否则直接 ERROR；
        进入后仍沿用既有 planning -> path_follower 控制链，
        只是规划目标切换为起点，不引入第二套控制器。
        """
        if self._return_start_pose is None:
            self._fsm.force_error("RETURNING start pose unavailable")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            self._publish_state()
            return False
        self._return_arrival_count = 0
        if not self._fsm.transition_to(
            CompetitionPhase.RETURNING,
            "RETURNING",
        ):
            return False
        self._publish_safety_signals(control_enabled=True, emergency_stop=False)
        self._publish_state()
        rospy.loginfo(
            "Mission event: RETURNING to start [%.3f, %.3f]",
            self._return_start_pose["x"],
            self._return_start_pose["y"],
        )
        return True

    def _setup_publishers(self):
        self._state_pub = rospy.Publisher(
            "/competition/state", CompetitionStateMsg, queue_size=10, latch=True
        )
        self._control_enabled_pub = rospy.Publisher(
            "/competition/control_enabled", std_msgs.msg.Bool, queue_size=1, latch=True
        )
        self._emergency_stop_pub = rospy.Publisher(
            "/competition/emergency_stop", std_msgs.msg.Bool, queue_size=1, latch=True
        )

    # ------------------------------------------------------------------
    # Clock helpers
    # ------------------------------------------------------------------

    def _check_clock_ready(self) -> bool:
        """Return True when ROS time is valid (sim time received or wall clock).

        When /use_sim_time is true and /clock hasn't been received yet,
        rospy.Time.now() returns 0.

        IMPORTANT: This method IS NOT cached — it checks the live ROS time
        every call.  If the clock was valid but becomes zero again (e.g.
        simulator reset), _clock_ready is reset to False and downstream
        gate variables are also reset.
        """
        now = rospy.Time.now()
        if now.is_zero():
            if self._clock_ready:
                rospy.logwarn("ROS clock became zero — resetting ready/delay state.")
            self._clock_ready = False
            self._ready_since = None
            self._start_delay_done = False
            return False
        self._clock_ready = True
        return True

    def _detect_time_regression(self) -> bool:
        """Return True if ROS time moved backwards since last tick.

        ALWAYS updates self._last_ros_time to the current time, even when
        regression is detected.  This ensures subsequent ticks compare
        against the most recent time, not a stale historical baseline.

        Sequence 100→101→0.1→0.2:
          tick 100: no regression, _last = 100
          tick 101: no regression, _last = 101
          tick 0.1: regression detected, _last = 0.1  (UPDATED)
          tick 0.2: no regression (0.2 > 0.1), _last = 0.2
        """
        now = rospy.Time.now()
        regression = False
        if self._last_ros_time is not None and now < self._last_ros_time:
            rospy.logerr(
                "ROS time regression: %.3f -> %.3f (delta=%.3f s)",
                self._last_ros_time.to_sec(),
                now.to_sec(),
                (now - self._last_ros_time).to_sec(),
            )
            regression = True
        # ALWAYS update baseline — even on regression
        self._last_ros_time = now
        return regression

    # ------------------------------------------------------------------
    # Tick — periodic FSM maintenance
    # ------------------------------------------------------------------

    def _tick_callback(self, event):
        # Always publish the current state every tick (latched + periodic)
        self._publish_state()

        phase = self._fsm.phase

        if phase == CompetitionPhase.WAITING:
            self._tick_waiting()

        elif phase == CompetitionPhase.RUNNING:
            self._tick_running()

        elif phase == CompetitionPhase.RETURNING:
            self._tick_returning()

        elif phase == CompetitionPhase.FINISHED:
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)

        elif phase == CompetitionPhase.ERROR:
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)

    def _tick_waiting(self):
        """In WAITING: validate environment, honour start_delay, then auto-start.

        中文：WAITING 阶段顺序固定为
        “ROS 时钟有效 -> 无时间回退 -> 禁止 topic 检查 -> 禁止文件检查
         -> start_delay 计时 -> 自动/手动开始”。
        任一前置条件不成立都保持急停，保证不会带着非法环境进入 RUNNING。
        """

        # 1. Wait for /clock (or wall-clock time) to be valid
        if not self._check_clock_ready():
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        # 2. Detect time regression — reset start_delay if it occurs
        if self._detect_time_regression():
            self._ready_since = None
            self._start_delay_done = False
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        # 3. Run forbidden topic check (retries on transient Master errors)
        if not self._validator.forbidden_topic_check_completed:
            self._validator.check_forbidden_topics()

        # 4. Run forbidden file check (once; idempotent)
        if not self._validator.forbidden_file_check_completed:
            self._validator.check_forbidden_files(self._workspace_root)

        # 5. Check readiness — all mandatory checks completed AND passed
        if not self._validator.is_ready():
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        # 6. Record the moment we first became ready
        if self._ready_since is None:
            self._ready_since = rospy.Time.now()
            rospy.loginfo("All checks passed; start_delay=%.1f s begins now.", self._start_delay)

        # 7. Wait for start_delay to elapse
        elapsed_since_ready = (rospy.Time.now() - self._ready_since).to_sec()
        if elapsed_since_ready < self._start_delay:
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        # 8. Start delay completed
        self._start_delay_done = True

        # 9. Auto-start or wait for manual start
        if self._auto_start:
            self._start_competition()
        else:
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)

    def _tick_running(self):
        """In RUNNING: check timer expiry, detect time regression.

        中文：RUNNING 每 tick 检查时间回退与 max_time，并驱动楼层子 FSM 的
        超时逻辑；子 FSM 报 MISSION_FAILED 时把主 FSM 置 ERROR 并急停。
        """

        # 1. Detect time regression — force ERROR
        if self._detect_time_regression():
            rospy.logerr("Time regression in RUNNING — forcing ERROR.")
            self._fsm.force_error("Time regression detected during RUNNING")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        # 2. Check timer expiry
        if self._timer.is_expired:
            rospy.loginfo("max_time reached; transitioning to FINISHED.")
            self._end_competition("max_time reached")
            return

        # 3. Multi-floor mission sub-FSM (MODE B): timeouts and failure.
        if getattr(self, "_mission_fsm", None) is not None and not self._mission_fsm.is_terminal:
            now = rospy.Time.now().to_sec()
            commands = self._mission_fsm.tick(now)
            self._execute_mission_commands(commands)
            if self._mission_fsm.state == FloorMissionState.MISSION_FAILED:
                rospy.logerr(
                    "multi-floor mission failed: %s",
                    self._mission_fsm.detail,
                )
                self._fsm.force_error(
                    "multi-floor mission failed: {}".format(
                        self._mission_fsm.detail
                    )
                )
                self._publish_safety_signals(
                    control_enabled=False, emergency_stop=True
                )
                self._publish_state()
                return

        # 4. Normal operation
        self._publish_safety_signals(control_enabled=True, emergency_stop=False)

    def _tick_returning(self):
        """Gate ARRIVED_START on fresh legal pose and follower completion.

        中文：ARRIVED_START 需要三个条件同时成立才计数：
        localization 状态有效且新鲜、里程计新鲜、path follower 报 SUCCEEDED
        且新鲜；随后还必须在起点容差内连续采样若干 tick 才判定到达，
        避免瞬时抖动导致误判返航完成。
        """
        if self._detect_time_regression():
            rospy.logerr("ROS time regression in RETURNING — forcing ERROR.")
            self._fsm.force_error("Time regression detected during RETURNING")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            return

        if self._timer.is_expired:
            self._fsm.force_error("RETURNING timeout before ARRIVED_START")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            self._publish_state()
            return

        now = rospy.Time.now()
        localization_valid = (
            self._return_localization_status is not None
            and self._return_localization_status.valid
            and self._message_is_fresh(
                self._return_localization_status,
                now,
                self._return_input_timeout,
            )
        )
        odom_fresh = self._message_is_fresh(
            self._return_odom,
            now,
            self._return_input_timeout,
        )
        follower_succeeded = (
            self._return_follower_status is not None
            and self._return_follower_status.valid
            and self._return_follower_status.state == ModuleStatus.SUCCEEDED
            and self._message_is_fresh(
                self._return_follower_status,
                now,
                self._return_input_timeout,
            )
        )

        if not (localization_valid and odom_fresh and follower_succeeded):
            self._return_arrival_count = 0
            self._publish_safety_signals(control_enabled=True, emergency_stop=False)
            return

        try:
            position = self._return_odom.pose.pose.position
            distance = math.hypot(
                float(position.x) - self._return_start_pose["x"],
                float(position.y) - self._return_start_pose["y"],
            )
        except (AttributeError, TypeError, ValueError):
            distance = float("inf")

        if not math.isfinite(distance) or distance > self._return_arrival_tolerance:
            self._return_arrival_count = 0
            self._publish_safety_signals(control_enabled=True, emergency_stop=False)
            return

        self._return_arrival_count += 1
        if self._return_arrival_count < self._return_arrival_samples:
            self._publish_safety_signals(control_enabled=True, emergency_stop=False)
            return

        self._fsm.set_detail("ARRIVED_START")
        self._publish_state()
        rospy.loginfo(
            "Mission event: ARRIVED_START (distance=%.3f m, samples=%d)",
            distance,
            self._return_arrival_count,
        )
        if getattr(self, "_mission_fsm", None) is not None:
            commands = self._mission_fsm.on_return_arrived(
                rospy.Time.now().to_sec()
            )
            self._execute_mission_commands(commands)
        self._end_competition("ARRIVED_START")

    # ------------------------------------------------------------------
    # Start / Finish
    # ------------------------------------------------------------------

    def _start_competition(self):
        """Transition from WAITING to RUNNING.

        中文：进入 RUNNING 时启动计时并使能运动；MODE B 下同时启动楼层子 FSM。
        """
        if not self._fsm.transition_to(CompetitionPhase.RUNNING, "Competition started"):
            return
        self._timer.start()
        self._publish_safety_signals(control_enabled=True, emergency_stop=False)
        if getattr(self, "_mission_fsm", None) is not None:
            commands = self._mission_fsm.start(rospy.Time.now().to_sec())
            self._execute_mission_commands(commands)
        # Publish state immediately on transition (in addition to periodic tick)
        self._publish_state()
        rospy.loginfo("Competition RUNNING. max_time=%s s", _safe_repr(self._max_time))

    def _end_competition(self, reason: str = ""):
        """Transition from RUNNING to FINISHED.

        中文：结束流程固定为“停表 -> 记录探索耗时 -> FINISHED -> 急停 ->
        写结果”。写结果失败会升级为 ERROR，保证不会静默丢失交付物。
        """
        self._timer.stop()
        self._result_writer.set_exploration_time(self._timer.elapsed_seconds)
        self._fsm.transition_to(CompetitionPhase.FINISHED, reason)
        self._publish_safety_signals(control_enabled=False, emergency_stop=True)
        # Publish state immediately on transition
        self._publish_state()

        # Write results
        try:
            self._result_writer.write()
        except Exception as exc:
            rospy.logerr("Failed to write results: %s", exc)
            self._fsm.force_error(f"Result write failed: {exc}")
            self._publish_safety_signals(control_enabled=False, emergency_stop=True)
            self._publish_state()
            return

        rospy.loginfo("Competition FINISHED. elapsed=%.2f s", self._timer.elapsed_seconds)

    # ------------------------------------------------------------------
    # Service handlers
    # ------------------------------------------------------------------

    def _handle_start(self, req):
        """Handle /competition/start service.

        Manual start cannot bypass safety checks. All of the following
        must be satisfied:
        """
        # 1. Must be in WAITING
        if self._fsm.phase != CompetitionPhase.WAITING:
            return std_srvs.srv.TriggerResponse(
                success=False,
                message=f"Cannot start from phase {CompetitionPhase.label(self._fsm.phase)}",
            )

        # 2. Scene info must be loaded
        if not self._validator.scene_info_loaded:
            return std_srvs.srv.TriggerResponse(
                success=False,
                message="Scene info not loaded — cannot start",
            )

        # 3. Forbidden topic check must be completed and passed
        if not self._validator.forbidden_topic_check_completed:
            return std_srvs.srv.TriggerResponse(
                success=False,
                message="Forbidden topic check not yet completed — cannot start",
            )
        if not self._validator.forbidden_topic_check_passed:
            return std_srvs.srv.TriggerResponse(
                success=False,
                message="Forbidden topic check FAILED — cannot start",
            )

        # 4. ROS time must be valid (check LIVE, not cached)
        if rospy.Time.now().is_zero():
            return std_srvs.srv.TriggerResponse(
                success=False,
                message="/clock not ready (sim time is zero) — cannot start",
            )

        # 5. start_delay must be completed
        if not self._start_delay_done:
            return std_srvs.srv.TriggerResponse(
                success=False,
                message=f"start_delay ({self._start_delay}) not yet completed — cannot start",
            )

        self._start_competition()
        return std_srvs.srv.TriggerResponse(success=True, message="Competition started")

    def _handle_finish(self, req):
        if self._fsm.phase == CompetitionPhase.RUNNING:
            self._end_competition("finish service called")
            return std_srvs.srv.TriggerResponse(success=True, message="Competition finished")
        return std_srvs.srv.TriggerResponse(
            success=False,
            message=f"Cannot finish from phase {CompetitionPhase.label(self._fsm.phase)}",
        )

    # ------------------------------------------------------------------
    # Safety publisher helpers
    # ------------------------------------------------------------------

    def _publish_safety_signals(self, control_enabled: bool, emergency_stop: bool):
        self._control_enabled_pub.publish(std_msgs.msg.Bool(data=control_enabled))
        self._emergency_stop_pub.publish(std_msgs.msg.Bool(data=emergency_stop))

    def _publish_state(self):
        msg = self._fsm.to_msg(
            elapsed_seconds=self._timer.elapsed_seconds,
            detected_count=self._result_writer.candidate_count,
        )
        self._state_pub.publish(msg)

    # ------------------------------------------------------------------
    # Main
    # ------------------------------------------------------------------

    def run(self):
        rospy.loginfo(
            "competition_loop running: state=%s control_enabled=false emergency_stop=true",
            CompetitionPhase.label(self._fsm.phase),
        )
        self._publish_state()
        rospy.spin()


if __name__ == "__main__":
    node = CompetitionLoopNode()
    node.run()
