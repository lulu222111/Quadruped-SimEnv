#!/usr/bin/env python3
"""Safe ROS wrapper for the competition 2D occupancy-grid mapper.

中文说明：
    多楼层 2D 占据栅格建图节点。把定位里程计 + Livox 点云融合成 /competition/map，
    并对外报告 /competition/mapping/status 与当前楼层。

    关键设计：
        1. 每层独立栅格：全部楼层由 FloorMapManager 持有，任一时刻只有一层是
           active。切层只切换 active 指针，绝不把不同楼层的点云混进同一张图。
        2. 楼层过渡 sentinel：收到 /competition/floor_state = -1 时进入 transition，
           暂停建图并作废“跨楼层候选”（旧 epoch 的位姿/点云），电梯运动的垂直
           位移因此不会污染原楼层栅格；到达目标楼层后才恢复。
        3. generation（epoch）失效机制：任何可能使旧缓存输入失效的事件
           （定位失valid、里程计故障/跳变/超时、时间回退、切层）都会开启新
           epoch。待融合点云带 epoch 标记，只有同 epoch 且时间戳新鲜的候选才能
           真正积分，避免“故障期间缓存的数据”被误当作恢复依据。
        4. 所有楼层共用同一套 world 对齐的 XY 几何与原点，使不同楼层的栅格
           索引可比，且首次到访新楼层不会把原点重定位到电梯处。

    合规：楼层信息只来自 /competition/floor_state 显式指令，不从 Gazebo 或
    任何场景文件推断；“地图来源”是定位输出与雷达点云，不含仿真真值。
"""

from __future__ import annotations

import math
import threading
from typing import Dict, List, Optional, Tuple

import rospy
import sensor_msgs.point_cloud2 as point_cloud2
import tf2_ros
from competition_interfaces.msg import ModuleStatus
from nav_msgs.msg import OccupancyGrid, Odometry
from sensor_msgs.msg import PointCloud2
from std_msgs.msg import Int32

from competition_mapping import FloorMapManager, OccupancyGridCore, transform_point_3d


RobotPose = Tuple[float, float, float]
Point3D = Tuple[float, float, float]
PendingCloud = Tuple[PointCloud2, int]


class MappingNode:
    """Latest-only mapper with timestamped TF lookup and generation-based recovery.

    中文：点云采用“latest-only”策略，只保留最新一帧待融合，避免积压；
    TF 查询使用点云自身时间戳，保证运动中的几何一致性。
    """

    def __init__(self) -> None:
        rospy.init_node("mapping_node", log_level=rospy.INFO)
        self._lock = threading.RLock()

        self._odom_topic = rospy.get_param("~odom_topic", "/competition/localization/odom")
        self._localization_status_topic = rospy.get_param(
            "~localization_status_topic", "/competition/localization/status"
        )
        self._pointcloud_topic = rospy.get_param("~pointcloud_topic", "/livox/Pointcloud2")
        self._map_topic = rospy.get_param("~map_topic", "/competition/map")
        self._mapping_status_topic = rospy.get_param(
            "~mapping_status_topic", "/competition/mapping/status"
        )
        # Compatibility adapter until the team freezes a richer FloorState
        # message.  Int32(-1) means "elevator transition in progress" and a
        # non-negative value means "stable on this floor".  Both names are
        # parameters so the adapter can be replaced without touching the
        # ROS-independent per-floor storage.
        # 中文：暂时的 Int32 楼层协议：-1 = 电梯过渡中（暂停建图），
        # 非负值 = 已稳定在该楼层。topic/参数名可配置，便于日后替换为
        # 结构化 FloorState 消息而不改动底层按层存储。
        self._floor_state_topic = str(rospy.get_param(
            "~floor_state_topic", "/competition/floor_state"
        ))
        self._current_floor_topic = str(rospy.get_param(
            "~current_floor_topic", "/competition/mapping/current_floor"
        ))
        self._initial_floor = int(rospy.get_param("~initial_floor", 0))
        self._transition_floor_value = int(rospy.get_param(
            "~transition_floor_value", -1
        ))
        self._max_floor_id = int(rospy.get_param("~max_floor_id", 31))

        self._map_frame = self._normalise_frame(rospy.get_param("~map_frame", "world"))
        self._expected_base_frame = self._normalise_frame(
            rospy.get_param("~expected_base_frame", "base")
        )
        self._expected_cloud_frame = self._normalise_frame(
            rospy.get_param("~expected_cloud_frame", "laser_livox")
        )
        self._origin_mode = str(rospy.get_param("~origin_mode", "initial_pose"))
        self._resolution = float(rospy.get_param("~resolution", 0.1))
        self._map_width = int(rospy.get_param("~map_width", 400))
        self._map_height = int(rospy.get_param("~map_height", 400))
        self._fixed_origin_x = float(rospy.get_param("~origin_x", -20.0))
        self._fixed_origin_y = float(rospy.get_param("~origin_y", -20.0))
        self._origin_x = self._fixed_origin_x
        self._origin_y = self._fixed_origin_y

        self._min_range = float(rospy.get_param("~sensor_min_range", 0.3))
        self._max_range = float(rospy.get_param("~sensor_max_range", 20.0))
        self._min_height = float(rospy.get_param("~min_height", -0.5))
        self._max_height = float(rospy.get_param("~max_height", 1.5))
        self._point_stride = int(rospy.get_param("~point_stride", 1))
        self._max_points = int(rospy.get_param("~max_points_per_cloud", 50000))

        self._odom_timeout = float(rospy.get_param("~odom_timeout", 1.0))
        self._status_timeout = float(rospy.get_param("~localization_status_timeout", 1.0))
        self._pointcloud_timeout = float(rospy.get_param("~pointcloud_timeout", 1.0))
        self._integration_rate = float(rospy.get_param("~integration_rate", 5.0))
        self._map_publish_rate = float(rospy.get_param("~map_publish_rate", 2.0))
        self._status_rate = float(rospy.get_param("~status_heartbeat_rate", 10.0))
        self._tf_timeout = float(rospy.get_param("~tf_timeout", 0.1))
        self._max_input_age = float(rospy.get_param("~max_input_age", 2.0))
        self._future_tolerance = float(rospy.get_param("~future_stamp_tolerance", 0.2))
        self._time_rollback_tolerance = float(
            rospy.get_param("~time_rollback_tolerance", 0.001)
        )
        self._quaternion_tolerance = float(
            rospy.get_param("~quaternion_norm_tolerance", 0.1)
        )
        self._max_pose_jump = float(rospy.get_param("~max_pose_jump", 2.0))
        self._max_yaw_jump = float(rospy.get_param("~max_yaw_jump", 1.57))
        self._pose_recovery_samples = int(rospy.get_param("~pose_recovery_samples", 3))
        self._reset_map_on_pose_jump = bool(rospy.get_param("~reset_map_on_pose_jump", True))
        self._validate_parameters()

        self._floor_maps = FloorMapManager(
            lambda: self._make_grid(self._origin_x, self._origin_y),
            initial_floor=self._initial_floor,
        )
        self._transition_active = False
        self._target_floor: Optional[int] = None
        self._origin_ready = self._origin_mode == "fixed"
        self._tf_buffer = tf2_ros.Buffer(cache_time=rospy.Duration(10.0))
        self._tf_listener = tf2_ros.TransformListener(self._tf_buffer)

        self._input_epoch = 0
        # Changes whenever the published map definition or cell contents change.
        # It lets the map timer reject a snapshot that became stale while the
        # OccupancyGrid message was being constructed outside the lock.
        self._map_version = 0
        self._fault_active = False
        self._fault_state = ModuleStatus.BLOCKED
        self._fault_detail = "waiting for inputs"
        self._healthy_inputs_since: Optional[rospy.Time] = None
        self._last_ros_time: Optional[rospy.Time] = None

        self._last_status_received_at: Optional[rospy.Time] = None
        self._last_status_stamp: Optional[rospy.Time] = None
        self._status_epoch = -1
        self._localization_valid = False
        self._localization_detail = "localization status not received"

        self._last_odom_received_at: Optional[rospy.Time] = None
        self._last_odom_stamp: Optional[rospy.Time] = None
        self._odom_epoch = -1
        self._odom_valid = False
        self._odom_failure_state = ModuleStatus.STARTING
        self._odom_detail = "odometry not received"
        self._latest_pose: Optional[RobotPose] = None
        self._accepted_pose: Optional[RobotPose] = None
        self._pending_jump_pose: Optional[RobotPose] = None
        self._jump_stable_count = 0
        self._jump_fault_active = False

        self._pending_cloud: Optional[PendingCloud] = None
        self._last_cloud_received_at: Optional[rospy.Time] = None
        self._last_cloud_accepted_stamp: Optional[rospy.Time] = None
        self._last_cloud_integrated_stamp: Optional[rospy.Time] = None
        self._last_cloud_integrated_at: Optional[rospy.Time] = None
        self._last_integrated_epoch = -1
        self._pointcloud_failure_state = ModuleStatus.STARTING
        self._pointcloud_detail = "point cloud not received"

        self._map_initialized = False
        self._map_load_time: Optional[rospy.Time] = None
        self._last_scan_stats = self._empty_stats()
        self._last_reported_status = None
        self._cloud_metrics: Dict[str, float] = {
            "clouds_received": 0,
            "clouds_replaced": 0,
            "clouds_rejected": 0,
            "clouds_integrated": 0,
            "last_integration_duration": 0.0,
            "last_valid_point_count": 0,
        }

        self._map_pub = rospy.Publisher(self._map_topic, OccupancyGrid, queue_size=1, latch=True)
        self._status_pub = rospy.Publisher(
            self._mapping_status_topic, ModuleStatus, queue_size=10, latch=True
        )
        self._current_floor_pub = rospy.Publisher(
            self._current_floor_topic, Int32, queue_size=1, latch=True
        )
        self._odom_sub = rospy.Subscriber(
            self._odom_topic, Odometry, self._odom_callback, queue_size=20
        )
        self._status_sub = rospy.Subscriber(
            self._localization_status_topic, ModuleStatus,
            self._localization_status_callback, queue_size=20,
        )
        self._cloud_sub = rospy.Subscriber(
            self._pointcloud_topic, PointCloud2, self._pointcloud_callback,
            queue_size=1, buff_size=32 * 1024 * 1024,
        )
        self._floor_state_sub = None
        if self._floor_state_topic:
            self._floor_state_sub = rospy.Subscriber(
                self._floor_state_topic, Int32, self._floor_state_callback,
                queue_size=10,
            )
        self._integration_timer = rospy.Timer(
            rospy.Duration(1.0 / self._integration_rate),
            self._integration_callback,
            reset=True,
        )

        self._status_timer = rospy.Timer(
            rospy.Duration(1.0 / self._status_rate),
            self._status_timer_callback,
            reset=True,
        )

        self._map_timer = rospy.Timer(
            rospy.Duration(1.0 / self._map_publish_rate),
            self._map_timer_callback,
            reset=True,
        )
        self._publish_current_floor_locked()
        rospy.loginfo(
            "mapping_node ready: frames=%s/%s/%s map=%dx%d@%.3fm origin=%s floor=%d",
            self._map_frame, self._expected_base_frame, self._expected_cloud_frame,
            self._map_width, self._map_height, self._resolution, self._origin_mode,
            self._floor_maps.current_floor,
        )

    def _make_grid(self, origin_x: float, origin_y: float) -> OccupancyGridCore:
        return OccupancyGridCore(
            self._resolution, self._map_width, self._map_height,
            origin_x, origin_y, self._min_range, self._max_range,
            self._min_height, self._max_height,
        )

    # Keep the well-tested single-floor code paths small by mapping the former
    # scalar attributes onto the active FloorMapState.  Switching floors changes
    # these properties atomically without copying occupancy data.
    # 中文：把原单楼层版本的“标量栅格属性”映射到当前 active FloorMapState，
    # 使既有单楼层代码路径无需改动；切层只是切换代理目标，不拷贝栅格数据。
    @property
    def _grid(self):
        return self._floor_maps.current.grid

    @_grid.setter
    def _grid(self, value):
        self._floor_maps.current.grid = value

    @property
    def _map_initialized(self):
        return self._floor_maps.current.initialized

    @_map_initialized.setter
    def _map_initialized(self, value):
        self._floor_maps.current.initialized = bool(value)

    @property
    def _map_load_time(self):
        return self._floor_maps.current.load_time

    @_map_load_time.setter
    def _map_load_time(self, value):
        self._floor_maps.current.load_time = value

    @property
    def _last_scan_stats(self):
        value = self._floor_maps.current.last_scan_stats
        return self._empty_stats() if value is None else value

    @_last_scan_stats.setter
    def _last_scan_stats(self, value):
        self._floor_maps.current.last_scan_stats = value

    @staticmethod
    def _empty_stats():
        return {
            "input_points": 0, "total_points": 0, "non_finite_rejected": 0,
            "range_rejected": 0, "height_rejected": 0, "valid_points": 0,
            "rejected_points": 0, "occupied_endpoints": 0,
            "free_cells_updated": 0, "changed_cells": 0, "robot_outside_map": 0,
        }

    def _validate_parameters(self) -> None:
        positive = {
            "integration_rate": self._integration_rate,
            "map_publish_rate": self._map_publish_rate,
            "status_heartbeat_rate": self._status_rate,
            "odom_timeout": self._odom_timeout,
            "localization_status_timeout": self._status_timeout,
            "pointcloud_timeout": self._pointcloud_timeout,
            "tf_timeout": self._tf_timeout,
            "max_input_age": self._max_input_age,
            "future_stamp_tolerance": self._future_tolerance,
            "quaternion_norm_tolerance": self._quaternion_tolerance,
            "max_pose_jump": self._max_pose_jump,
            "max_yaw_jump": self._max_yaw_jump,
        }
        for name, value in positive.items():
            if not math.isfinite(value) or value <= 0.0:
                raise ValueError("~{} must be finite and > 0".format(name))
        if not math.isfinite(self._time_rollback_tolerance) or self._time_rollback_tolerance < 0:
            raise ValueError("~time_rollback_tolerance must be finite and >= 0")
        if self._map_frame != "world":
            raise ValueError("~map_frame must be 'world' for the frozen interface")
        if self._expected_base_frame != "base":
            raise ValueError("~expected_base_frame must be 'base' for the frozen interface")
        if self._expected_cloud_frame != "laser_livox":
            raise ValueError(
                "~expected_cloud_frame must be 'laser_livox' for the frozen interface"
            )
        if self._origin_mode not in ("initial_pose", "fixed"):
            raise ValueError("~origin_mode must be 'initial_pose' or 'fixed'")
        if self._point_stride <= 0 or self._max_points <= 0:
            raise ValueError("point_stride and max_points_per_cloud must be > 0")
        if self._pose_recovery_samples <= 0:
            raise ValueError("pose_recovery_samples must be > 0")
        if self._initial_floor < 0:
            raise ValueError("initial_floor must be >= 0")
        if self._max_floor_id < self._initial_floor:
            raise ValueError("max_floor_id must be >= initial_floor")
        if self._transition_floor_value >= 0:
            raise ValueError("transition_floor_value must be negative")
        if not self._current_floor_topic:
            raise ValueError("current_floor_topic must not be empty")

    def _publish_current_floor_locked(self) -> None:
        publisher = getattr(self, "_current_floor_pub", None)
        if publisher is not None:
            publisher.publish(Int32(data=self._floor_maps.current_floor))

    def _floor_state_callback(self, msg: Int32) -> None:
        """Handle the provisional integer floor-state adapter.

        The transition sentinel must be published before elevator movement.
        A stable non-negative floor must be published only after arrival.  The
        callback deliberately never infers floors from Gazebo or scene files.

        中文：楼层状态只由显式指令驱动 —— 电梯运动前必须先收到 sentinel(-1)，
        到达后才允许收到非负目标楼层。本回调绝不从 Gazebo 或场景文件推断楼层。
        """
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            value = int(msg.data)
            if value == self._transition_floor_value:
                self._begin_floor_transition_locked()
                return
            if value < 0 or value > self._max_floor_id:
                rospy.logwarn(
                    "ignoring invalid floor state %d (allowed 0..%d or transition %d)",
                    value, self._max_floor_id, self._transition_floor_value,
                )
                return
            if self._transition_active or value != self._floor_maps.current_floor:
                self._finish_floor_transition_locked(value)

    def _invalidate_inputs_for_floor_change_locked(self) -> None:
        """Open a new generation and remove every cross-floor candidate.

        中文：开启新 epoch 并清空所有“跨楼层不可信”的缓存：定位/里程计有效性、
        最新位姿、待融合点云、跳变恢复计数等。切层与时序回退共用此边界，
        保证旧楼层的数据无法泄漏进新楼层栅格。
        """
        self._input_epoch += 1
        self._healthy_inputs_since = None
        self._localization_valid = False
        self._status_epoch = -1
        self._odom_valid = False
        self._odom_epoch = -1
        self._latest_pose = None
        self._accepted_pose = None
        self._pending_jump_pose = None
        self._jump_stable_count = 0
        self._jump_fault_active = False
        self._pending_cloud = None
        self._last_integrated_epoch = -1
        self._pointcloud_failure_state = ModuleStatus.BLOCKED
        self._pointcloud_detail = "new point cloud required after floor change"
        self._fault_active = False
        self._fault_state = ModuleStatus.BLOCKED
        self._fault_detail = ""

    def _begin_floor_transition_locked(self, target_floor: Optional[int] = None) -> None:
        # 中文：进入楼层过渡 —— 暂停建图、作废跨层候选、递增 map_version。
        # 幂等：过渡中再次收到 sentinel 只更新目标楼层，不重复作废。
        if target_floor is not None:
            target_floor = int(target_floor)
            if target_floor < 0 or target_floor > self._max_floor_id:
                raise ValueError("target floor is outside configured range")
        if self._transition_active:
            if target_floor is not None:
                self._target_floor = target_floor
            return
        self._transition_active = True
        self._target_floor = target_floor
        self._invalidate_inputs_for_floor_change_locked()
        self._map_version += 1
        rospy.loginfo(
            "mapping paused for elevator transition: current_floor=%d target_floor=%s",
            self._floor_maps.current_floor,
            "unknown" if target_floor is None else str(target_floor),
        )

    def _finish_floor_transition_locked(self, floor_id: int) -> None:
        floor_id = int(floor_id)
        if floor_id < 0 or floor_id > self._max_floor_id:
            raise ValueError("floor is outside configured range")
        previous_floor = self._floor_maps.current_floor
        # A direct stable-floor change is accepted for deterministic tests and
        # recovery, but it still opens two boundaries so pre-change data cannot
        # leak into the new layer.
        # 中文：为兼容确定性测试与故障恢复，允许不经 sentinel 直接切到稳定楼层；
        # 但仍会补一次过渡边界，确保切换前的数据不进入新楼层栅格。
        if not self._transition_active and floor_id != previous_floor:
            self._begin_floor_transition_locked(target_floor=floor_id)
        self._floor_maps.switch_floor(floor_id)
        self._transition_active = False
        self._target_floor = None
        self._invalidate_inputs_for_floor_change_locked()
        self._map_version += 1
        self._publish_current_floor_locked()
        rospy.loginfo(
            "mapping floor activated: previous=%d current=%d restored=%s",
            previous_floor, floor_id, self._map_initialized,
        )

    def _localization_status_callback(self, msg: ModuleStatus) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            # Elevator motion is an intentional safety boundary.  Inputs
            # produced inside it are neither recovery evidence nor faults for a
            # particular floor; only post-arrival messages may reopen mapping.
            if self._transition_active:
                return
            valid_stamp, detail = self._validate_stamp_locked(
                "localization status", msg.header.stamp, now, self._last_status_stamp
            )
            self._last_status_received_at = now
            if not valid_stamp:
                self._enter_fault_locked(
                    detail,
                    fault_state=ModuleStatus.BLOCKED,
                )
                self._localization_valid = False
                self._localization_detail = detail
                return
            self._last_status_stamp = msg.header.stamp
            if not bool(msg.valid):
                # ModuleStatus.valid is the authoritative usability gate.
                # state only explains the reason; a non-RUNNING state alone
                # must not invalidate a usable localization.
                detail = "localization unavailable: " + (
                    msg.detail or "state={}, valid={}".format(msg.state, msg.valid)
                )

                if msg.state == ModuleStatus.TIMEOUT:
                    fault_state = ModuleStatus.TIMEOUT
                elif msg.state == ModuleStatus.FAILED:
                    fault_state = ModuleStatus.FAILED
                else:
                    fault_state = ModuleStatus.BLOCKED

                # Entering an already active fault generation must not open
                # a new generation: continued invalid heartbeats only refresh
                # fault state/detail and receive timestamps, and must not keep
                # invalidating current-generation candidates.
                self._enter_fault_locked(
                    detail,
                    fault_state=fault_state,
                )
                self._localization_valid = False
                self._last_status_stamp = msg.header.stamp
                self._last_status_received_at = now
                self._status_epoch = self._input_epoch
                self._localization_detail = msg.detail or "localization unavailable"
                return
            self._localization_valid = True
            self._localization_detail = msg.detail or "localization valid"
            self._status_epoch = self._input_epoch
            if self._odom_valid and self._odom_epoch == self._input_epoch:
                self._initialize_origin_locked(self._latest_pose)
                self._mark_healthy_inputs_locked(now)

    def _odom_callback(self, msg: Odometry) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            # In particular, do not let an elevator-induced pose discontinuity
            # trigger reset_map_on_pose_jump on the floor being left.
            if self._transition_active:
                return
            stamp_valid, stamp_detail = self._validate_stamp_locked(
                "odometry", msg.header.stamp, now, self._last_odom_stamp
            )
            self._last_odom_received_at = now
            if not stamp_valid:
                # A new odometry fault must invalidate any odometry candidate
                # cached earlier in the same fault generation: force a new
                # generation so the stale candidate can never satisfy recovery.
                self._enter_fault_locked(
                    stamp_detail,
                    force_new_epoch=True,
                    fault_state=ModuleStatus.BLOCKED,
                )
                self._odom_failure_state = ModuleStatus.BLOCKED
                self._odom_detail = stamp_detail
                return

            # Keep validation and state mutation in the same critical section.
            # Otherwise two odometry callbacks can interleave after timestamp
            # validation and accept an out-of-order sample.
            valid, state, detail, pose = self._validate_odometry_message(msg)
            self._last_odom_received_at = now
            self._last_odom_stamp = msg.header.stamp
            if not valid or pose is None:
                # Invalid frame / quaternion / non-finite odometry is a new
                # odometry fault: invalidate any candidate cached earlier in
                # the same fault generation by forcing a new generation.
                self._enter_fault_locked(
                    detail,
                    force_new_epoch=True,
                    fault_state=state,
                )
                self._last_odom_received_at = now
                self._last_odom_stamp = msg.header.stamp
                self._odom_failure_state = state
                self._odom_detail = detail
                return

            valid, state, detail = self._apply_pose_jump_guard_locked(pose)
            if not valid:
                if not self._jump_fault_active:
                    self._jump_fault_active = True
                    # A pose jump is a new odometry fault: invalidate any
                    # odometry candidate cached earlier in the same fault
                    # generation by forcing a new generation.
                    self._enter_fault_locked(
                        detail,
                        force_new_epoch=True,
                        reset_map=self._reset_map_on_pose_jump,
                        reset_origin=self._origin_mode == "initial_pose",
                        fault_state=state,
                    )
                    self._last_odom_received_at = now
                    self._last_odom_stamp = msg.header.stamp
                self._odom_failure_state = state
                self._odom_detail = detail
                return

            self._jump_fault_active = False
            self._odom_valid = True
            self._odom_epoch = self._input_epoch
            self._odom_failure_state = state
            self._odom_detail = detail
            self._latest_pose = pose
            if self._localization_valid and self._status_epoch == self._input_epoch:
                self._initialize_origin_locked(pose)
                self._mark_healthy_inputs_locked(now)

    def _apply_pose_jump_guard_locked(self, pose: RobotPose):
        # 中文：位姿跳变保护。单帧跳变不立即采信，而是要求跳变后的位姿在
        # 连续 pose_recovery_samples 帧内保持稳定才判定“恢复”，期间上报
        # BLOCKED 并暂停积分；恢复后要求提供新点云，避免用旧点云配新位姿。
        if self._accepted_pose is None:
            self._accepted_pose = pose
            return True, ModuleStatus.READY, "odometry valid"
        distance = math.hypot(pose[0] - self._accepted_pose[0], pose[1] - self._accepted_pose[1])
        yaw_delta = abs(self._angle_difference(pose[2], self._accepted_pose[2]))
        if distance <= self._max_pose_jump and yaw_delta <= self._max_yaw_jump:
            if self._pending_jump_pose is None:
                self._accepted_pose = pose
                return True, ModuleStatus.READY, "odometry valid"
            pending_distance = math.hypot(
                pose[0] - self._pending_jump_pose[0], pose[1] - self._pending_jump_pose[1]
            )
            pending_yaw = abs(self._angle_difference(pose[2], self._pending_jump_pose[2]))
            if pending_distance > self._max_pose_jump or pending_yaw > self._max_yaw_jump:
                self._pending_jump_pose = pose
                self._jump_stable_count = 1
            else:
                self._pending_jump_pose = pose
                self._jump_stable_count += 1
        elif self._pending_jump_pose is None:
            self._pending_jump_pose = pose
            self._jump_stable_count = 1
        else:
            pending_distance = math.hypot(
                pose[0] - self._pending_jump_pose[0], pose[1] - self._pending_jump_pose[1]
            )
            pending_yaw = abs(self._angle_difference(pose[2], self._pending_jump_pose[2]))
            if pending_distance <= self._max_pose_jump and pending_yaw <= self._max_yaw_jump:
                self._pending_jump_pose = pose
                self._jump_stable_count += 1
            else:
                self._pending_jump_pose = pose
                self._jump_stable_count = 1

        if self._jump_stable_count < self._pose_recovery_samples:
            return False, ModuleStatus.BLOCKED, (
                "odometry jump detected ({:.2f}m, {:.2f}rad); recovery {}/{}"
            ).format(distance, yaw_delta, self._jump_stable_count, self._pose_recovery_samples)

        self._accepted_pose = pose
        self._pending_jump_pose = None
        self._jump_stable_count = 0
        return True, ModuleStatus.READY, "pose recovered; new point cloud required"

    def _validate_odometry_message(self, msg: Odometry):
        odom_frame = self._normalise_frame(msg.header.frame_id)
        base_frame = self._normalise_frame(msg.child_frame_id)
        if odom_frame != self._map_frame:
            return False, ModuleStatus.BLOCKED, (
                "odometry frame '{}' != '{}'".format(odom_frame, self._map_frame)
            ), None
        if base_frame != self._expected_base_frame:
            return False, ModuleStatus.BLOCKED, (
                "odometry child frame '{}' != '{}'".format(base_frame, self._expected_base_frame)
            ), None
        p = msg.pose.pose.position
        q = msg.pose.pose.orientation
        values = (p.x, p.y, p.z, q.x, q.y, q.z, q.w)
        if not all(math.isfinite(v) for v in values):
            return False, ModuleStatus.FAILED, "odometry contains NaN or Inf", None
        norm = math.sqrt(q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w)
        if norm < 1.0e-6:
            return False, ModuleStatus.FAILED, "odometry quaternion has zero norm", None
        if abs(norm - 1.0) > self._quaternion_tolerance:
            return False, ModuleStatus.FAILED, (
                "odometry quaternion norm {:.4f}".format(norm)
            ), None
        yaw = math.atan2(2.0*(q.w*q.z + q.x*q.y), 1.0 - 2.0*(q.y*q.y + q.z*q.z))
        return True, ModuleStatus.READY, "odometry valid", (float(p.x), float(p.y), yaw)

    def _pointcloud_callback(self, msg: PointCloud2) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            self._cloud_metrics["clouds_received"] += 1
            self._last_cloud_received_at = now
            if self._transition_active:
                self._reject_cloud_locked(
                    "point cloud rejected during elevator transition"
                )
                return
            cloud_frame = self._normalise_frame(msg.header.frame_id)
            if cloud_frame != self._expected_cloud_frame:
                self._reject_cloud_locked(
                    "point cloud frame '{}' != '{}'".format(
                        cloud_frame, self._expected_cloud_frame
                    )
                )
                return
            valid_stamp, detail = self._validate_stamp_locked(
                "point cloud", msg.header.stamp, now, self._last_cloud_accepted_stamp,
                max_age=self._pointcloud_timeout,
            )
            if not valid_stamp:
                self._reject_cloud_locked(detail)
                return
            if self._pending_cloud is not None:
                self._cloud_metrics["clouds_replaced"] += 1
            # Tag the candidate with the current generation.  Clouds received
            # while localization is invalid are cached as candidates of that
            # generation but must not be consumed until recovery; the
            # integration timer re-validates them right before fusing.
            self._pending_cloud = (msg, self._input_epoch)
            self._last_cloud_accepted_stamp = msg.header.stamp
            self._pointcloud_detail = "point cloud pending integration"

    def _integration_callback(self, _event) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            if self._pending_cloud is None:
                return
            msg, epoch = self._pending_cloud
            usable, reason = self._pending_cloud_usable_locked(now, msg, epoch)
            if not usable:
                self._pending_cloud = None
                self._reject_cloud_locked(reason)
                return
            allowed, reason = self._integration_allowed_locked(now, epoch)
            if not allowed:
                # The pending cloud is still a valid current-generation
                # candidate; only localization/odometry usability is missing.
                # Keep it (latest-only) instead of consuming and rejecting it,
                # so recovery does not depend on a fresh cloud arriving after
                # localization becomes valid again.
                return
            self._pending_cloud = None

        started = rospy.get_time()
        try:
            world_base = self._tf_buffer.lookup_transform(
                self._map_frame, self._expected_base_frame, msg.header.stamp,
                rospy.Duration(self._tf_timeout),
            )
            base_cloud = self._tf_buffer.lookup_transform(
                self._expected_base_frame, self._expected_cloud_frame, msg.header.stamp,
                rospy.Duration(self._tf_timeout),
            )
            pose = self._pose_from_transform(world_base)
            points = self._extract_points(msg)
            points = self._transform_points(points, base_cloud)
        except (tf2_ros.LookupException, tf2_ros.ConnectivityException,
                tf2_ros.ExtrapolationException) as error:
            with self._lock:
                detail = "point-cloud timestamp TF unavailable: {}".format(error)
                self._enter_fault_locked(
                    detail,
                    fault_state=ModuleStatus.BLOCKED,
                )
                self._pointcloud_failure_state = ModuleStatus.BLOCKED
                self._pointcloud_detail = detail
                if not self._requeue_pending_cloud_locked(msg, epoch):
                    self._cloud_metrics["clouds_rejected"] += 1
            return
        except Exception as error:
            with self._lock:
                detail = "point-cloud decode/transform failed: {}".format(error)
                self._enter_fault_locked(
                    detail,
                    fault_state=ModuleStatus.FAILED,
                )
                self._pointcloud_failure_state = ModuleStatus.FAILED
                self._pointcloud_detail = detail
                self._cloud_metrics["clouds_rejected"] += 1
            return

        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            # Being fresh at receive time does not make a cached candidate
            # usable forever: re-verify generation, frame and timestamp
            # freshness immediately before fusing.
            usable, reason = self._pending_cloud_usable_locked(now, msg, epoch)
            if not usable:
                self._reject_cloud_locked(reason)
                return
            allowed, reason = self._integration_allowed_locked(now, epoch)
            if not allowed:
                self._requeue_pending_cloud_locked(msg, epoch)
                return
            self._initialize_origin_locked(pose)
            if not self._origin_ready:
                self._reject_cloud_locked("waiting for initial pose map origin")
                return
            try:
                stats = self._grid.integrate_scan(pose[0], pose[1], pose[2], points)
            except Exception as error:
                detail = "map update failed: {}".format(error)
                self._enter_fault_locked(
                    detail,
                    fault_state=ModuleStatus.FAILED,
                )
                self._pointcloud_failure_state = ModuleStatus.FAILED
                self._pointcloud_detail = detail
                return
            self._map_version += 1
            self._last_scan_stats = stats
            self._cloud_metrics["last_integration_duration"] = max(
                0.0, rospy.get_time() - started
            )
            self._cloud_metrics["last_valid_point_count"] = stats["valid_points"]
            if stats["valid_points"] <= 0 or stats["robot_outside_map"]:
                self._reject_cloud_locked("all points rejected or robot outside map")
                return
            self._cloud_metrics["clouds_integrated"] += 1
            self._last_cloud_integrated_stamp = msg.header.stamp
            self._last_cloud_integrated_at = now
            self._last_integrated_epoch = epoch
            self._pointcloud_failure_state = ModuleStatus.RUNNING
            self._pointcloud_detail = "point cloud integrated"
            self._fault_active = False
            self._fault_state = ModuleStatus.BLOCKED
            self._fault_detail = ""
            if not self._map_initialized and (
                stats["free_cells_updated"] > 0 or stats["occupied_endpoints"] > 0
            ):
                self._map_initialized = True
                self._map_load_time = now

    def _integration_allowed_locked(self, now: rospy.Time, epoch: int):
        if self._transition_active:
            return False, "mapping paused during elevator transition"
        if epoch != self._input_epoch:
            return False, "pending point cloud belongs to an old epoch"
        if not self._localization_valid or self._status_epoch != epoch:
            return False, "waiting for new valid localization status"
        if not self._odom_valid or self._odom_epoch != epoch:
            return False, "waiting for new valid odometry"
        if self._last_status_received_at is None or self._last_odom_received_at is None:
            return False, "localization status or odometry missing"
        if self._age(now, self._last_status_received_at) > self._status_timeout:
            return False, "localization status timed out"
        if self._age(now, self._last_odom_received_at) > self._odom_timeout:
            return False, "odometry timed out"
        return True, "inputs valid"

    def _pending_cloud_usable_locked(self, now: rospy.Time, msg: PointCloud2, epoch: int):
        """Re-validate a cached pending cloud right before integration.

        Acceptance at receive time does not make a cloud usable forever.
        Before it may be fused, re-verify the current generation, the frame
        and that the timestamp is non-zero, not in the future and not stale
        with respect to pointcloud_timeout.  TF availability is verified
        separately during the timestamped lookup itself.

        中文：接收时通过校验不等于永久可用。真正积分前必须重新校验 epoch、
        坐标系与时间戳新鲜度；TF 可用性在带时间戳的查询里单独验证。
        """
        if epoch != self._input_epoch:
            return False, "pending point cloud belongs to an old epoch"
        cloud_frame = self._normalise_frame(msg.header.frame_id)
        if cloud_frame != self._expected_cloud_frame:
            return False, "pending point cloud frame '{}' != '{}'".format(
                cloud_frame, self._expected_cloud_frame
            )
        if msg.header.stamp == rospy.Time():
            return False, "pending point cloud timestamp is zero"
        age = (now - msg.header.stamp).to_sec()
        if age < -self._future_tolerance:
            return False, "pending point cloud timestamp is {:.3f}s in the future".format(
                -age
            )
        if age > self._pointcloud_timeout:
            return False, "pending point cloud timestamp is {:.3f}s old".format(age)
        return True, "pending point cloud fresh"

    def _requeue_pending_cloud_locked(self, msg: PointCloud2, epoch: int) -> bool:
        """Keep a consumed cloud as the latest pending candidate.

        Only when it still belongs to the current generation and no newer
        cloud has arrived meanwhile; otherwise the cloud is dropped.
        """
        if epoch == self._input_epoch and self._pending_cloud is None:
            self._pending_cloud = (msg, epoch)
            return True
        return False

    def _extract_points(self, msg: PointCloud2) -> List[Point3D]:
        points: List[Point3D] = []
        for index, point in enumerate(point_cloud2.read_points(
            msg, field_names=("x", "y", "z"), skip_nans=False
        )):
            if index % self._point_stride:
                continue
            points.append((float(point[0]), float(point[1]), float(point[2])))
            if len(points) >= self._max_points:
                break
        return points

    @staticmethod
    def _transform_points(points: List[Point3D], stamped_transform) -> List[Point3D]:
        transform = stamped_transform.transform
        t = transform.translation
        q = transform.rotation
        translation = (t.x, t.y, t.z)
        quaternion = (q.x, q.y, q.z, q.w)
        return [transform_point_3d(point, translation, quaternion) for point in points]

    def _pose_from_transform(self, stamped_transform) -> RobotPose:
        transform = stamped_transform.transform
        t = transform.translation
        q = transform.rotation
        values = (t.x, t.y, t.z, q.x, q.y, q.z, q.w)
        if not all(math.isfinite(value) for value in values):
            raise ValueError("world->base transform contains NaN or Inf")
        norm = math.sqrt(q.x*q.x + q.y*q.y + q.z*q.z + q.w*q.w)
        if norm < 1.0e-6 or abs(norm - 1.0) > self._quaternion_tolerance:
            raise ValueError("world->base transform has invalid quaternion")
        yaw = math.atan2(2.0*(q.w*q.z + q.x*q.y), 1.0 - 2.0*(q.y*q.y + q.z*q.z))
        return float(t.x), float(t.y), yaw

    def _initialize_origin_locked(self, pose: Optional[RobotPose]) -> None:
        if self._origin_ready or pose is None:
            return
        self._origin_x = pose[0] - self._map_width * self._resolution / 2.0
        self._origin_y = pose[1] - self._map_height * self._resolution / 2.0
        # All floors share the same world-aligned XY geometry.  This keeps cell
        # indices comparable and prevents a new origin being centred on the
        # elevator every time a floor is first visited.
        # 中文：所有楼层共用 world 对齐的 XY 几何与原点，使不同楼层栅格索引
        # 具有可比性；同时避免每次首访新楼层都把原点重新定在电梯位置。
        # rebuild_all 会按新原点重建全部楼层的栅格。
        self._floor_maps.rebuild_all(
            lambda: self._make_grid(self._origin_x, self._origin_y)
        )
        self._map_version += 1
        self._origin_ready = True
        rospy.loginfo("map origin initialized at (%.3f, %.3f)", self._origin_x, self._origin_y)

    def _enter_fault_locked(
        self,
        detail: str,
        force_new_epoch: bool = False,
        reset_map: bool = False,
        reset_origin: bool = False,
        fault_state: int = ModuleStatus.BLOCKED,
    ) -> None:
        """Enter or refresh the current fault generation.

        A new local generation is opened on the healthy -> fault transition.
        Faults that invalidate previously cached input candidates (a new
        odometry fault: invalid timestamp, invalid frame/quaternion/non-finite
        values, pose jump or odometry timeout) pass force_new_epoch=True and
        open a new generation even while a fault generation is already active,
        so the stale candidate can never satisfy recovery.  Fault reports
        without force_new_epoch (e.g. continued localization valid=false
        heartbeats) only update the fault state/detail pair and receive
        timestamps; they must not keep creating generations nor keep
        invalidating current-generation candidates.

        fault state and detail always form a pair and describe the most
        recent explicit fault report; without a new fault event both keep
        their previous values.

        中文：进入或刷新“当前故障世代”。
        force_new_epoch=True 用于那些必须让已缓存输入作废的故障（里程计时间戳
        非法、坐标系/四元数/非有限值、位姿跳变、里程计超时），即使已在故障中
        也要再开新世代，使旧候选永远无法满足恢复条件；
        不带 force_new_epoch 的重复故障上报（如定位持续 valid=false 心跳）只
        刷新故障状态与详情，避免不断制造新世代、反复作废当前候选。
        reset_map / reset_origin 控制是否需要清空栅格或重新标定原点。
        """
        if force_new_epoch or not self._fault_active:
            self._input_epoch += 1
            self._healthy_inputs_since = None
            self._localization_valid = False
            self._status_epoch = -1
            self._odom_valid = False
            self._odom_epoch = -1
            self._latest_pose = None
            self._pending_cloud = None
            self._last_integrated_epoch = -1
        self._fault_state = fault_state
        self._fault_active = True
        self._fault_detail = detail
        if reset_map:
            self._grid.reset()
            self._map_version += 1
            self._map_initialized = False
            self._map_load_time = None
            self._last_scan_stats = self._empty_stats()
        if reset_origin:
            self._origin_ready = False

    def _reset_for_time_rollback_locked(self, now: rospy.Time) -> None:
        self._input_epoch += 1
        self._fault_active = True
        self._fault_state = ModuleStatus.TIMEOUT
        self._fault_detail = "ROS time moved backwards; waiting for a new input epoch"
        self._healthy_inputs_since = None
        self._last_status_received_at = None
        self._last_status_stamp = None
        self._status_epoch = -1
        self._localization_valid = False
        self._last_odom_received_at = None
        self._last_odom_stamp = None
        self._odom_epoch = -1
        self._odom_valid = False
        self._latest_pose = None
        self._accepted_pose = None
        self._pending_jump_pose = None
        self._jump_stable_count = 0
        self._jump_fault_active = False
        self._pending_cloud = None
        self._last_cloud_received_at = None
        self._last_cloud_accepted_stamp = None
        self._last_cloud_integrated_stamp = None
        self._last_cloud_integrated_at = None
        self._last_integrated_epoch = -1
        # A ROS-time rollback starts a new simulation timeline.  Historical
        # layers from the old timeline must never survive it.
        # 中文：ROS 时间回退意味着仿真时间线重开，旧时间线的全部楼层栅格
        # 都必须丢弃，只保留初始楼层一张空图；其余输入状态一并复位。
        self._floor_maps.clear_to_floor(self._initial_floor)
        self._transition_active = False
        self._target_floor = None
        self._map_version += 1
        if self._origin_mode == "initial_pose":
            self._origin_ready = False
        self._publish_current_floor_locked()
        self._last_ros_time = now
        rospy.logwarn("ROS time rollback detected; mapping input epoch reset")

    def _check_ros_time_locked(self, now: rospy.Time) -> None:
        if self._last_ros_time is not None:
            delta = (now - self._last_ros_time).to_sec()
            if delta < -self._time_rollback_tolerance:
                self._reset_for_time_rollback_locked(now)
                return
        self._last_ros_time = now

    def _validate_stamp_locked(
        self, name: str, stamp: rospy.Time, now: rospy.Time,
        last_stamp: Optional[rospy.Time], max_age: Optional[float] = None,
    ):
        # 中文：统一的时间戳健康检查：非零、不过于未来、不过期、且严格递增
        # （拒绝重复帧与乱序帧）。任一不满足都返回 (False, 原因) 交由调用方
        # 决定是记故障还是仅丢弃。
        if stamp == rospy.Time():
            return False, "{} timestamp is zero".format(name)
        age = (now - stamp).to_sec()
        if age < -self._future_tolerance:
            return False, "{} timestamp is {:.3f}s in the future".format(name, -age)
        allowed_age = self._max_input_age if max_age is None else max_age
        if age > allowed_age:
            return False, "{} timestamp is {:.3f}s old".format(name, age)
        if last_stamp is not None and stamp <= last_stamp:
            relation = "duplicate" if stamp == last_stamp else "out of order"
            return False, "{} timestamp is {}".format(name, relation)
        return True, "{} timestamp valid".format(name)

    def _reject_cloud_locked(self, detail: str) -> None:
        self._cloud_metrics["clouds_rejected"] += 1
        self._pointcloud_failure_state = ModuleStatus.BLOCKED
        self._pointcloud_detail = detail

    def _mark_healthy_inputs_locked(self, now: rospy.Time) -> None:
        if self._healthy_inputs_since is None:
            self._healthy_inputs_since = now

    def _status_timer_callback(self, _event) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            state, valid, confidence, detail = self._evaluate_status_locked(now)
            # Status evaluation and publication must be atomic with respect to
            # localization invalidation / epoch recovery.
            self._publish_status(now, state, valid, confidence, detail)

    def _map_timer_callback(self, _event) -> None:
        with self._lock:
            now = rospy.Time.now()
            self._check_ros_time_locked(now)
            _, valid, _, _ = self._evaluate_status_locked(now)
            if not valid or not self._map_initialized:
                return
            epoch = self._input_epoch
            map_version = self._map_version
            floor_id = self._floor_maps.current_floor
            map_data = self._grid.data_copy()
            load_time = self._map_load_time
            origin_x = self._origin_x
            origin_y = self._origin_y

        # Constructing a large OccupancyGrid may be expensive, so do it without
        # blocking subscribers.  The final lock below rejects stale snapshots.
        # 中文：大栅格的消息构造耗时不短，因此在锁外完成；随后重新加锁并校验
        # epoch / map_version / floor 是否变化，变过就丢弃这份快照，
        # 防止把“构造期间的旧地图”发布出去。
        msg = self._build_map_message(now, load_time, map_data, origin_x, origin_y)

        with self._lock:
            publish_now = rospy.Time.now()
            self._check_ros_time_locked(publish_now)
            _, valid, _, _ = self._evaluate_status_locked(publish_now)
            if (
                not valid
                or not self._map_initialized
                or epoch != self._input_epoch
                or map_version != self._map_version
                or floor_id != self._floor_maps.current_floor
            ):
                return
            msg.header.stamp = publish_now
            self._map_pub.publish(msg)

    def _evaluate_status_locked(self, now: rospy.Time):
        if self._transition_active:
            return ModuleStatus.BLOCKED, False, 0.0, (
                "elevator transition: current_floor={}, target_floor={}".format(
                    self._floor_maps.current_floor,
                    "unknown" if self._target_floor is None else self._target_floor,
                )
            )
        if self._fault_active:
            return (
                self._fault_state,
                False,
                0.0,
                self._fault_detail,
            )
        if self._last_status_received_at is None and self._last_odom_received_at is None:
            return ModuleStatus.STARTING, False, 0.0, "waiting for localization status and odometry"
        if (self._last_status_received_at is not None and
                self._age(now, self._last_status_received_at) > self._status_timeout):
            detail = "localization status timed out"
            self._enter_fault_locked(
                detail,
                fault_state=ModuleStatus.TIMEOUT,
            )
            self._last_status_received_at = None
            self._last_status_stamp = None
            return ModuleStatus.TIMEOUT, False, 0.0, detail
        if (self._last_odom_received_at is not None and
                self._age(now, self._last_odom_received_at) > self._odom_timeout):
            detail = "odometry timed out"
            # An odometry timeout is a new odometry fault: force a new
            # generation so any cached odometry candidate is invalidated and
            # cannot satisfy recovery afterwards.
            self._enter_fault_locked(
                detail,
                force_new_epoch=True,
                fault_state=ModuleStatus.TIMEOUT,
            )
            self._last_odom_received_at = None
            self._last_odom_stamp = None
            return ModuleStatus.TIMEOUT, False, 0.0, detail
        if not self._localization_valid or self._status_epoch != self._input_epoch:
            detail = self._fault_detail or "waiting for new valid localization status"
            return ModuleStatus.BLOCKED, False, 0.0, detail
        if not self._odom_valid or self._odom_epoch != self._input_epoch:
            return self._odom_failure_state, False, 0.0, self._odom_detail
        if not self._origin_ready:
            return ModuleStatus.STARTING, False, 0.0, "waiting for initial pose map origin"
        if self._last_integrated_epoch != self._input_epoch:
            if (self._healthy_inputs_since is not None and
                    self._age(now, self._healthy_inputs_since) > self._pointcloud_timeout):
                detail = "no point cloud was successfully integrated before timeout"
                self._enter_fault_locked(
                    detail,
                    fault_state=ModuleStatus.TIMEOUT,
                )
                return ModuleStatus.TIMEOUT, False, 0.0, detail
            return self._pointcloud_failure_state, False, 0.0, (
                self._pointcloud_detail + "; new successful integration required"
            )
        if self._last_cloud_integrated_at is None:
            return ModuleStatus.STARTING, False, 0.0, "waiting for a successfully integrated point cloud"
        if self._age(now, self._last_cloud_integrated_at) > self._pointcloud_timeout:
            detail = "successfully integrated point cloud timed out"
            self._enter_fault_locked(
                detail,
                fault_state=ModuleStatus.TIMEOUT,
            )
            return ModuleStatus.TIMEOUT, False, 0.0, detail
        if not self._map_initialized:
            return ModuleStatus.STARTING, False, 0.0, "waiting for observed cells"
        s = self._last_scan_stats
        return ModuleStatus.RUNNING, True, 1.0, (
            "map updating: floor={}, epoch={}, valid_points={}, occupied={}, changed_cells={}"
        ).format(
            self._floor_maps.current_floor, self._input_epoch,
            s["valid_points"], s["occupied_endpoints"], s["changed_cells"]
        )

    def _publish_status(self, stamp, state, valid, confidence, detail) -> None:
        msg = ModuleStatus()
        msg.header.stamp = stamp
        msg.header.frame_id = self._map_frame
        msg.state = state
        msg.valid = valid
        msg.confidence = confidence
        msg.detail = detail
        self._status_pub.publish(msg)
        current = (state, valid, detail)
        if current != self._last_reported_status:
            rospy.loginfo("mapping status: state=%d valid=%s detail=%s", state, valid, detail)
            self._last_reported_status = current

    def _build_map_message(self, stamp, load_time, data, origin_x, origin_y) -> OccupancyGrid:
        msg = OccupancyGrid()
        msg.header.stamp = stamp
        msg.header.frame_id = self._map_frame
        msg.info.map_load_time = load_time if load_time is not None else stamp
        msg.info.resolution = self._resolution
        msg.info.width = self._map_width
        msg.info.height = self._map_height
        msg.info.origin.position.x = origin_x
        msg.info.origin.position.y = origin_y
        msg.info.origin.orientation.w = 1.0
        msg.data = data
        return msg

    @staticmethod
    def _normalise_frame(frame_id: str) -> str:
        return (frame_id or "").lstrip("/")

    @staticmethod
    def _age(now: rospy.Time, then: rospy.Time) -> float:
        age = (now - then).to_sec()
        if age < 0.0:
            raise ValueError("negative message age after ROS time rollback check")
        return age

    @staticmethod
    def _angle_difference(a: float, b: float) -> float:
        return math.atan2(math.sin(a-b), math.cos(a-b))

    def run(self) -> None:
        rospy.spin()


if __name__ == "__main__":
    MappingNode().run()
