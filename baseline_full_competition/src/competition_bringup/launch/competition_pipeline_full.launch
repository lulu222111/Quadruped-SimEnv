<launch>
  <!--
    competition_pipeline_full.launch — MODE B: real competition full pipeline.

    Drives the complete multi-floor mission:
      WAITING -> RUNNING
        FLOOR_EXPLORATION -> ELEVATOR_LOCATE -> ELEVATOR_TRANSIT
        -> FLOOR_SWITCH -> ... -> ALL_FLOORS_COMPLETE
        -> RETURN_TO_START_FLOOR -> RETURN_HOME (RETURNING)
        -> ARRIVED_START -> FINISHED

    MODE A (validated legacy single-floor closure) remains:
      roslaunch competition_bringup competition_system.launch

    中文：本文件只是 MODE B 的 wrapper：强制 mission_mode=multi_floor 与
    elevator_executor_enabled=true，并把 max_time（默认 1800.0）与
    超时参数透传给 competition_system.launch。
    注意：MODE B 已完成代码与单元/静态验证，端到端 Gazebo 仿真尚未验证。
  -->
  <arg name="max_time" default="1800.0" />
  <arg name="competition_mode" default="true" />
  <arg name="use_mocks" default="false" />
  <arg name="auto_start" default="true" />
  <arg name="start_floor" default="0" />
  <arg name="locate_timeout" default="180.0" />
  <arg name="elevator_request_timeout" default="30.0" />
  <arg name="floor_switch_ready_timeout" default="60.0" />
  <arg name="max_elevator_retries" default="1" />
  <arg name="door_service_timeout" default="45.0" />

  <include file="$(find competition_bringup)/launch/competition_system.launch">
    <arg name="max_time" value="$(arg max_time)" />
    <arg name="competition_mode" value="$(arg competition_mode)" />
    <arg name="use_mocks" value="$(arg use_mocks)" />
    <arg name="auto_start" value="$(arg auto_start)" />
    <arg name="mission_mode" value="multi_floor" />
    <arg name="start_floor" value="$(arg start_floor)" />
    <arg name="elevator_executor_enabled" value="true" />
    <arg name="locate_timeout" value="$(arg locate_timeout)" />
    <arg name="elevator_request_timeout" value="$(arg elevator_request_timeout)" />
    <arg name="floor_switch_ready_timeout" value="$(arg floor_switch_ready_timeout)" />
    <arg name="max_elevator_retries" value="$(arg max_elevator_retries)" />
    <arg name="door_service_timeout" value="$(arg door_service_timeout)" />
  </include>
</launch>
