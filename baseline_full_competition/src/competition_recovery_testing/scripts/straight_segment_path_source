#!/usr/bin/env python3
"""C2R7 test-only producer for one localization-aligned straight path."""

import math
import os
import sys
import threading

from competition_interfaces.msg import ModuleStatus
from nav_msgs.msg import Odometry, Path
import geometry_msgs.msg
import rospy

from competition_recovery_testing.straight_segment import (
    LocalizationSample,
    RuntimeGateError,
    SegmentConfig,
    SegmentController,
    SegmentState,
    validate_runtime_gate,
)


def yaw_from_quaternion(quaternion):
    values = (quaternion.x, quaternion.y, quaternion.z, quaternion.w)
    if not all(math.isfinite(value) for value in values):
        return float("nan")
    norm = math.sqrt(sum(value * value for value in values))
    if not math.isfinite(norm) or norm < 1e-12:
        return float("nan")
    x, y, z, w = (value / norm for value in values)
    return math.atan2(
        2.0 * (w * z + x * y),
        1.0 - 2.0 * (y * y + z * z),
    )


class StraightSegmentPathSource:
    def __init__(self):
        config = SegmentConfig(
            waypoint_distances=tuple(
                float(value) for value in rospy.get_param(
                    "~waypoint_distances", [0.25, 0.50, 0.75])
            ),
            arrival_distance=float(rospy.get_param("~arrival_distance", 0.55)),
            timeout=float(rospy.get_param("~timeout", 8.0)),
            max_yaw_deviation=float(
                rospy.get_param("~max_yaw_deviation", 0.15)
            ),
            max_cross_track=float(
                rospy.get_param("~max_cross_track", 0.15)
            ),
            localization_timeout=float(
                rospy.get_param("~localization_timeout", 1.0)
            ),
            max_future_stamp_skew=float(
                rospy.get_param("~max_future_stamp_skew", 0.2)
            ),
        )
        self._lock = threading.RLock()
        self._controller = SegmentController(config)
        self._status_valid = False
        self._status_stamp = None
        self._terminal_published = False

        self._path_pub = rospy.Publisher(
            "/competition/path", Path, queue_size=1, latch=True
        )
        self._status_pub = rospy.Publisher(
            "/competition/planning/status",
            ModuleStatus,
            queue_size=10,
            latch=True,
        )
        self._status_sub = rospy.Subscriber(
            "/competition/localization/status",
            ModuleStatus,
            self._on_status,
            queue_size=10,
        )
        self._odom_sub = rospy.Subscriber(
            "/competition/localization/odom",
            Odometry,
            self._on_odom,
            queue_size=1,
        )
        self._timer = rospy.Timer(rospy.Duration(0.5), self._on_timer)
        rospy.on_shutdown(self._on_shutdown)
        self._publish_cancel(
            SegmentState.WAITING,
            "waiting for fresh valid localization",
        )

    def _on_status(self, message):
        with self._lock:
            self._status_valid = bool(message.valid)
            self._status_stamp = message.header.stamp.to_sec()
            if (
                    self._controller.state is SegmentState.ACTIVE
                    and not self._status_valid):
                transition = self._controller.tick(
                    now=rospy.Time.now().to_sec(),
                    status_valid=False,
                    status_stamp=self._status_stamp,
                )
                self._handle_transition(transition)

    def _on_odom(self, message):
        with self._lock:
            if (
                    self._controller.state is SegmentState.WAITING
                    and not self._status_valid):
                return
            pose = message.pose.pose
            sample = LocalizationSample(
                x=pose.position.x,
                y=pose.position.y,
                yaw=yaw_from_quaternion(pose.orientation),
                stamp=message.header.stamp.to_sec(),
                frame_id=message.header.frame_id,
                child_frame_id=message.child_frame_id,
            )
            transition = self._controller.observe(
                sample,
                now=rospy.Time.now().to_sec(),
                status_valid=self._status_valid,
                status_stamp=self._status_stamp,
            )
            self._handle_transition(transition)

    def _on_timer(self, _event):
        with self._lock:
            if self._controller.state is SegmentState.WAITING:
                return
            transition = self._controller.tick(
                now=rospy.Time.now().to_sec(),
                status_valid=self._status_valid,
                status_stamp=self._status_stamp,
            )
            self._handle_transition(transition)
            if self._controller.state is SegmentState.ACTIVE:
                self._publish_active()

    def _handle_transition(self, transition):
        if transition.publish_path:
            self._publish_active()
        if transition.cancel_path or (
                transition.state not in (SegmentState.WAITING, SegmentState.ACTIVE)
                and not self._terminal_published):
            self._publish_cancel(transition.state, transition.detail)
            self._terminal_published = True

    def _publish_active(self):
        stamp = rospy.Time.now()
        self._status_pub.publish(self._status_message(
            stamp,
            ModuleStatus.RUNNING,
            True,
            1.0,
            self._controller.detail,
        ))
        path = Path()
        path.header.stamp = stamp
        path.header.frame_id = "world"
        for waypoint in self._controller.waypoints:
            pose = geometry_msgs.msg.PoseStamped()
            pose.header.stamp = stamp
            pose.header.frame_id = "world"
            pose.pose.position.x = waypoint.x
            pose.pose.position.y = waypoint.y
            pose.pose.orientation.z = math.sin(waypoint.yaw / 2.0)
            pose.pose.orientation.w = math.cos(waypoint.yaw / 2.0)
            path.poses.append(pose)
        self._path_pub.publish(path)

    def _publish_cancel(self, state, detail):
        stamp = rospy.Time.now()
        empty_path = Path()
        empty_path.header.stamp = stamp
        empty_path.header.frame_id = "world"
        self._path_pub.publish(empty_path)
        self._status_pub.publish(self._status_message(
            stamp,
            self._status_constant(state),
            False,
            0.0,
            detail,
        ))

    @staticmethod
    def _status_message(stamp, state, valid, confidence, detail):
        message = ModuleStatus()
        message.header.stamp = stamp
        message.state = state
        message.valid = valid
        message.confidence = confidence
        message.detail = detail
        return message

    @staticmethod
    def _status_constant(state):
        return {
            SegmentState.WAITING: ModuleStatus.STARTING,
            SegmentState.SUCCEEDED: ModuleStatus.SUCCEEDED,
            SegmentState.BLOCKED: ModuleStatus.BLOCKED,
            SegmentState.TIMEOUT: ModuleStatus.TIMEOUT,
            SegmentState.FAILED: ModuleStatus.FAILED,
        }.get(state, ModuleStatus.FAILED)

    def _on_shutdown(self):
        with self._lock:
            if self._controller.state is SegmentState.ACTIVE:
                self._publish_cancel(
                    SegmentState.FAILED,
                    "straight segment source shutdown",
                )


def main():
    rospy.init_node("c2r7_straight_segment_path_source")
    try:
        validate_runtime_gate(
            competition_mode=rospy.get_param(
                "/competition_loop/competition_mode", True
            ),
            test_only_acknowledged=rospy.get_param(
                "~test_only_acknowledged", False
            ),
            enable_ground_truth=os.environ.get("ENABLE_GROUND_TRUTH"),
        )
    except RuntimeGateError as error:
        rospy.logfatal("C2R7 test-only runtime gate rejected startup: %s", error)
        return 2

    try:
        StraightSegmentPathSource()
    except (TypeError, ValueError) as error:
        rospy.logfatal("C2R7 invalid configuration: %s", error)
        return 2
    rospy.loginfo("C2R7 straight-segment path source armed")
    rospy.spin()
    return 0


if __name__ == "__main__":
    sys.exit(main())
